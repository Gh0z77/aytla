# Copy to server/.env (ignored by git). `npm start` loads it automatically.

PORT=8787

# Database: a Supabase/Postgres URL for production, or nothing for a local SQLite file.
# Supabase → Connect → "Session pooler" (IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=
# DATABASE_FILE=./data/aytla.db

# Browser origins allowed to call the API (comma-separated). Empty = any origin.
CORS_ORIGINS=

# Sign in with Google through Clerk: the publishable key (same as EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY in the app)
CLERK_PUBLISHABLE_KEY=

# Sign in with Telegram: a bot token from @BotFather (one running process per token)
TELEGRAM_BOT_TOKEN=

# AI conversation practice: Claude when ANTHROPIC_API_KEY is set, otherwise Gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Founder's routes: GET /admin/stats, POST /admin/pro (Authorization: Bearer <token>). Unset = off.
ADMIN_TOKEN=

# A public channel the bot administers: the sentence of the day is posted there at 09:00 Tashkent time
TELEGRAM_CHANNEL=
SITE_URL=https://aytla.app
