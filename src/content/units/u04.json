  "sentences": [
    { "id": "u04.s.01", "en": "I want tea.", "native": { "uz": "Men choy xohlayman.", "ru": "Я хочу чай.", "tr": "Ben çay istiyorum." }, "altNative": { "ru": ["Я хочу чаю."], "tr": ["Çay istiyorum."] } },
    { "id": "u04.s.02", "en": "I want water, please.", "native": { "uz": "Men suv xohlayman, iltimos.", "ru": "Я хочу воды, пожалуйста.", "tr": "Su istiyorum, lütfen." }, "altNative": { "uz": ["Iltimos, men suv xohlayman.", "Menga suv kerak, iltimos."], "ru": ["Я хочу воду, пожалуйста.", "Мне воды, пожалуйста."], "tr": ["Ben su istiyorum, lütfen.", "Lütfen su istiyorum."] } },
    { "id": "u04.s.03", "en": "Tea or coffee?", "native": { "uz": "Choymi yoki qahva?", "ru": "Чай или кофе?", "tr": "Çay mı kahve mi?" }, "altNative": { "uz": ["Choy yoki qahva?", "Choymi yoki qahvami?"], "tr": ["Çay mı yoksa kahve mi?"] } },
    { "id": "u04.s.04", "en": "I drink coffee.", "native": { "uz": "Men qahva ichaman.", "ru": "Я пью кофе.", "tr": "Ben kahve içiyorum." }, "altNative": { "tr": ["Kahve içiyorum.", "Ben kahve içerim.", "Kahve içerim."] } },
    { "id": "u04.s.05", "en": "Do you want milk?", "native": { "uz": "Sen sut xohlaysanmi?", "ru": "Ты хочешь молоко?", "tr": "Süt ister misin?" }, "altNative": { "uz": ["Sut xohlaysanmi?"], "ru": ["Ты хочешь молока?", "Хочешь молока?"], "tr": ["Sen süt ister misin?", "Süt istiyor musun?"] } },
    { "id": "u04.s.06", "en": "I drink water.", "native": { "uz": "Men suv ichaman.", "ru": "Я пью воду.", "tr": "Ben su içiyorum." }, "altNative": { "tr": ["Su içiyorum.", "Ben su içerim.", "Su içerim."] } },
    { "id": "u04.s.07", "en": "Coffee and milk, please.", "native": { "uz": "Qahva va sut, iltimos.", "ru": "Кофе и молоко, пожалуйста.", "tr": "Kahve ve süt, lütfen." } },
    { "id": "u04.s.08", "en": "No, thanks. I want tea.", "native": { "uz": "Yo'q, rahmat. Men choy xohlayman.", "ru": "Нет, спасибо. Я хочу чай.", "tr": "Hayır, teşekkürler. Çay istiyorum." }, "altNative": { "ru": ["Нет, спасибо. Я хочу чаю."], "tr": ["Hayır, teşekkürler. Ben çay istiyorum."] } },

    { "id": "u04.s.09", "en": "I am hungry.", "native": { "uz": "Men ochman.", "ru": "Я голоден.", "tr": "Ben açım." }, "altNative": { "uz": ["Qornim och."], "ru": ["Я голодна.", "Я хочу есть."], "tr": ["Açım.", "Karnım aç."] } },
    { "id": "u04.s.10", "en": "I am thirsty.", "native": { "uz": "Men chanqadim.", "ru": "Я хочу пить.", "tr": "Ben susadım." }, "altNative": { "uz": ["Men chanqaganman.", "Chanqadim."], "tr": ["Susadım."] } },
    { "id": "u04.s.11", "en": "Are you hungry?", "native": { "uz": "Sen ochmisan?", "ru": "Ты голоден?", "tr": "Sen aç mısın?" }, "altNative": { "uz": ["Qorning ochmi?"], "ru": ["Ты голодна?", "Ты хочешь есть?"], "tr": ["Aç mısın?"] } },
    { "id": "u04.s.12", "en": "I eat bread.", "native": { "uz": "Men non yeyman.", "ru": "Я ем хлеб.", "tr": "Ben ekmek yiyorum." }, "altNative": { "tr": ["Ekmek yiyorum.", "Ben ekmek yerim.", "Ekmek yerim."] } },
    { "id": "u04.s.13", "en": "I want soup and bread.", "native": { "uz": "Men sho'rva va non xohlayman.", "ru": "Я хочу суп и хлеб.", "tr": "Ben çorba ve ekmek istiyorum." }, "altNative": { "tr": ["Çorba ve ekmek istiyorum."] } },
    { "id": "u04.s.14", "en": "We eat rice.", "native": { "uz": "Biz guruch yeymiz.", "ru": "Мы едим рис.", "tr": "Biz pilav yiyoruz." }, "altNative": { "tr": ["Pilav yiyoruz.", "Biz pirinç yiyoruz.", "Biz pilav yeriz."] } },
    { "id": "u04.s.15", "en": "My brother is very hungry.", "native": { "uz": "Mening akam juda och.", "ru": "Мой брат очень голоден.", "tr": "Erkek kardeşim çok aç." }, "altNative": { "uz": ["Mening ukam juda och.", "Akam juda och.", "Ukam juda och."], "ru": ["Мой брат очень голодный."], "tr": ["Benim erkek kardeşim çok aç.", "Abim çok aç."] } },
    { "id": "u04.s.16", "en": "The soup is good.", "native": { "uz": "Sho'rva yaxshi.", "ru": "Суп хороший.", "tr": "Çorba iyi." }, "altNative": { "uz": ["Sho'rva mazali."], "ru": ["Суп вкусный."], "tr": ["Çorba güzel."] } },

    { "id": "u04.s.17", "en": "I like apples.", "native": { "uz": "Men olmani yoqtiraman.", "ru": "Мне нравятся яблоки.", "tr": "Ben elma severim." }, "altNative": { "uz": ["Menga olma yoqadi.", "Men olmalarni yoqtiraman."], "ru": ["Я люблю яблоки."], "tr": ["Elma severim.", "Elmayı severim.", "Ben elmayı severim."] } },
    { "id": "u04.s.18", "en": "Do you like fish?", "native": { "uz": "Sen baliqni yoqtirasanmi?", "ru": "Тебе нравится рыба?", "tr": "Balık sever misin?" }, "altNative": { "uz": ["Senga baliq yoqadimi?", "Baliqni yoqtirasanmi?"], "ru": ["Ты любишь рыбу?"], "tr": ["Sen balık sever misin?", "Balığı sever misin?"] } },
    { "id": "u04.s.19", "en": "I do not like meat.", "native": { "uz": "Men go'shtni yoqtirmayman.", "ru": "Мне не нравится мясо.", "tr": "Ben et sevmem." }, "altNative": { "uz": ["Menga go'sht yoqmaydi."], "ru": ["Я не люблю мясо."], "tr": ["Et sevmem.", "Ben eti sevmem.", "Eti sevmem."] } },
    { "id": "u04.s.20", "en": "She likes fruit.", "native": { "uz": "U mevani yoqtiradi.", "ru": "Ей нравятся фрукты.", "tr": "O meyve sever." }, "altEnFor": { "uz": ["He likes fruit."], "tr": ["He likes fruit."] }, "altNative": { "uz": ["Unga meva yoqadi."], "ru": ["Она любит фрукты."], "tr": ["O meyveyi sever."] } },
    { "id": "u04.s.21", "en": "He eats an egg.", "native": { "uz": "U tuxum yeydi.", "ru": "Он ест яйцо.", "tr": "O bir yumurta yiyor." }, "altEnFor": { "uz": ["She eats an egg."], "tr": ["She eats an egg."] }, "altNative": { "uz": ["U bitta tuxum yeydi."], "tr": ["O yumurta yiyor.", "O bir yumurta yer."] } },
    { "id": "u04.s.22", "en": "I eat an apple.", "native": { "uz": "Men olma yeyman.", "ru": "Я ем яблоко.", "tr": "Ben bir elma yiyorum." }, "altNative": { "uz": ["Men bitta olma yeyman."], "tr": ["Bir elma yiyorum.", "Ben elma yiyorum."] } },
    { "id": "u04.s.23", "en": "We like meat and fish.", "native": { "uz": "Biz go'sht va baliqni yoqtiramiz.", "ru": "Нам нравятся мясо и рыба.", "tr": "Biz et ve balık severiz." }, "altNative": { "uz": ["Bizga go'sht va baliq yoqadi."], "ru": ["Мы любим мясо и рыбу."], "tr": ["Et ve balık severiz."] } },
    { "id": "u04.s.24", "en": "My mother likes fruit.", "native": { "uz": "Mening onam mevani yoqtiradi.", "ru": "Моей маме нравятся фрукты.", "tr": "Annem meyve sever." }, "altNative": { "uz": ["Onam mevani yoqtiradi.", "Onamga meva yoqadi."], "ru": ["Моя мама любит фрукты."], "tr": ["Benim annem meyve sever.", "Annem meyveyi sever."] } },

    { "id": "u04.s.25", "en": "Breakfast is delicious.", "native": { "uz": "Nonushta mazali.", "ru": "Завтрак вкусный.", "tr": "Kahvaltı lezzetli." } },
    { "id": "u04.s.26", "en": "I eat cheese for breakfast.", "native": { "uz": "Men nonushtaga pishloq yeyman.", "ru": "Я ем сыр на завтрак.", "tr": "Kahvaltıda peynir yiyorum." }, "altNative": { "uz": ["Nonushtaga men pishloq yeyman."], "ru": ["На завтрак я ем сыр."], "tr": ["Ben kahvaltıda peynir yiyorum.", "Kahvaltıda peynir yerim."] } },
    { "id": "u04.s.27", "en": "I drink juice in the morning.", "native": { "uz": "Men ertalab sharbat ichaman.", "ru": "Утром я пью сок.", "tr": "Sabah meyve suyu içiyorum." }, "altNative": { "uz": ["Ertalab men sharbat ichaman."], "ru": ["Я пью сок утром."], "tr": ["Ben sabah meyve suyu içiyorum.", "Sabahları meyve suyu içerim."] } },
    { "id": "u04.s.28", "en": "We eat lunch together.", "native": { "uz": "Biz birga tushlik qilamiz.", "ru": "Мы обедаем вместе.", "tr": "Biz birlikte öğle yemeği yiyoruz." }, "altNative": { "uz": ["Biz tushlikni birga qilamiz."], "ru": ["Мы вместе обедаем."], "tr": ["Birlikte öğle yemeği yiyoruz.", "Öğle yemeğini birlikte yiyoruz."] } },
    { "id": "u04.s.29", "en": "Dinner is at home.", "native": { "uz": "Kechki ovqat uyda.", "ru": "Ужин дома.", "tr": "Akşam yemeği evde." } },
    { "id": "u04.s.30", "en": "What do you want for lunch?", "native": { "uz": "Tushlikka nima xohlaysan?", "ru": "Что ты хочешь на обед?", "tr": "Öğle yemeğinde ne istersin?" }, "altNative": { "uz": ["Sen tushlikka nima xohlaysan?"], "tr": ["Öğle yemeği için ne istersin?", "Öğle yemeğinde ne istiyorsun?"] } },
    { "id": "u04.s.31", "en": "The cheese is very good.", "native": { "uz": "Pishloq juda yaxshi.", "ru": "Сыр очень хороший.", "tr": "Peynir çok iyi." }, "altNative": { "uz": ["Pishloq juda mazali."], "ru": ["Сыр очень вкусный."], "tr": ["Peynir çok güzel."] } },
    { "id": "u04.s.32", "en": "My family eats dinner together.", "native": { "uz": "Mening oilam birga kechki ovqat qiladi.", "ru": "Моя семья ужинает вместе.", "tr": "Ailem birlikte akşam yemeği yer." }, "altNative": { "uz": ["Oilam birga kechki ovqat qiladi.", "Mening oilam kechki ovqatni birga yeydi."], "ru": ["Моя семья вместе ужинает."], "tr": ["Benim ailem birlikte akşam yemeği yer.", "Ailem birlikte akşam yemeği yiyor."] } },

    { "id": "u04.s.33", "en": "The menu, please.", "native": { "uz": "Menyuni bering, iltimos.", "ru": "Меню, пожалуйста.", "tr": "Menü, lütfen." }, "altNative": { "uz": ["Menyu, iltimos."] } },
    { "id": "u04.s.34", "en": "A cup of tea, please.", "native": { "uz": "Bir chashka choy, iltimos.", "ru": "Чашку чая, пожалуйста.", "tr": "Bir fincan çay, lütfen." }, "altNative": { "uz": ["Bir piyola choy, iltimos.", "Bir finjon choy, iltimos."], "ru": ["Чашка чая, пожалуйста."] } },
    { "id": "u04.s.35", "en": "The coffee is hot.", "native": { "uz": "Qahva issiq.", "ru": "Кофе горячий.", "tr": "Kahve sıcak." } },
    { "id": "u04.s.36", "en": "The water is cold.", "native": { "uz": "Suv sovuq.", "ru": "Вода холодная.", "tr": "Su soğuk." } },
    { "id": "u04.s.37", "en": "I want tea with sugar.", "native": { "uz": "Men shakarli choy xohlayman.", "ru": "Я хочу чай с сахаром.", "tr": "Şekerli çay istiyorum." }, "altNative": { "uz": ["Men shakar bilan choy xohlayman."], "tr": ["Ben şekerli çay istiyorum."] } },
    { "id": "u04.s.38", "en": "Coffee with milk, please.", "native": { "uz": "Sutli qahva, iltimos.", "ru": "Кофе с молоком, пожалуйста.", "tr": "Sütlü kahve, lütfen." }, "altNative": { "uz": ["Sut bilan qahva, iltimos."] } },
    { "id": "u04.s.39", "en": "This cafe is very nice.", "native": { "uz": "Bu kafe juda yoqimli.", "ru": "Это кафе очень приятное.", "tr": "Bu kafe çok hoş." }, "altNative": { "uz": ["Bu kafe juda yaxshi."], "ru": ["Это кафе очень хорошее."], "tr": ["Bu kafe çok güzel."] } },
    { "id": "u04.s.40", "en": "Do you want hot or cold tea?", "native": { "uz": "Issiq choy xohlaysanmi yoki sovuqmi?", "ru": "Ты хочешь горячий или холодный чай?", "tr": "Sıcak mı soğuk mu çay istersin?" }, "altNative": { "uz": ["Issiq yoki sovuq choy xohlaysanmi?", "Sen issiq yoki sovuq choy xohlaysanmi?"], "tr": ["Sıcak çay mı soğuk çay mı istersin?", "Sıcak mı yoksa soğuk mu çay istersin?"] } }
  ],
