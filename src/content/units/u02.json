    { "id": "u02.s.25", "en": "He is a student.", "native": { "uz": "U talaba.", "ru": "Он студент.", "tr": "O bir öğrenci." }, "altEnFor": { "uz": ["She is a student."], "tr": ["She is a student."] }, "altNative": { "tr": ["O öğrenci."] } },
