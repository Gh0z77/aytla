  "sentences": [
    { "id": "u02.s.01", "en": "My name is Anna.", "native": { "uz": "Mening ismim Anna.", "ru": "Меня зовут Анна.", "tr": "Benim adım Anna." }, "altNative": { "uz": ["Ismim Anna."], "ru": ["Моё имя Анна."], "tr": ["Adım Anna.", "Benim ismim Anna."] } },
    { "id": "u02.s.02", "en": "What is your name?", "native": { "uz": "Isming nima?", "ru": "Как тебя зовут?", "tr": "Adın ne?" }, "altNative": { "uz": ["Sening isming nima?"], "tr": ["Senin adın ne?", "İsmin ne?"] } },
    { "id": "u02.s.03", "en": "My name is Ali.", "native": { "uz": "Mening ismim Ali.", "ru": "Меня зовут Али.", "tr": "Benim adım Ali." }, "altNative": { "uz": ["Ismim Ali."], "ru": ["Моё имя Али."], "tr": ["Adım Ali.", "Benim ismim Ali."] } },
    { "id": "u02.s.04", "en": "Who is this?", "native": { "uz": "Bu kim?", "ru": "Кто это?", "tr": "Bu kim?" } },
    { "id": "u02.s.05", "en": "This is Anna.", "native": { "uz": "Bu Anna.", "ru": "Это Анна.", "tr": "Bu Anna." } },
    { "id": "u02.s.06", "en": "This is my friend.", "native": { "uz": "Bu mening do'stim.", "ru": "Это мой друг.", "tr": "Bu benim arkadaşım." }, "altNative": { "uz": ["Bu do'stim."], "ru": ["Это моя подруга."], "tr": ["Bu arkadaşım."] } },
    { "id": "u02.s.07", "en": "Hello! What is your name?", "native": { "uz": "Salom! Isming nima?", "ru": "Привет! Как тебя зовут?", "tr": "Merhaba! Adın ne?" }, "altNative": { "uz": ["Salom! Sening isming nima?"], "tr": ["Merhaba! Senin adın ne?"] } },
    { "id": "u02.s.08", "en": "Who is your friend?", "native": { "uz": "Sening do'sting kim?", "ru": "Кто твой друг?", "tr": "Senin arkadaşın kim?" }, "altNative": { "uz": ["Do'sting kim?"], "tr": ["Arkadaşın kim?"] } },

    { "id": "u02.s.09", "en": "Where are you from?", "native": { "uz": "Sen qayerdansan?", "ru": "Откуда ты?", "tr": "Nerelisin?" }, "altNative": { "uz": ["Qayerdansan?"], "ru": ["Ты откуда?"], "tr": ["Sen nerelisin?"] } },
    { "id": "u02.s.10", "en": "I am from Uzbekistan.", "native": { "uz": "Men O'zbekistondanman.", "ru": "Я из Узбекистана.", "tr": "Ben Özbekistanlıyım." }, "altNative": { "tr": ["Ben Özbekistan'danım.", "Özbekistanlıyım."] } },
    { "id": "u02.s.11", "en": "I am from Turkey.", "native": { "uz": "Men Turkiyadanman.", "ru": "Я из Турции.", "tr": "Ben Türkiyeliyim." }, "altNative": { "tr": ["Ben Türkiye'denim.", "Türkiyeliyim."] } },
    { "id": "u02.s.12", "en": "Are you from Russia?", "native": { "uz": "Sen Rossiyadanmisan?", "ru": "Ты из России?", "tr": "Sen Rusyalı mısın?" }, "altNative": { "tr": ["Sen Rusya'dan mısın?", "Rusyalı mısın?"] } },
    { "id": "u02.s.13", "en": "My friend is from Brazil.", "native": { "uz": "Mening do'stim Braziliyadan.", "ru": "Мой друг из Бразилии.", "tr": "Benim arkadaşım Brezilyalı." }, "altNative": { "uz": ["Do'stim Braziliyadan."], "ru": ["Моя подруга из Бразилии."], "tr": ["Arkadaşım Brezilyalı."] } },
    { "id": "u02.s.14", "en": "Uzbekistan is my country.", "native": { "uz": "O'zbekiston mening mamlakatim.", "ru": "Узбекистан — моя страна.", "tr": "Özbekistan benim ülkem." } },
    { "id": "u02.s.15", "en": "Turkey is a great country.", "native": { "uz": "Turkiya zo'r mamlakat.", "ru": "Турция — отличная страна.", "tr": "Türkiye harika bir ülke." } },
    { "id": "u02.s.16", "en": "Where is your friend from?", "native": { "uz": "Sening do'sting qayerdan?", "ru": "Откуда твой друг?", "tr": "Senin arkadaşın nereli?" }, "altNative": { "uz": ["Do'sting qayerdan?"], "tr": ["Arkadaşın nereli?"] } },

    { "id": "u02.s.17", "en": "Nice to meet you!", "native": { "uz": "Tanishganimdan xursandman!", "ru": "Приятно познакомиться!", "tr": "Tanıştığıma memnun oldum!" }, "altNative": { "ru": ["Рад познакомиться!", "Рада познакомиться!"], "tr": ["Memnun oldum!"] } },
    { "id": "u02.s.18", "en": "Nice to meet you too.", "native": { "uz": "Men ham tanishganimdan xursandman.", "ru": "Мне тоже приятно познакомиться.", "tr": "Ben de memnun oldum." }, "altNative": { "ru": ["Мне тоже приятно."], "tr": ["Ben de tanıştığıma memnun oldum."] } },
    { "id": "u02.s.19", "en": "I am new here.", "native": { "uz": "Men shu yerda yangiman.", "ru": "Я здесь новенький.", "tr": "Ben burada yeniyim." }, "altNative": { "uz": ["Men bu yerda yangiman."], "ru": ["Я здесь новенькая.", "Я тут новенький.", "Я тут новенькая."], "tr": ["Burada yeniyim."] } },
    { "id": "u02.s.20", "en": "I live in Uzbekistan.", "native": { "uz": "Men O'zbekistonda yashayman.", "ru": "Я живу в Узбекистане.", "tr": "Ben Özbekistan'da yaşıyorum." }, "altNative": { "tr": ["Özbekistan'da yaşıyorum."] } },
    { "id": "u02.s.21", "en": "Do you live here?", "native": { "uz": "Sen shu yerda yashaysanmi?", "ru": "Ты живёшь здесь?", "tr": "Sen burada mı yaşıyorsun?" }, "altNative": { "uz": ["Sen bu yerda yashaysanmi?"], "ru": ["Ты здесь живёшь?"], "tr": ["Burada mı yaşıyorsun?"] } },
    { "id": "u02.s.22", "en": "My city is very nice.", "native": { "uz": "Mening shahrim juda yoqimli.", "ru": "Мой город очень приятный.", "tr": "Benim şehrim çok hoş." }, "altNative": { "uz": ["Shahrim juda yoqimli."], "tr": ["Şehrim çok hoş."] } },
