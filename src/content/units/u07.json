  "sentences": [
    { "id": "u07.s.01", "en": "I get up early.", "native": { "uz": "Men erta turaman.", "ru": "Я встаю рано.", "tr": "Ben erken kalkarım." }, "altNative": { "uz": ["Erta turaman.", "Men barvaqt turaman."], "ru": ["Я рано встаю."], "tr": ["Erken kalkarım.", "Ben erken kalkıyorum.", "Erken kalkıyorum."] } },
    { "id": "u07.s.02", "en": "I wake up at six.", "native": { "uz": "Men soat oltida uyg'onaman.", "ru": "Я просыпаюсь в шесть.", "tr": "Ben saat altıda uyanırım." }, "altNative": { "uz": ["Soat oltida uyg'onaman.", "Men oltida uyg'onaman."], "ru": ["Я просыпаюсь в шесть часов."], "tr": ["Saat altıda uyanırım.", "Altıda uyanırım.", "Ben saat altıda uyanıyorum.", "Saat altıda uyanıyorum."] } },
    { "id": "u07.s.03", "en": "Do you get up early?", "native": { "uz": "Sen erta turasanmi?", "ru": "Ты рано встаёшь?", "tr": "Sen erken mi kalkarsın?" }, "altNative": { "uz": ["Erta turasanmi?"], "ru": ["Ты встаёшь рано?"], "tr": ["Erken mi kalkarsın?", "Erken kalkar mısın?", "Sen erken kalkar mısın?", "Erken mi kalkıyorsun?", "Erken kalkıyor musun?"] } },
    { "id": "u07.s.04", "en": "I don't get up late.", "native": { "uz": "Men kech turmayman.", "ru": "Я не встаю поздно.", "tr": "Ben geç kalkmam." }, "altNative": { "uz": ["Kech turmayman."], "ru": ["Я поздно не встаю."], "tr": ["Geç kalkmam.", "Ben geç kalkmıyorum.", "Geç kalkmıyorum."] } },
    { "id": "u07.s.05", "en": "I have a hot shower.", "altEn": ["I take a hot shower."], "native": { "uz": "Men issiq dush qabul qilaman.", "ru": "Я принимаю горячий душ.", "tr": "Ben sıcak duş alırım." }, "altNative": { "uz": ["Issiq dush qabul qilaman.", "Men issiq dushga tushaman."], "tr": ["Sıcak duş alırım.", "Sıcak bir duş alırım.", "Ben sıcak duş alıyorum.", "Sıcak duş alıyorum."] } },
    { "id": "u07.s.06", "en": "Wake up! It is late.", "native": { "uz": "Uyg'on! Kech bo'ldi.", "ru": "Просыпайся! Уже поздно.", "tr": "Uyan! Geç oldu." }, "altNative": { "uz": ["Uyg'on! Kech bo'lib qoldi.", "Uyg'on! Kech."], "ru": ["Проснись! Уже поздно.", "Просыпайся! Поздно."], "tr": ["Uyan! Geç.", "Uyan! Saat geç oldu."] } },
    { "id": "u07.s.07", "en": "You are late!", "native": { "uz": "Sen kech qolding!", "ru": "Ты опоздал!", "tr": "Geç kaldın!" }, "altNative": { "uz": ["Kech qolding!", "Sen kechikding!", "Kechikding!"], "ru": ["Ты опоздала!", "Ты опаздываешь!"], "tr": ["Sen geç kaldın!"] } },
    { "id": "u07.s.08", "en": "We go home together.", "native": { "uz": "Biz uyga birga boramiz.", "ru": "Мы ходим домой вместе.", "tr": "Biz eve birlikte gideriz." }, "altNative": { "uz": ["Uyga birga boramiz.", "Biz birga uyga boramiz.", "Biz uyga birga ketamiz."], "ru": ["Мы вместе ходим домой.", "Мы идём домой вместе.", "Мы вместе идём домой."], "tr": ["Eve birlikte gideriz.", "Biz eve birlikte gidiyoruz.", "Eve birlikte gidiyoruz.", "Eve beraber gideriz."] } },

    { "id": "u07.s.09", "en": "I work every day.", "native": { "uz": "Men har kuni ishlayman.", "ru": "Я работаю каждый день.", "tr": "Ben her gün çalışırım." }, "altNative": { "uz": ["Har kuni ishlayman."], "ru": ["Я каждый день работаю."], "tr": ["Her gün çalışırım.", "Ben her gün çalışıyorum.", "Her gün çalışıyorum."] } },
    { "id": "u07.s.10", "en": "Madina works at a school.", "altEn": ["Madina works in a school."], "native": { "uz": "Madina maktabda ishlaydi.", "ru": "Мадина работает в школе.", "tr": "Madina bir okulda çalışıyor." }, "altNative": { "tr": ["Madina okulda çalışıyor.", "Madina bir okulda çalışır.", "Madina okulda çalışır."] } },
    { "id": "u07.s.11", "en": "I go to work by bus.", "native": { "uz": "Men ishga avtobusda boraman.", "ru": "Я езжу на работу на автобусе.", "tr": "İşe otobüsle giderim." }, "altNative": { "uz": ["Ishga avtobusda boraman.", "Men avtobusda ishga boraman.", "Men ishga avtobus bilan boraman."], "ru": ["Я еду на работу на автобусе.", "На работу я езжу на автобусе."], "tr": ["Ben işe otobüsle giderim.", "İşe otobüsle gidiyorum.", "Ben işe otobüsle gidiyorum."] } },
    { "id": "u07.s.12", "en": "My son walks to school.", "altEn": ["My son goes to school on foot."], "native": { "uz": "Mening o'g'lim maktabga piyoda boradi.", "ru": "Мой сын ходит в школу пешком.", "tr": "Oğlum okula yürüyerek gider." }, "altNative": { "uz": ["O'g'lim maktabga piyoda boradi."], "ru": ["Мой сын пешком ходит в школу.", "Мой сын идёт в школу пешком."], "tr": ["Benim oğlum okula yürüyerek gider.", "Oğlum okula yürüyerek gidiyor.", "Oğlum okula yürür.", "Oğlum okula yürüyor."] } },
    { "id": "u07.s.13", "en": "Tom doesn't start work early.", "native": { "uz": "Tom ishni erta boshlamaydi.", "ru": "Том не начинает работу рано.", "tr": "Tom işe erken başlamaz." }, "altNative": { "uz": ["Tom ishni barvaqt boshlamaydi."], "ru": ["Том не начинает работать рано.", "Том начинает работу не рано."], "tr": ["Tom işe erken başlamıyor."] } },
    { "id": "u07.s.14", "en": "We finish work at six.", "native": { "uz": "Biz ishni soat oltida tugatamiz.", "ru": "Мы заканчиваем работу в шесть.", "tr": "İşi saat altıda bitiririz." }, "altNative": { "uz": ["Ishni soat oltida tugatamiz.", "Biz ishni oltida tugatamiz."], "ru": ["Мы заканчиваем работать в шесть.", "Мы заканчиваем работу в шесть часов."], "tr": ["Biz işi saat altıda bitiririz.", "İşi saat altıda bitiriyoruz.", "Biz işi saat altıda bitiriyoruz.", "İşi altıda bitiririz."] } },
    { "id": "u07.s.15", "en": "I get up at seven every day.", "altEn": ["Every day I get up at seven.", "I get up every day at seven."], "native": { "uz": "Men har kuni soat yettida turaman.", "ru": "Я встаю в семь каждый день.", "tr": "Her gün saat yedide kalkarım." }, "altNative": { "uz": ["Har kuni soat yettida turaman.", "Men har kuni yettida turaman."], "ru": ["Каждый день я встаю в семь.", "Я каждый день встаю в семь."], "tr": ["Ben her gün saat yedide kalkarım.", "Her gün saat yedide kalkıyorum.", "Ben her gün saat yedide kalkıyorum.", "Her gün yedide kalkarım."] } },
    { "id": "u07.s.16", "en": "Does he walk to work?", "native": { "uz": "U ishga piyoda boradimi?", "ru": "Он ходит на работу пешком?", "tr": "O işe yürüyerek mi gider?" }, "altEnFor": { "uz": ["Does she walk to work?"], "tr": ["Does she walk to work?"] }, "altNative": { "ru": ["Он ходит пешком на работу?", "Он идёт на работу пешком?"], "tr": ["O işe yürüyerek mi gidiyor?", "İşe yürüyerek mi gider?", "İşe yürüyerek mi gidiyor?"] } },

    { "id": "u07.s.17", "en": "I always get up early.", "native": { "uz": "Men doim erta turaman.", "ru": "Я всегда встаю рано.", "tr": "Ben her zaman erken kalkarım." }, "altNative": { "uz": ["Men har doim erta turaman.", "Men doimo erta turaman.", "Doim erta turaman."], "ru": ["Я всегда рано встаю."], "tr": ["Her zaman erken kalkarım.", "Ben hep erken kalkarım.", "Hep erken kalkarım.", "Her zaman erken kalkıyorum."] } },
    { "id": "u07.s.18", "en": "I usually walk to work.", "altEn": ["Usually I walk to work."], "native": { "uz": "Men odatda ishga piyoda boraman.", "ru": "Я обычно хожу на работу пешком.", "tr": "Genellikle işe yürüyerek giderim." }, "altNative": { "uz": ["Odatda ishga piyoda boraman.", "Odatda men ishga piyoda boraman."], "ru": ["Обычно я хожу на работу пешком.", "Я обычно иду на работу пешком."], "tr": ["Ben genellikle işe yürüyerek giderim.", "İşe genellikle yürüyerek giderim.", "Genelde işe yürüyerek giderim.", "Genellikle işe yürüyerek gidiyorum."] } },
