    { "id": "u07.s.20", "en": "We sometimes eat lunch at home.", "altEn": ["Sometimes we eat lunch at home.", "We sometimes have lunch at home."], "native": { "uz": "Biz ba'zan uyda tushlik qilamiz.", "ru": "Мы иногда обедаем дома.", "tr": "Bazen öğle yemeğini evde yeriz." }, "altNative": { "uz": ["Ba'zan biz uyda tushlik qilamiz.", "Ba'zan uyda tushlik qilamiz.", "Biz ba'zan tushlikni uyda qilamiz."], "ru": ["Иногда мы обедаем дома."], "tr": ["Biz bazen öğle yemeğini evde yeriz.", "Bazen evde öğle yemeği yeriz.", "Bazen öğle yemeğini evde yiyoruz."] } },
    { "id": "u07.s.21", "en": "I never drink coffee in the evening.", "native": { "uz": "Men kechqurun hech qachon qahva ichmayman.", "ru": "Я никогда не пью кофе вечером.", "tr": "Akşamları asla kahve içmem." }, "altNative": { "uz": ["Men hech qachon kechqurun qahva ichmayman.", "Kechqurun hech qachon qahva ichmayman."], "ru": ["Вечером я никогда не пью кофе.", "Я никогда не пью кофе по вечерам."], "tr": ["Ben akşamları asla kahve içmem.", "Akşam asla kahve içmem.", "Akşamları hiç kahve içmem.", "Akşamları hiçbir zaman kahve içmem."] } },
    { "id": "u07.s.22", "en": "I sometimes sleep on the bus.", "altEn": ["Sometimes I sleep on the bus."], "native": { "uz": "Men ba'zan avtobusda uxlayman.", "ru": "Я иногда сплю в автобусе.", "tr": "Bazen otobüste uyurum." }, "altNative": { "uz": ["Ba'zan avtobusda uxlayman.", "Ba'zan men avtobusda uxlayman."], "ru": ["Иногда я сплю в автобусе."], "tr": ["Ben bazen otobüste uyurum.", "Bazen otobüste uyuyorum."] } },
    { "id": "u07.s.23", "en": "I usually go to bed at ten.", "altEn": ["Usually I go to bed at ten."], "native": { "uz": "Men odatda soat o'nda yotaman.", "ru": "Я обычно ложусь спать в десять.", "tr": "Genellikle saat onda yatarım." }, "altNative": { "uz": ["Odatda soat o'nda yotaman.", "Odatda men soat o'nda yotaman.", "Men odatda soat o'nda uxlashga yotaman."], "ru": ["Обычно я ложусь спать в десять.", "Я обычно ложусь в десять."], "tr": ["Ben genellikle saat onda yatarım.", "Genelde saat onda yatarım.", "Genellikle onda yatarım.", "Genellikle saat onda yatıyorum."] } },
    { "id": "u07.s.24", "en": "Do you always eat breakfast?", "altEn": ["Do you always have breakfast?"], "native": { "uz": "Sen doim nonushta qilasanmi?", "ru": "Ты всегда завтракаешь?", "tr": "Her zaman kahvaltı yapar mısın?" }, "altNative": { "uz": ["Doim nonushta qilasanmi?", "Sen har doim nonushta qilasanmi?"], "tr": ["Sen her zaman kahvaltı yapar mısın?", "Hep kahvaltı yapar mısın?", "Her zaman kahvaltı yapıyor musun?", "Her zaman kahvaltı eder misin?"] } },

    { "id": "u07.s.25", "en": "I usually come home late.", "altEn": ["Usually I come home late."], "native": { "uz": "Men odatda uyga kech kelaman.", "ru": "Я обычно прихожу домой поздно.", "tr": "Genellikle eve geç gelirim." }, "altNative": { "uz": ["Odatda uyga kech kelaman.", "Odatda men uyga kech kelaman.", "Men odatda uyga kech qaytaman."], "ru": ["Обычно я прихожу домой поздно.", "Я обычно поздно прихожу домой.", "Обычно я поздно прихожу домой."], "tr": ["Ben genellikle eve geç gelirim.", "Eve genellikle geç gelirim.", "Genelde eve geç gelirim.", "Genellikle eve geç geliyorum."] } },
    { "id": "u07.s.26", "en": "He comes home and reads.", "altEn": ["He comes home and reads a book."], "native": { "uz": "U uyga keladi va kitob o'qiydi.", "ru": "Он приходит домой и читает.", "tr": "O eve gelir ve kitap okur." }, "altEnFor": { "uz": ["She comes home and reads."], "tr": ["She comes home and reads."] }, "altNative": { "uz": ["U uyga keladi va o'qiydi.", "U uyga kelib, kitob o'qiydi."], "tr": ["O eve gelir ve okur.", "Eve gelir ve kitap okur.", "O eve geliyor ve kitap okuyor."] } },
    { "id": "u07.s.27", "en": "I watch TV in the evening.", "altEn": ["In the evening I watch TV."], "native": { "uz": "Men kechqurun televizor tomosha qilaman.", "ru": "Вечером я смотрю телевизор.", "tr": "Akşamları televizyon izlerim." }, "altNative": { "uz": ["Kechqurun televizor tomosha qilaman.", "Kechqurun men televizor tomosha qilaman.", "Men kechqurun televizor ko'raman.", "Kechqurun televizor ko'raman."], "ru": ["Я смотрю телевизор вечером.", "По вечерам я смотрю телевизор.", "Я смотрю телевизор по вечерам."], "tr": ["Ben akşamları televizyon izlerim.", "Akşam televizyon izlerim.", "Akşamları televizyon izliyorum.", "Akşamları televizyon seyrederim.", "Akşamları TV izlerim."] } },
    { "id": "u07.s.28", "en": "My son doesn't watch TV.", "native": { "uz": "Mening o'g'lim televizor tomosha qilmaydi.", "ru": "Мой сын не смотрит телевизор.", "tr": "Oğlum televizyon izlemez." }, "altNative": { "uz": ["O'g'lim televizor tomosha qilmaydi.", "Mening o'g'lim televizor ko'rmaydi.", "O'g'lim televizor ko'rmaydi."], "tr": ["Benim oğlum televizyon izlemez.", "Oğlum televizyon izlemiyor.", "Oğlum televizyon seyretmez.", "Oğlum TV izlemez."] } },
    { "id": "u07.s.29", "en": "We eat dinner, then I study.", "altEn": ["We have dinner, then I study."], "native": { "uz": "Biz kechki ovqat yeymiz, keyin men dars qilaman.", "ru": "Мы ужинаем, потом я занимаюсь.", "tr": "Akşam yemeği yeriz, sonra ben ders çalışırım." }, "altNative": { "uz": ["Biz kechki ovqat yeymiz, keyin dars qilaman.", "Biz kechki ovqatni yeymiz, keyin men dars qilaman."], "ru": ["Мы ужинаем, а потом я занимаюсь.", "Мы ужинаем, затем я занимаюсь.", "Мы ужинаем, потом я учусь."], "tr": ["Akşam yemeği yeriz, sonra ders çalışırım.", "Biz akşam yemeği yeriz, sonra ben ders çalışırım.", "Akşam yemeği yiyoruz, sonra ben ders çalışıyorum."] } },
    { "id": "u07.s.30", "en": "I read, then I go to bed.", "altEn": ["I read a book, then I go to bed."], "native": { "uz": "Men kitob o'qiyman, keyin yotaman.", "ru": "Я читаю, потом ложусь спать.", "tr": "Kitap okurum, sonra yatarım." }, "altNative": { "uz": ["Kitob o'qiyman, keyin yotaman.", "Men o'qiyman, keyin yotaman.", "Men kitob o'qiyman, keyin uxlashga yotaman."], "ru": ["Я читаю, а потом ложусь спать.", "Я читаю, потом я ложусь спать.", "Я читаю, потом иду спать."], "tr": ["Ben kitap okurum, sonra yatarım.", "Okurum, sonra yatarım.", "Kitap okurum, sonra yatağa giderim.", "Kitap okuyorum, sonra yatıyorum."] } },
    { "id": "u07.s.31", "en": "Do you study at night?", "native": { "uz": "Sen kechasi dars qilasanmi?", "ru": "Ты занимаешься по ночам?", "tr": "Geceleri ders çalışır mısın?" }, "altNative": { "uz": ["Kechasi dars qilasanmi?", "Sen tunda dars qilasanmi?"], "ru": ["Ты занимаешься ночью?", "Ты учишься по ночам?", "Ты учишься ночью?"], "tr": ["Sen geceleri ders çalışır mısın?", "Gece ders çalışır mısın?", "Geceleri ders çalışıyor musun?"] } },
    { "id": "u07.s.32", "en": "What do you do in the evening?", "native": { "uz": "Sen kechqurun nima qilasan?", "ru": "Что ты делаешь вечером?", "tr": "Akşamları ne yaparsın?" }, "altNative": { "uz": ["Kechqurun nima qilasan?", "Kechqurun sen nima qilasan?"], "ru": ["Что ты делаешь по вечерам?", "Чем ты занимаешься вечером?", "Чем ты занимаешься по вечерам?"], "tr": ["Sen akşamları ne yaparsın?", "Akşam ne yaparsın?", "Akşamları ne yapıyorsun?"] } },

    { "id": "u07.s.33", "en": "I am very busy this week.", "altEn": ["This week I am very busy."], "native": { "uz": "Men bu hafta juda bandman.", "ru": "Я очень занят на этой неделе.", "tr": "Bu hafta çok meşgulüm." }, "altNative": { "uz": ["Bu hafta juda bandman.", "Bu hafta men juda bandman.", "Men shu hafta juda bandman."], "ru": ["Я очень занята на этой неделе.", "На этой неделе я очень занят.", "На этой неделе я очень занята."], "tr": ["Ben bu hafta çok meşgulüm.", "Bu hafta çok yoğunum."] } },
    { "id": "u07.s.34", "en": "Are you free this weekend?", "native": { "uz": "Sen shu dam olish kunlari bo'shmisan?", "ru": "Ты свободен в эти выходные?", "tr": "Bu hafta sonu boş musun?" }, "altNative": { "uz": ["Shu dam olish kunlari bo'shmisan?", "Sen bu dam olish kunlari bo'shmisan?", "Bu dam olish kunlari bo'shmisan?"], "ru": ["Ты свободна в эти выходные?", "Ты свободен на этих выходных?", "Ты свободна на этих выходных?"], "tr": ["Sen bu hafta sonu boş musun?", "Bu hafta sonu müsait misin?", "Bu hafta sonu serbest misin?"] } },
    { "id": "u07.s.35", "en": "I see my grandmother every week.", "altEn": ["Every week I see my grandmother."], "native": { "uz": "Men buvimni har hafta ko'raman.", "ru": "Я вижусь с бабушкой каждую неделю.", "tr": "Büyükannemi her hafta görürüm." }, "altNative": { "uz": ["Men har hafta buvimni ko'raman.", "Buvimni har hafta ko'raman.", "Har hafta buvimni ko'raman."], "ru": ["Я вижу бабушку каждую неделю.", "Я вижу свою бабушку каждую неделю.", "Каждую неделю я вижусь с бабушкой.", "Я каждую неделю вижусь с бабушкой."], "tr": ["Ben büyükannemi her hafta görürüm.", "Her hafta büyükannemi görürüm.", "Büyükannemi her hafta görüyorum.", "Ninemi her hafta görürüm.", "Babaannemi her hafta görürüm.", "Anneannemi her hafta görürüm."] } },
    { "id": "u07.s.36", "en": "I have a shower before breakfast.", "altEn": ["I take a shower before breakfast.", "Before breakfast I have a shower."], "native": { "uz": "Men nonushtadan oldin dush qabul qilaman.", "ru": "Я принимаю душ до завтрака.", "tr": "Kahvaltıdan önce duş alırım." }, "altNative": { "uz": ["Nonushtadan oldin dush qabul qilaman.", "Men nonushtadan avval dush qabul qilaman.", "Men nonushtadan oldin dushga tushaman."], "ru": ["Я принимаю душ перед завтраком.", "Перед завтраком я принимаю душ.", "До завтрака я принимаю душ."], "tr": ["Ben kahvaltıdan önce duş alırım.", "Kahvaltıdan önce duş alıyorum."] } },
    { "id": "u07.s.37", "en": "After work I usually walk home.", "altEn": ["I usually walk home after work."], "native": { "uz": "Ishdan keyin men odatda uyga piyoda boraman.", "ru": "После работы я обычно иду домой пешком.", "tr": "İşten sonra genellikle eve yürüyerek giderim." }, "altNative": { "uz": ["Ishdan keyin odatda uyga piyoda boraman.", "Men ishdan keyin odatda uyga piyoda boraman.", "Ishdan keyin men odatda uyga piyoda qaytaman."], "ru": ["После работы я обычно хожу домой пешком.", "Я обычно иду домой пешком после работы.", "После работы я обычно возвращаюсь домой пешком."], "tr": ["Ben işten sonra genellikle eve yürüyerek giderim.", "İşten sonra genelde eve yürüyerek giderim.", "İşten sonra genellikle eve yürürüm.", "İşten sonra genellikle eve yürüyerek gidiyorum."] } },
    { "id": "u07.s.38", "en": "I don't work on the weekend.", "altEn": ["I don't work at the weekend.", "I don't work on weekends.", "I don't work at weekends."], "native": { "uz": "Men dam olish kunlari ishlamayman.", "ru": "Я не работаю в выходные.", "tr": "Hafta sonu çalışmam." }, "altNative": { "uz": ["Dam olish kunlari ishlamayman.", "Dam olish kunlari men ishlamayman."], "ru": ["Я не работаю по выходным.", "В выходные я не работаю.", "По выходным я не работаю."], "tr": ["Ben hafta sonu çalışmam.", "Hafta sonları çalışmam.", "Hafta sonu çalışmıyorum.", "Hafta sonları çalışmıyorum."] } },
    { "id": "u07.s.39", "en": "What time do you get up?", "native": { "uz": "Sen soat nechada turasan?", "ru": "Во сколько ты встаёшь?", "tr": "Saat kaçta kalkarsın?" }, "altNative": { "uz": ["Soat nechada turasan?", "Sen nechada turasan?"], "ru": ["Ты во сколько встаёшь?", "В котором часу ты встаёшь?"], "tr": ["Sen saat kaçta kalkarsın?", "Saat kaçta kalkıyorsun?", "Kaçta kalkarsın?"] } },
    { "id": "u07.s.40", "en": "Do you have free time after school?", "native": { "uz": "Maktabdan keyin bo'sh vaqting bormi?", "ru": "У тебя есть свободное время после школы?", "tr": "Okuldan sonra boş zamanın var mı?" }, "altNative": { "uz": ["Sening maktabdan keyin bo'sh vaqting bormi?", "Maktabdan keyin sening bo'sh vaqting bormi?", "Darsdan keyin bo'sh vaqting bormi?"], "ru": ["После школы у тебя есть свободное время?", "У тебя после школы есть свободное время?"], "tr": ["Okuldan sonra boş vaktin var mı?", "Senin okuldan sonra boş zamanın var mı?"] } }
