  "sentences": [
    { "id": "u20.s.01", "en": "Here is my CV.", "native": { "uz": "Mana mening rezyumem.", "ru": "Вот моё резюме.", "tr": "İşte özgeçmişim." }, "altNative": { "uz": ["Mana rezyumem."] } },
    { "id": "u20.s.02", "en": "What are your skills?", "native": { "uz": "Ko'nikmalaringiz qanday?", "ru": "Какие у вас навыки?", "tr": "Becerileriniz neler?" } },
    { "id": "u20.s.03", "en": "What is your strength?", "native": { "uz": "Kuchli tomoningiz nima?", "ru": "Какая у вас сильная сторона?", "tr": "Güçlü yönünüz nedir?" } },
    { "id": "u20.s.04", "en": "I am hard-working.", "native": { "uz": "Men mehnatkashman.", "ru": "Я трудолюбивый.", "tr": "Çalışkanım." }, "altNative": { "ru": ["Я трудолюбивая."], "tr": ["Ben çalışkanım."] } },
    { "id": "u20.s.05", "en": "I am responsible.", "native": { "uz": "Men mas'uliyatliman.", "ru": "Я ответственный.", "tr": "Sorumluyum." }, "altNative": { "ru": ["Я ответственная."], "tr": ["Ben sorumluyum."] } },
    { "id": "u20.s.06", "en": "I can drive a car.", "native": { "uz": "Men mashina hayday olaman.", "ru": "Я умею водить машину.", "tr": "Araba sürebilirim." }, "altNative": { "ru": ["Я могу водить машину."] } },
    { "id": "u20.s.07", "en": "I can work in a team.", "native": { "uz": "Men jamoada ishlay olaman.", "ru": "Я умею работать в команде.", "tr": "Takım içinde çalışabilirim." }, "altNative": { "ru": ["Я могу работать в команде."], "tr": ["Takımda çalışabilirim."] } },
    { "id": "u20.s.08", "en": "My skills are good.", "native": { "uz": "Ko'nikmalarim yaxshi.", "ru": "Мои навыки хорошие.", "tr": "Becerilerim iyi." }, "altNative": { "ru": ["У меня хорошие навыки."] } },

    { "id": "u20.s.09", "en": "Which position do you want?", "native": { "uz": "Qaysi lavozimni xohlaysiz?", "ru": "Какую должность вы хотите?", "tr": "Hangi pozisyonu istiyorsunuz?" } },
    { "id": "u20.s.10", "en": "I want to work in sales.", "native": { "uz": "Men savdoda ishlashni xohlayman.", "ru": "Я хочу работать в продажах.", "tr": "Satışta çalışmak istiyorum." } },
    { "id": "u20.s.11", "en": "I have two years of experience.", "native": { "uz": "Menda ikki yillik tajriba bor.", "ru": "У меня два года опыта.", "tr": "İki yıllık deneyimim var." } },
    { "id": "u20.s.12", "en": "I speak three languages.", "native": { "uz": "Men uchta tilda gapiraman.", "ru": "Я говорю на трёх языках.", "tr": "Üç dil konuşuyorum." } },
    { "id": "u20.s.13", "en": "I speak English and Russian.", "native": { "uz": "Men ingliz va rus tillarida gapiraman.", "ru": "Я говорю по-английски и по-русски.", "tr": "İngilizce ve Rusça konuşuyorum." } },
    { "id": "u20.s.14", "en": "I learn fast.", "native": { "uz": "Men tez o'rganaman.", "ru": "Я быстро учусь.", "tr": "Hızlı öğrenirim." } },
    { "id": "u20.s.15", "en": "I want to learn new skills.", "native": { "uz": "Men yangi ko'nikmalarni o'rganishni xohlayman.", "ru": "Я хочу получить новые навыки.", "tr": "Yeni beceriler öğrenmek istiyorum." } },
    { "id": "u20.s.16", "en": "This is my previous company.", "native": { "uz": "Bu mening avvalgi kompaniyam.", "ru": "Это моя предыдущая компания.", "tr": "Bu benim önceki şirketim." } },

    { "id": "u20.s.17", "en": "Is the job full-time?", "native": { "uz": "Ish to'liq stavkami?", "ru": "Это работа на полный рабочий день?", "tr": "İş tam zamanlı mı?" } },
    { "id": "u20.s.18", "en": "I want a part-time job.", "native": { "uz": "Men yarim stavkali ish xohlayman.", "ru": "Я хочу работу на неполный рабочий день.", "tr": "Yarı zamanlı bir iş istiyorum." } },
    { "id": "u20.s.19", "en": "I can work the night shift.", "native": { "uz": "Men tungi smenada ishlay olaman.", "ru": "Я могу работать в ночную смену.", "tr": "Gece vardiyasında çalışabilirim." } },
    { "id": "u20.s.20", "en": "When can you start?", "native": { "uz": "Qachon boshlay olasiz?", "ru": "Когда вы можете начать?", "tr": "Ne zaman başlayabilirsiniz?" } },
    { "id": "u20.s.21", "en": "I can start on Monday.", "native": { "uz": "Men dushanba kuni boshlay olaman.", "ru": "Я могу начать в понедельник.", "tr": "Pazartesi günü başlayabilirim." } },
    { "id": "u20.s.22", "en": "I am ready to start.", "native": { "uz": "Men boshlashga tayyorman.", "ru": "Я готов начать.", "tr": "Başlamaya hazırım." }, "altNative": { "ru": ["Я готова начать."] } },
    { "id": "u20.s.23", "en": "Can you work on the weekend?", "native": { "uz": "Dam olish kunlari ishlay olasizmi?", "ru": "Вы можете работать в выходные?", "tr": "Hafta sonu çalışabilir misiniz?" } },
    { "id": "u20.s.24", "en": "Yes, I can.", "native": { "uz": "Ha, qila olaman.", "ru": "Да, могу.", "tr": "Evet, yapabilirim." }, "altNative": { "uz": ["Ha, olaman."], "ru": ["Да, я могу."] } },

    { "id": "u20.s.25", "en": "Is there a contract?", "native": { "uz": "Shartnoma bormi?", "ru": "Есть ли договор?", "tr": "Sözleşme var mı?" }, "altNative": { "ru": ["Договор есть?"] } },
    { "id": "u20.s.26", "en": "When do you pay?", "native": { "uz": "Qachon to'laysiz?", "ru": "Когда вы платите?", "tr": "Ne zaman ödüyorsunuz?" } },
    { "id": "u20.s.27", "en": "Is there training?", "native": { "uz": "Trening bormi?", "ru": "Есть ли обучение?", "tr": "Eğitim var mı?" }, "altNative": { "ru": ["Обучение есть?"] } },
    { "id": "u20.s.28", "en": "Do I need a uniform?", "native": { "uz": "Menga forma kerakmi?", "ru": "Мне нужна форма?", "tr": "Üniformaya ihtiyacım var mı?" } },
    { "id": "u20.s.29", "en": "Which documents do you need?", "native": { "uz": "Sizga qaysi hujjatlar kerak?", "ru": "Какие документы вам нужны?", "tr": "Hangi belgelere ihtiyacınız var?" } },
    { "id": "u20.s.30", "en": "Please sign the contract.", "native": { "uz": "Iltimos, shartnomani imzolang.", "ru": "Пожалуйста, подпишите договор.", "tr": "Lütfen sözleşmeyi imzalayın." } },
    { "id": "u20.s.31", "en": "Here are my documents.", "native": { "uz": "Mana mening hujjatlarim.", "ru": "Вот мои документы.", "tr": "İşte belgelerim." }, "altNative": { "uz": ["Mana hujjatlarim."] } },
    { "id": "u20.s.32", "en": "The training is two weeks.", "native": { "uz": "Trening ikki hafta.", "ru": "Обучение длится две недели.", "tr": "Eğitim iki hafta." }, "altNative": { "uz": ["Trening ikki hafta davom etadi."], "tr": ["Eğitim iki hafta sürüyor."] } },

    { "id": "u20.s.33", "en": "We want to hire you.", "native": { "uz": "Biz sizni ishga olmoqchimiz.", "ru": "Мы хотим вас нанять.", "tr": "Sizi işe almak istiyoruz." }, "altNative": { "ru": ["Мы хотим нанять вас."] } },
    { "id": "u20.s.34", "en": "We have an offer for you.", "native": { "uz": "Bizda siz uchun taklif bor.", "ru": "У нас есть для вас предложение.", "tr": "Size bir teklifimiz var." }, "altNative": { "ru": ["У нас есть предложение для вас."], "tr": ["Sizin için bir teklifimiz var."] } },
    { "id": "u20.s.35", "en": "I accept the offer.", "native": { "uz": "Men taklifni qabul qilaman.", "ru": "Я принимаю предложение.", "tr": "Teklifi kabul ediyorum." } },
    { "id": "u20.s.36", "en": "It is a good decision.", "native": { "uz": "Bu yaxshi qaror.", "ru": "Это хорошее решение.", "tr": "Bu iyi bir karar." } },
    { "id": "u20.s.37", "en": "Congratulations, you have the job!", "native": { "uz": "Tabriklayman, ish sizniki!", "ru": "Поздравляю, работа ваша!", "tr": "Tebrikler, iş sizin!" } },
    { "id": "u20.s.38", "en": "Welcome to the team!", "native": { "uz": "Jamoaga xush kelibsiz!", "ru": "Добро пожаловать в команду!", "tr": "Takıma hoş geldiniz!" } },
    { "id": "u20.s.39", "en": "Thank you for the offer.", "native": { "uz": "Taklif uchun rahmat.", "ru": "Спасибо за предложение.", "tr": "Teklif için teşekkür ederim." }, "altNative": { "tr": ["Teklif için teşekkürler."] } },
    { "id": "u20.s.40", "en": "What is your decision?", "native": { "uz": "Qaroringiz qanday?", "ru": "Какое ваше решение?", "tr": "Kararınız nedir?" } }
  ],
