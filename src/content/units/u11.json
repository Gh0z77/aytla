  "sentences": [
    { "id": "u11.s.01", "en": "What time is it?", "altEn": ["What is the time?", "What time is it now?"], "native": { "uz": "Soat necha?", "ru": "Который час?", "tr": "Saat kaç?" }, "altNative": { "uz": ["Soat necha bo'ldi?", "Hozir soat necha?"], "ru": ["Сколько времени?", "Сколько сейчас времени?", "Который сейчас час?"], "tr": ["Şu an saat kaç?", "Şimdi saat kaç?"] } },
    { "id": "u11.s.02", "en": "It is five o'clock.", "altEn": ["It is five."], "native": { "uz": "Soat besh.", "ru": "Пять часов.", "tr": "Saat beş." }, "altNative": { "uz": ["Hozir soat besh.", "Soat besh bo'ldi."], "ru": ["Сейчас пять часов.", "Сейчас пять."], "tr": ["Şu an saat beş."] } },
    { "id": "u11.s.03", "en": "It is half past six.", "altEn": ["It is six thirty."], "native": { "uz": "Soat olti yarim.", "ru": "Половина седьмого.", "tr": "Saat altı buçuk." }, "altNative": { "uz": ["Hozir soat olti yarim.", "Soat oltidan o'ttiz daqiqa o'tdi."], "ru": ["Полседьмого.", "Сейчас половина седьмого.", "Шесть тридцать."], "tr": ["Şu an saat altı buçuk."] } },
    { "id": "u11.s.04", "en": "It is ten past nine.", "altEn": ["It is ten minutes past nine.", "It is nine ten.", "It is ten after nine."], "native": { "uz": "Soat to'qqizdan o'n daqiqa o'tdi.", "ru": "Десять минут десятого.", "tr": "Saat dokuzu on geçiyor." }, "altNative": { "uz": ["To'qqizdan o'n daqiqa o'tdi.", "Soat to'qqizdan o'nta o'tdi."], "ru": ["Сейчас десять минут десятого.", "Девять десять.", "Девять часов десять минут."], "tr": ["Dokuzu on geçiyor."] } },
    { "id": "u11.s.05", "en": "It is quarter past two.", "altEn": ["It is a quarter past two.", "It is two fifteen."], "native": { "uz": "Soat ikkidan chorak o'tdi.", "ru": "Четверть третьего.", "tr": "Saat ikiyi çeyrek geçiyor." }, "altNative": { "uz": ["Ikkidan chorak o'tdi.", "Soat ikkidan o'n besh daqiqa o'tdi."], "ru": ["Сейчас четверть третьего.", "Пятнадцать минут третьего.", "Два пятнадцать."], "tr": ["İkiyi çeyrek geçiyor."] } },
    { "id": "u11.s.06", "en": "It is quarter to six.", "altEn": ["It is a quarter to six."], "native": { "uz": "Soat chorak kam olti.", "ru": "Без четверти шесть.", "tr": "Saat altıya çeyrek var." }, "altNative": { "uz": ["Chorak kam olti.", "Soat oltiga chorak qoldi.", "Oltiga chorak qoldi."], "ru": ["Сейчас без четверти шесть.", "Без пятнадцати шесть."], "tr": ["Altıya çeyrek var."] } },
    { "id": "u11.s.07", "en": "Is it eight o'clock now?", "altEn": ["Is it eight now?", "Is it now eight o'clock?"], "native": { "uz": "Hozir soat sakkizmi?", "ru": "Сейчас восемь часов?", "tr": "Şimdi saat sekiz mi?" }, "altNative": { "uz": ["Soat hozir sakkizmi?", "Hozir soat sakkiz bo'ldimi?"], "ru": ["Сейчас восемь?"], "tr": ["Saat şimdi sekiz mi?", "Şu an saat sekiz mi?"] } },
    { "id": "u11.s.08", "en": "Where is the clock?", "native": { "uz": "Soat qayerda?", "ru": "Где часы?", "tr": "Saat nerede?" }, "altEnFor": { "uz": ["Where is the watch?"], "ru": ["Where is the watch?"], "tr": ["Where is the watch?"] } },

    { "id": "u11.s.09", "en": "Today is Monday.", "altEn": ["It is Monday today.", "Today it is Monday."], "native": { "uz": "Bugun dushanba.", "ru": "Сегодня понедельник.", "tr": "Bugün pazartesi." } },
    { "id": "u11.s.10", "en": "Tomorrow is Tuesday.", "altEn": ["It is Tuesday tomorrow."], "native": { "uz": "Ertaga seshanba.", "ru": "Завтра вторник.", "tr": "Yarın salı." } },
    { "id": "u11.s.11", "en": "Is today Wednesday?", "altEn": ["Is it Wednesday today?"], "native": { "uz": "Bugun chorshanbami?", "ru": "Сегодня среда?", "tr": "Bugün çarşamba mı?" } },
    { "id": "u11.s.12", "en": "No, today is Thursday.", "altEn": ["No, it is Thursday today."], "native": { "uz": "Yo'q, bugun payshanba.", "ru": "Нет, сегодня четверг.", "tr": "Hayır, bugün perşembe." } },
    { "id": "u11.s.13", "en": "See you on Friday!", "altEn": ["See you Friday!"], "native": { "uz": "Juma kuni ko'rishguncha!", "ru": "Увидимся в пятницу!", "tr": "Cuma günü görüşürüz!" }, "altNative": { "uz": ["Jumada ko'rishguncha!", "Juma kuni ko'rishamiz!"], "ru": ["До пятницы!"], "tr": ["Cuma görüşürüz!", "Cumaya görüşürüz!"] } },
    { "id": "u11.s.14", "en": "I love Saturday and Sunday.", "native": { "uz": "Men shanba va yakshanbani yaxshi ko'raman.", "ru": "Я люблю субботу и воскресенье.", "tr": "Cumartesiyi ve pazarı seviyorum." }, "altNative": { "uz": ["Shanba va yakshanbani yaxshi ko'raman.", "Men shanbani va yakshanbani yaxshi ko'raman.", "Men shanba va yakshanbani sevaman."], "tr": ["Ben cumartesiyi ve pazarı seviyorum.", "Cumartesi ve pazarı seviyorum.", "Ben cumartesi ve pazarı seviyorum.", "Cumartesi ve pazar günlerini seviyorum."] } },
    { "id": "u11.s.15", "en": "Today is not Saturday.", "altEn": ["It is not Saturday today."], "native": { "uz": "Bugun shanba emas.", "ru": "Сегодня не суббота.", "tr": "Bugün cumartesi değil." } },
    { "id": "u11.s.16", "en": "We are at home on Sunday.", "altEn": ["On Sunday we are at home."], "native": { "uz": "Biz yakshanba kuni uydamiz.", "ru": "В воскресенье мы дома.", "tr": "Pazar günü evdeyiz." }, "altNative": { "uz": ["Yakshanba kuni biz uydamiz.", "Yakshanba kuni uydamiz.", "Biz yakshanbada uydamiz."], "ru": ["Мы дома в воскресенье."], "tr": ["Biz pazar günü evdeyiz.", "Pazar günü biz evdeyiz."] } },

    { "id": "u11.s.17", "en": "The meeting is on Monday.", "native": { "uz": "Yig'ilish dushanba kuni.", "ru": "Собрание в понедельник.", "tr": "Toplantı pazartesi günü." }, "altNative": { "uz": ["Yig'ilish dushanbada.", "Majlis dushanba kuni.", "Yig'ilish dushanba kuni bo'ladi."], "ru": ["Встреча в понедельник.", "Совещание в понедельник.", "Собрание будет в понедельник."], "tr": ["Toplantı pazartesi."] } },
    { "id": "u11.s.18", "en": "The meeting is at nine o'clock.", "altEn": ["The meeting is at nine."], "native": { "uz": "Yig'ilish soat to'qqizda.", "ru": "Собрание в девять часов.", "tr": "Toplantı saat dokuzda." }, "altNative": { "uz": ["Majlis soat to'qqizda.", "Yig'ilish to'qqizda."], "ru": ["Собрание в девять.", "Встреча в девять часов.", "Встреча в девять.", "Совещание в девять часов."], "tr": ["Toplantı dokuzda."] } },
    { "id": "u11.s.19", "en": "See you at noon!", "native": { "uz": "Tush payti ko'rishguncha!", "ru": "Увидимся в полдень!", "tr": "Öğlen görüşürüz!" }, "altNative": { "uz": ["Tushda ko'rishguncha!", "Tush payti ko'rishamiz!", "Peshinda ko'rishguncha!"], "ru": ["До встречи в полдень!"], "tr": ["Öğleyin görüşürüz!", "Öğle vakti görüşürüz!"] } },
    { "id": "u11.s.20", "en": "I drink tea in the afternoon.", "altEn": ["In the afternoon I drink tea."], "native": { "uz": "Men tushdan keyin choy ichaman.", "ru": "Я пью чай после полудня.", "tr": "Öğleden sonra çay içiyorum." }, "altNative": { "uz": ["Tushdan keyin men choy ichaman.", "Tushdan keyin choy ichaman.", "Men peshindan keyin choy ichaman."], "ru": ["После полудня я пью чай.", "Я пью чай после обеда.", "После обеда я пью чай.", "Днём я пью чай.", "Я пью чай днём."], "tr": ["Ben öğleden sonra çay içiyorum.", "Öğleden sonra çay içerim.", "Ben öğleden sonra çay içerim."] } },
    { "id": "u11.s.21", "en": "We do not eat at midnight.", "native": { "uz": "Biz yarim tunda ovqat yemaymiz.", "ru": "Мы не едим в полночь.", "tr": "Gece yarısı yemek yemiyoruz." }, "altNative": { "uz": ["Biz yarim tunda yemaymiz.", "Yarim tunda ovqat yemaymiz.", "Biz yarim kechasi ovqat yemaymiz."], "ru": ["В полночь мы не едим."], "tr": ["Biz gece yarısı yemek yemiyoruz.", "Gece yarısında yemek yemiyoruz.", "Gece yarısı yemek yemeyiz.", "Biz gece yarısı yemek yemeyiz."] } },
    { "id": "u11.s.22", "en": "What day is it today?", "altEn": ["What day is today?"], "native": { "uz": "Bugun qaysi kun?", "ru": "Какой сегодня день?", "tr": "Bugün günlerden ne?" }, "altNative": { "uz": ["Bugun haftaning qaysi kuni?", "Bugun nima kun?"], "ru": ["Какой сегодня день недели?", "Какой день сегодня?"], "tr": ["Bugün hangi gün?"] } },
    { "id": "u11.s.23", "en": "Are you at home tonight?", "altEn": ["Are you home tonight?"], "native": { "uz": "Bugun kechqurun uydamisan?", "ru": "Ты сегодня вечером дома?", "tr": "Bu gece evde misin?" }, "altNative": { "uz": ["Sen bugun kechqurun uydamisan?", "Bugun kechasi uydamisan?", "Bugun kechqurun uyda bo'lasanmi?"], "ru": ["Ты дома сегодня вечером?", "Сегодня вечером ты дома?", "Ты будешь дома сегодня вечером?"], "tr": ["Bu akşam evde misin?", "Sen bu gece evde misin?"] } },
    { "id": "u11.s.24", "en": "Wednesday is a good day for a meeting.", "native": { "uz": "Chorshanba yig'ilish uchun yaxshi kun.", "ru": "Среда — хороший день для собрания.", "tr": "Çarşamba toplantı için iyi bir gün." }, "altNative": { "uz": ["Chorshanba majlis uchun yaxshi kun."], "ru": ["Среда — хороший день для встречи.", "Среда — хороший день для совещания."], "tr": ["Çarşamba toplantı için güzel bir gün."] } },

    { "id": "u11.s.25", "en": "When is the meeting?", "native": { "uz": "Yig'ilish qachon?", "ru": "Когда собрание?", "tr": "Toplantı ne zaman?" }, "altNative": { "uz": ["Majlis qachon?", "Yig'ilish qachon bo'ladi?"], "ru": ["Когда встреча?", "Когда совещание?", "Когда будет собрание?"] } },
    { "id": "u11.s.26", "en": "When does the cafe open?", "native": { "uz": "Kafe qachon ochiladi?", "ru": "Когда открывается кафе?", "tr": "Kafe ne zaman açılıyor?" }, "altNative": { "ru": ["Когда кафе открывается?"], "tr": ["Kafe ne zaman açılır?"] } },
    { "id": "u11.s.27", "en": "The cafe closes at ten.", "altEn": ["The cafe closes at ten o'clock."], "native": { "uz": "Kafe soat o'nda yopiladi.", "ru": "Кафе закрывается в десять.", "tr": "Kafe saat onda kapanıyor." }, "altNative": { "uz": ["Kafe o'nda yopiladi."], "ru": ["Кафе закрывается в десять часов."], "tr": ["Kafe onda kapanıyor.", "Kafe saat onda kapanır."] } },
    { "id": "u11.s.28", "en": "The cafe is open until midnight.", "native": { "uz": "Kafe yarim tungacha ochiq.", "ru": "Кафе открыто до полуночи.", "tr": "Kafe gece yarısına kadar açık." }, "altNative": { "uz": ["Kafe yarim kechagacha ochiq.", "Kafe yarim tungacha ishlaydi."], "ru": ["Кафе работает до полуночи."] } },
    { "id": "u11.s.29", "en": "I have an appointment on Tuesday at three.", "altEn": ["I have an appointment on Tuesday at three o'clock.", "I have an appointment at three on Tuesday."], "native": { "uz": "Seshanba kuni soat uchda uchrashuvim bor.", "ru": "У меня встреча во вторник в три.", "tr": "Salı günü saat üçte randevum var." }, "altNative": { "uz": ["Mening seshanba kuni soat uchda uchrashuvim bor.", "Seshanba kuni soat uchda mening uchrashuvim bor.", "Seshanba kuni soat uchda qabulim bor."], "ru": ["У меня встреча во вторник в три часа.", "Во вторник в три у меня встреча.", "Во вторник в три часа у меня встреча."], "tr": ["Salı günü saat üçte bir randevum var.", "Salı saat üçte randevum var.", "Salı günü üçte randevum var."] } },
    { "id": "u11.s.30", "en": "Can you wait an hour?", "altEn": ["Can you wait for an hour?", "Can you wait one hour?", "Can you wait for one hour?"], "native": { "uz": "Bir soat kuta olasanmi?", "ru": "Ты можешь подождать час?", "tr": "Bir saat bekleyebilir misin?" }, "altNative": { "uz": ["Sen bir soat kuta olasanmi?", "Bir soat kutib tura olasanmi?"], "ru": ["Можешь подождать час?", "Ты можешь подождать один час?", "Ты можешь час подождать?"], "tr": ["Sen bir saat bekleyebilir misin?", "Bir saat bekler misin?"] } },
    { "id": "u11.s.31", "en": "Please wait until Friday.", "altEn": ["Wait until Friday, please."], "native": { "uz": "Iltimos, jumagacha kut.", "ru": "Пожалуйста, подожди до пятницы.", "tr": "Lütfen cumaya kadar bekle." }, "altNative": { "uz": ["Jumagacha kut, iltimos.", "Iltimos, juma kunigacha kut.", "Iltimos, jumagacha kutib tur."], "ru": ["Подожди до пятницы, пожалуйста.", "Пожалуйста, жди до пятницы."], "tr": ["Cumaya kadar bekle, lütfen.", "Lütfen cuma gününe kadar bekle."] } },
    { "id": "u11.s.32", "en": "The cafe does not close at noon.", "native": { "uz": "Kafe tush payti yopilmaydi.", "ru": "Кафе не закрывается в полдень.", "tr": "Kafe öğlen kapanmıyor." }, "altNative": { "uz": ["Kafe tushda yopilmaydi.", "Kafe peshinda yopilmaydi."], "ru": ["В полдень кафе не закрывается."], "tr": ["Kafe öğleyin kapanmıyor.", "Kafe öğlen kapanmaz."] } },

    { "id": "u11.s.33", "en": "What is the date today?", "altEn": ["What is today's date?", "What date is it today?"], "native": { "uz": "Bugun nechanchi sana?", "ru": "Какое сегодня число?", "tr": "Bugünün tarihi ne?" }, "altNative": { "uz": ["Bugun sana nechanchi?", "Bugun oyning nechanchi kuni?"], "ru": ["Какая сегодня дата?", "Какое число сегодня?"], "tr": ["Bugün ayın kaçı?", "Bugün tarih ne?", "Bugünün tarihi nedir?"] } },
    { "id": "u11.s.34", "en": "Is next Monday a holiday?", "altEn": ["Is it a holiday next Monday?"], "native": { "uz": "Keyingi dushanba bayrammi?", "ru": "В следующий понедельник праздник?", "tr": "Gelecek pazartesi tatil mi?" }, "altNative": { "uz": ["Kelasi dushanba bayrammi?", "Keyingi dushanba dam olish kunimi?"], "ru": ["Следующий понедельник — праздник?", "В следующий понедельник выходной?", "Следующий понедельник — выходной?"], "tr": ["Önümüzdeki pazartesi tatil mi?", "Gelecek pazartesi bayram mı?", "Haftaya pazartesi tatil mi?"] } },
    { "id": "u11.s.35", "en": "Saturday is not a weekday.", "native": { "uz": "Shanba ish kuni emas.", "ru": "Суббота — не будний день.", "tr": "Cumartesi hafta içi değil." }, "altNative": { "ru": ["Суббота — не рабочий день."], "tr": ["Cumartesi iş günü değil.", "Cumartesi hafta içi bir gün değil."] } },
    { "id": "u11.s.36", "en": "I learn English every weekday.", "altEn": ["Every weekday I learn English.", "I learn English on weekdays."], "native": { "uz": "Men har ish kuni ingliz tilini o'rganaman.", "ru": "Я учу английский каждый будний день.", "tr": "Hafta içi her gün İngilizce öğreniyorum." }, "altNative": { "uz": ["Har ish kuni ingliz tilini o'rganaman.", "Men ish kunlari ingliz tilini o'rganaman.", "Men har ish kuni ingliz tilini o'rganyapman."], "ru": ["Каждый будний день я учу английский.", "Я учу английский по будням.", "По будням я учу английский."], "tr": ["Ben hafta içi her gün İngilizce öğreniyorum.", "Her hafta içi İngilizce öğreniyorum.", "Hafta içi her gün İngilizce öğrenirim."] } },
    { "id": "u11.s.37", "en": "We have a meeting every Monday.", "altEn": ["Every Monday we have a meeting.", "We have a meeting on Mondays."], "native": { "uz": "Bizda har dushanba yig'ilish bor.", "ru": "У нас собрание каждый понедельник.", "tr": "Her pazartesi toplantımız var." }, "altNative": { "uz": ["Bizda har dushanba kuni yig'ilish bor.", "Har dushanba yig'ilishimiz bor.", "Har dushanba kuni yig'ilishimiz bor.", "Bizda har dushanba majlis bor."], "ru": ["Каждый понедельник у нас собрание.", "У нас встреча каждый понедельник.", "У нас совещание каждый понедельник.", "По понедельникам у нас собрание."], "tr": ["Her pazartesi bir toplantımız var.", "Bizim her pazartesi toplantımız var.", "Her pazartesi günü toplantımız var."] } },
    { "id": "u11.s.38", "en": "The meeting is not on my calendar.", "altEn": ["The meeting is not in my calendar."], "native": { "uz": "Yig'ilish mening taqvimimda yo'q.", "ru": "Собрания нет в моём календаре.", "tr": "Toplantı takvimimde yok." }, "altNative": { "uz": ["Yig'ilish taqvimimda yo'q.", "Majlis mening taqvimimda yo'q.", "Yig'ilish mening kalendarimda yo'q."], "ru": ["В моём календаре нет собрания.", "Встречи нет в моём календаре.", "Совещания нет в моём календаре.", "Этого собрания нет в моём календаре."], "tr": ["Toplantı benim takvimimde yok.", "Toplantı takvimimde değil."] } },
    { "id": "u11.s.39", "en": "My next appointment is on Thursday at four.", "altEn": ["My next appointment is on Thursday at four o'clock.", "My next appointment is at four on Thursday."], "native": { "uz": "Mening keyingi uchrashuvim payshanba kuni soat to'rtda.", "ru": "Моя следующая встреча в четверг в четыре.", "tr": "Bir sonraki randevum perşembe günü saat dörtte." }, "altNative": { "uz": ["Keyingi uchrashuvim payshanba kuni soat to'rtda.", "Mening keyingi uchrashuvim payshanba kuni to'rtda."], "ru": ["Моя следующая встреча в четверг в четыре часа.", "Следующая встреча у меня в четверг в четыре."], "tr": ["Sonraki randevum perşembe günü saat dörtte.", "Gelecek randevum perşembe günü saat dörtte.", "Benim bir sonraki randevum perşembe günü saat dörtte."] } },
    { "id": "u11.s.40", "en": "See you next Friday at half past seven!", "altEn": ["See you next Friday at seven thirty!"], "native": { "uz": "Keyingi juma soat yetti yarimda ko'rishguncha!", "ru": "Увидимся в следующую пятницу в половине восьмого!", "tr": "Gelecek cuma saat yedi buçukta görüşürüz!" }, "altNative": { "uz": ["Keyingi juma kuni soat yetti yarimda ko'rishguncha!", "Kelasi juma soat yetti yarimda ko'rishguncha!", "Keyingi juma soat yetti yarimda ko'rishamiz!"], "ru": ["Увидимся в следующую пятницу в полвосьмого!", "Увидимся в следующую пятницу в семь тридцать!"], "tr": ["Önümüzdeki cuma saat yedi buçukta görüşürüz!", "Gelecek cuma yedi buçukta görüşürüz!", "Haftaya cuma saat yedi buçukta görüşürüz!"] } }
