  "sentences": [
    { "id": "u16.s.01", "en": "This is my head.", "native": { "uz": "Bu mening boshim.", "ru": "Это моя голова.", "tr": "Bu benim başım." }, "altNative": { "uz": ["Bu boshim."], "tr": ["Bu başım.", "Bu benim kafam."] } },
    { "id": "u16.s.02", "en": "I have two hands.", "native": { "uz": "Mening ikkita qo'lim bor.", "ru": "У меня две руки.", "tr": "Benim iki elim var." }, "altNative": { "uz": ["Ikkita qo'lim bor.", "Menda ikkita qo'l bor."], "ru": ["У меня есть две руки."], "tr": ["İki elim var."] } },
    { "id": "u16.s.03", "en": "Close your eyes.", "native": { "uz": "Ko'zlaringni yum.", "ru": "Закрой глаза.", "tr": "Gözlerini kapat." }, "altNative": { "uz": ["Ko'zingni yum.", "Ko'zlaringni yop."], "ru": ["Закрой свои глаза."], "tr": ["Gözlerini kapa.", "Gözünü kapat."] } },
    { "id": "u16.s.04", "en": "Open your mouth, please.", "altEn": ["Please open your mouth."], "native": { "uz": "Og'zingni och, iltimos.", "ru": "Открой рот, пожалуйста.", "tr": "Ağzını aç, lütfen." }, "altNative": { "uz": ["Iltimos, og'zingni och."], "ru": ["Пожалуйста, открой рот."], "tr": ["Lütfen ağzını aç."] } },
    { "id": "u16.s.05", "en": "The baby has a small nose.", "altEn": ["The baby's nose is small."], "native": { "uz": "Chaqaloqning burni kichik.", "ru": "У малыша маленький нос.", "tr": "Bebeğin burnu küçük." }, "altNative": { "uz": ["Chaqaloqning burni kichkina.", "Chaqaloqning kichik burni bor."], "ru": ["У малыша нос маленький.", "У ребёнка маленький нос.", "У малыша маленький носик."], "tr": ["Bebeğin küçük bir burnu var."] } },
    { "id": "u16.s.06", "en": "Are your hands cold?", "altEn": ["Do you have cold hands?"], "native": { "uz": "Qo'llaring sovuqmi?", "ru": "У тебя холодные руки?", "tr": "Ellerin soğuk mu?" }, "altNative": { "uz": ["Sening qo'llaring sovuqmi?", "Qo'llaring sovqotdimi?"], "ru": ["Твои руки холодные?", "У тебя руки холодные?", "У тебя замёрзли руки?"], "tr": ["Senin ellerin soğuk mu?", "Ellerin üşüdü mü?"] } },
    { "id": "u16.s.07", "en": "My legs are not tired.", "native": { "uz": "Mening oyoqlarim charchamadi.", "ru": "Мои ноги не устали.", "tr": "Bacaklarım yorulmadı." }, "altNative": { "uz": ["Oyoqlarim charchamadi.", "Mening oyoqlarim charchagan emas.", "Oyoqlarim charchagani yo'q."], "ru": ["У меня не устали ноги.", "У меня ноги не устали."], "tr": ["Benim bacaklarım yorulmadı.", "Bacaklarım yorgun değil."] } },
    { "id": "u16.s.08", "en": "Water is good for your body.", "native": { "uz": "Suv tanang uchun foydali.", "ru": "Вода полезна для твоего тела.", "tr": "Su vücudun için iyidir." }, "altNative": { "uz": ["Suv sening tanang uchun foydali.", "Suv tanang uchun yaxshi.", "Suv tanangga foydali."], "ru": ["Вода полезна для тела.", "Вода хороша для твоего тела."], "tr": ["Su vücudun için iyi.", "Su senin vücudun için iyidir.", "Su vücuduna iyi gelir."] } },

    { "id": "u16.s.09", "en": "I feel sick.", "altEn": ["I feel ill.", "I feel bad.", "I don't feel well."], "native": { "uz": "Men o'zimni yomon his qilyapman.", "ru": "Я плохо себя чувствую.", "tr": "Kendimi hasta hissediyorum." }, "altNative": { "uz": ["O'zimni yomon his qilyapman.", "Men o'zimni kasal his qilyapman.", "O'zimni kasal his qilyapman.", "Mazam yo'q."], "ru": ["Я себя плохо чувствую.", "Я чувствую себя плохо.", "Я чувствую себя больным.", "Я чувствую себя больной.", "Мне плохо.", "Мне нехорошо."], "tr": ["Ben kendimi hasta hissediyorum.", "Kendimi kötü hissediyorum.", "Kendimi iyi hissetmiyorum."] } },
    { "id": "u16.s.10", "en": "I have a headache.", "altEn": ["My head hurts."], "native": { "uz": "Mening boshim og'riyapti.", "ru": "У меня болит голова.", "tr": "Başım ağrıyor." }, "altNative": { "uz": ["Boshim og'riyapti.", "Boshim og'riydi.", "Menda bosh og'rig'i bor."], "ru": ["У меня голова болит.", "У меня головная боль.", "Голова болит."], "tr": ["Benim başım ağrıyor.", "Baş ağrım var."] } },
    { "id": "u16.s.11", "en": "Do you have a fever?", "altEn": ["Do you have a temperature?"], "native": { "uz": "Isitmang bormi?", "ru": "У тебя температура?", "tr": "Ateşin var mı?" }, "altNative": { "uz": ["Sening isitmang bormi?", "Senda isitma bormi?"], "ru": ["У тебя есть температура?", "У тебя жар?"], "tr": ["Senin ateşin var mı?"] } },
    { "id": "u16.s.12", "en": "My son has a bad cough.", "native": { "uz": "Mening o'g'limda qattiq yo'tal bor.", "ru": "У моего сына сильный кашель.", "tr": "Oğlumun kötü bir öksürüğü var." }, "altNative": { "uz": ["O'g'limda qattiq yo'tal bor.", "Mening o'g'lim qattiq yo'talyapti.", "O'g'lim qattiq yo'talyapti.", "Mening o'g'limning yo'tali yomon."], "ru": ["У моего сына плохой кашель.", "Мой сын сильно кашляет."], "tr": ["Benim oğlumun kötü bir öksürüğü var.", "Oğlumun kötü öksürüğü var.", "Oğlum çok kötü öksürüyor."] } },
    { "id": "u16.s.13", "en": "I feel very weak today.", "altEn": ["Today I feel very weak."], "native": { "uz": "Bugun o'zimni juda kuchsiz his qilyapman.", "ru": "Сегодня я чувствую себя очень слабым.", "tr": "Bugün kendimi çok güçsüz hissediyorum." }, "altNative": { "uz": ["Men bugun o'zimni juda kuchsiz his qilyapman.", "Bugun men o'zimni juda kuchsiz his qilyapman.", "O'zimni bugun juda kuchsiz his qilyapman.", "Bugun o'zimni juda holsiz his qilyapman.", "Men bugun o'zimni juda holsiz his qilyapman.", "Bugun o'zimni juda zaif his qilyapman."], "ru": ["Сегодня я чувствую себя очень слабой.", "Я сегодня чувствую себя очень слабым.", "Я сегодня чувствую себя очень слабой.", "Я чувствую себя очень слабым сегодня.", "Я чувствую себя очень слабой сегодня.", "Сегодня у меня сильная слабость."], "tr": ["Ben bugün kendimi çok güçsüz hissediyorum.", "Kendimi bugün çok güçsüz hissediyorum.", "Bugün kendimi çok halsiz hissediyorum.", "Bugün kendimi çok zayıf hissediyorum."] } },
    { "id": "u16.s.14", "en": "My daughter is sick.", "altEn": ["My daughter is ill."], "native": { "uz": "Mening qizim kasal.", "ru": "Моя дочь больна.", "tr": "Kızım hasta." }, "altNative": { "uz": ["Qizim kasal.", "Mening qizim betob."], "ru": ["Моя дочь болеет.", "Моя дочка больна.", "Моя дочь заболела.", "Моя дочь больная."], "tr": ["Benim kızım hasta."] } },
    { "id": "u16.s.15", "en": "How do you feel?", "altEn": ["How are you feeling?"], "native": { "uz": "O'zingni qanday his qilyapsan?", "ru": "Как ты себя чувствуешь?", "tr": "Kendini nasıl hissediyorsun?" }, "altNative": { "uz": ["Sen o'zingni qanday his qilyapsan?", "Ahvoling qanday?"], "ru": ["Как ты чувствуешь себя?", "Как себя чувствуешь?", "Как самочувствие?"], "tr": ["Sen kendini nasıl hissediyorsun?", "Nasıl hissediyorsun?"] } },
    { "id": "u16.s.16", "en": "I don't have a fever.", "altEn": ["I don't have a temperature.", "I have no fever."], "native": { "uz": "Mening isitmam yo'q.", "ru": "У меня нет температуры.", "tr": "Ateşim yok." }, "altNative": { "uz": ["Isitmam yo'q.", "Menda isitma yo'q."], "ru": ["У меня температуры нет.", "У меня нет жара."], "tr": ["Benim ateşim yok."] } },

    { "id": "u16.s.17", "en": "My leg hurts.", "native": { "uz": "Mening oyog'im og'riyapti.", "ru": "У меня болит нога.", "tr": "Bacağım ağrıyor." }, "altNative": { "uz": ["Oyog'im og'riyapti.", "Oyog'im og'riydi."], "ru": ["У меня нога болит.", "Моя нога болит.", "Нога болит."], "tr": ["Benim bacağım ağrıyor.", "Bacağım acıyor."] } },
    { "id": "u16.s.18", "en": "Where does it hurt?", "native": { "uz": "Qayering og'riyapti?", "ru": "Где болит?", "tr": "Neren ağrıyor?" }, "altNative": { "uz": ["Qayer og'riyapti?", "Sening qayering og'riyapti?"], "ru": ["Где у тебя болит?", "Где именно болит?", "Что у тебя болит?"], "tr": ["Neresi ağrıyor?", "Neren acıyor?", "Neresi acıyor?"] } },
    { "id": "u16.s.19", "en": "It hurts here.", "altEn": ["Here it hurts."], "native": { "uz": "Shu yerim og'riyapti.", "ru": "Здесь болит.", "tr": "Burası ağrıyor." }, "altNative": { "uz": ["Mana shu yerim og'riyapti.", "Bu yerim og'riyapti.", "Shu yer og'riyapti."], "ru": ["Болит здесь.", "Вот здесь болит.", "Тут болит.", "Болит тут.", "У меня болит здесь."], "tr": ["Buram ağrıyor.", "Burası acıyor.", "Buram acıyor.", "Şuram ağrıyor."] } },
    { "id": "u16.s.20", "en": "Does your tooth hurt?", "altEn": ["Do you have a toothache?"], "native": { "uz": "Tishing og'riyaptimi?", "ru": "У тебя болит зуб?", "tr": "Dişin ağrıyor mu?" }, "altNative": { "uz": ["Sening tishing og'riyaptimi?"], "ru": ["У тебя зуб болит?", "Твой зуб болит?", "Зуб болит?"], "tr": ["Senin dişin ağrıyor mu?", "Dişin acıyor mu?"] } },
    { "id": "u16.s.21", "en": "My back hurts after work.", "altEn": ["After work my back hurts."], "native": { "uz": "Ishdan keyin orqam og'riydi.", "ru": "После работы у меня болит спина.", "tr": "İşten sonra sırtım ağrıyor." }, "altNative": { "uz": ["Ishdan keyin mening orqam og'riydi.", "Mening orqam ishdan keyin og'riydi.", "Orqam ishdan keyin og'riydi.", "Ishdan keyin orqam og'riyapti.", "Ishdan keyin belim og'riydi.", "Ishdan keyin belim og'riyapti."], "ru": ["После работы у меня спина болит.", "У меня болит спина после работы.", "Моя спина болит после работы.", "После работы болит спина."], "tr": ["Sırtım işten sonra ağrıyor.", "İşten sonra benim sırtım ağrıyor.", "İşten sonra belim ağrıyor."] } },
    { "id": "u16.s.22", "en": "I have a pain in my ear.", "altEn": ["I have pain in my ear.", "My ear hurts."], "native": { "uz": "Qulog'imda og'riq bor.", "ru": "У меня боль в ухе.", "tr": "Kulağımda ağrı var." }, "altNative": { "uz": ["Mening qulog'imda og'riq bor.", "Qulog'im og'riyapti."], "ru": ["У меня болит ухо."], "tr": ["Kulağımda bir ağrı var.", "Kulağım ağrıyor."] } },
    { "id": "u16.s.23", "en": "My throat doesn't hurt now.", "native": { "uz": "Hozir tomog'im og'rimayapti.", "ru": "Сейчас у меня не болит горло.", "tr": "Boğazım şimdi ağrımıyor." }, "altNative": { "uz": ["Tomog'im hozir og'rimayapti.", "Hozir mening tomog'im og'rimayapti.", "Mening tomog'im hozir og'rimayapti."], "ru": ["У меня сейчас не болит горло.", "Горло у меня сейчас не болит.", "Сейчас горло не болит.", "Моё горло сейчас не болит."], "tr": ["Şimdi boğazım ağrımıyor.", "Benim boğazım şimdi ağrımıyor.", "Boğazım şu an ağrımıyor.", "Boğazım şimdi acımıyor."] } },
    { "id": "u16.s.24", "en": "My stomach hurts and I feel sick.", "native": { "uz": "Qornim og'riyapti va o'zimni yomon his qilyapman.", "ru": "У меня болит живот, и я плохо себя чувствую.", "tr": "Midem ağrıyor ve kendimi hasta hissediyorum." }, "altNative": { "uz": ["Mening qornim og'riyapti va o'zimni yomon his qilyapman.", "Oshqozonim og'riyapti va o'zimni yomon his qilyapman.", "Qornim og'riyapti va o'zimni kasal his qilyapman.", "Qornim og'riyapti va ko'nglim ayniyapti."], "ru": ["У меня болит живот, и я чувствую себя плохо.", "У меня болит живот, и мне плохо.", "У меня болит живот, и меня тошнит.", "У меня болит желудок, и я плохо себя чувствую."], "tr": ["Midem ağrıyor ve kendimi kötü hissediyorum.", "Karnım ağrıyor ve kendimi hasta hissediyorum.", "Karnım ağrıyor ve kendimi kötü hissediyorum.", "Midem ağrıyor ve midem bulanıyor."] } },

    { "id": "u16.s.25", "en": "You should rest.", "native": { "uz": "Sen dam olishing kerak.", "ru": "Тебе следует отдохнуть.", "tr": "Dinlenmelisin." }, "altNative": { "uz": ["Dam olishing kerak.", "Senga dam olish kerak."], "ru": ["Тебе стоит отдохнуть.", "Тебе нужно отдохнуть.", "Тебе надо отдохнуть.", "Тебе следует отдыхать."], "tr": ["Sen dinlenmelisin.", "Dinlenmen gerek.", "Dinlenmen lazım."] } },
    { "id": "u16.s.26", "en": "You should see a doctor.", "native": { "uz": "Sen shifokorga borishing kerak.", "ru": "Тебе следует сходить к врачу.", "tr": "Bir doktora gitmelisin." }, "altNative": { "uz": ["Shifokorga borishing kerak.", "Sen shifokorga ko'rinishing kerak.", "Shifokorga ko'rinishing kerak.", "Sen doktorga borishing kerak."], "ru": ["Тебе стоит сходить к врачу.", "Тебе нужно сходить к врачу.", "Тебе надо сходить к врачу.", "Тебе следует обратиться к врачу.", "Тебе стоит обратиться к врачу.", "Тебе следует пойти к врачу.", "Тебе нужно к врачу."], "tr": ["Doktora gitmelisin.", "Sen bir doktora gitmelisin.", "Bir doktora görünmelisin.", "Doktora görünmelisin."] } },
    { "id": "u16.s.27", "en": "Should I drink hot tea?", "native": { "uz": "Issiq choy ichishim kerakmi?", "ru": "Мне следует пить горячий чай?", "tr": "Sıcak çay içmeli miyim?" }, "altNative": { "uz": ["Men issiq choy ichishim kerakmi?"], "ru": ["Мне стоит пить горячий чай?", "Мне нужно пить горячий чай?", "Мне надо пить горячий чай?", "Мне следует выпить горячего чая?", "Мне стоит выпить горячего чая?"], "tr": ["Ben sıcak çay içmeli miyim?", "Sıcak çay mı içmeliyim?"] } },
    { "id": "u16.s.28", "en": "I feel better today.", "native": { "uz": "Bugun o'zimni yaxshiroq his qilyapman.", "ru": "Сегодня я чувствую себя лучше.", "tr": "Bugün kendimi daha iyi hissediyorum." }, "altNative": { "uz": ["Men bugun o'zimni yaxshiroq his qilyapman.", "Bugun men o'zimni yaxshiroq his qilyapman.", "Bugun ahvolim yaxshiroq."], "ru": ["Я сегодня чувствую себя лучше.", "Я чувствую себя лучше сегодня.", "Сегодня мне лучше.", "Мне сегодня лучше."], "tr": ["Ben bugün kendimi daha iyi hissediyorum.", "Bugün daha iyiyim."] } },
    { "id": "u16.s.29", "en": "You should not go to work today.", "native": { "uz": "Bugun ishga bormasliging kerak.", "ru": "Сегодня тебе не следует идти на работу.", "tr": "Bugün işe gitmemelisin." }, "altNative": { "uz": ["Sen bugun ishga bormasliging kerak.", "Bugun sen ishga bormasliging kerak.", "Bugun ishga borishing kerak emas."], "ru": ["Тебе не следует идти на работу сегодня.", "Тебе не следует сегодня идти на работу.", "Сегодня тебе не стоит идти на работу.", "Тебе не стоит идти на работу сегодня.", "Тебе не стоит сегодня идти на работу.", "Тебе не нужно сегодня идти на работу.", "Тебе не надо сегодня идти на работу."], "tr": ["Sen bugün işe gitmemelisin.", "Bugün işe gitmemen gerek.", "Bugün işe gitmemen lazım."] } },
    { "id": "u16.s.30", "en": "My grandfather is old but very healthy.", "native": { "uz": "Mening bobom keksa, lekin juda sog'lom.", "ru": "Мой дедушка старый, но очень здоровый.", "tr": "Büyükbabam yaşlı ama çok sağlıklı." }, "altNative": { "uz": ["Bobom keksa, lekin juda sog'lom.", "Mening bobom qari, lekin juda sog'lom.", "Bobom qari, lekin juda sog'lom.", "Mening bobom keksa, ammo juda sog'lom.", "Bobom keksa, ammo juda sog'lom."], "ru": ["Мой дедушка старый, но очень здоров.", "Мой дедушка стар, но очень здоров.", "Мой дедушка пожилой, но очень здоровый.", "Мой дед старый, но очень здоровый."], "tr": ["Benim büyükbabam yaşlı ama çok sağlıklı.", "Dedem yaşlı ama çok sağlıklı.", "Benim dedem yaşlı ama çok sağlıklı.", "Büyükbabam yaşlı fakat çok sağlıklı."] } },
    { "id": "u16.s.31", "en": "I exercise every day and feel strong.", "native": { "uz": "Men har kuni mashq qilaman va o'zimni kuchli his qilaman.", "ru": "Я тренируюсь каждый день и чувствую себя сильным.", "tr": "Her gün egzersiz yapıyorum ve kendimi güçlü hissediyorum." }, "altNative": { "uz": ["Har kuni mashq qilaman va o'zimni kuchli his qilaman.", "Men har kuni mashq qilaman va o'zimni kuchli his qilyapman.", "Men har kuni sport bilan shug'ullanaman va o'zimni kuchli his qilaman."], "ru": ["Я тренируюсь каждый день и чувствую себя сильной.", "Я каждый день тренируюсь и чувствую себя сильным.", "Я каждый день тренируюсь и чувствую себя сильной.", "Я занимаюсь спортом каждый день и чувствую себя сильным.", "Я занимаюсь спортом каждый день и чувствую себя сильной."], "tr": ["Ben her gün egzersiz yapıyorum ve kendimi güçlü hissediyorum.", "Her gün spor yapıyorum ve kendimi güçlü hissediyorum.", "Her gün egzersiz yaparım ve kendimi güçlü hissederim."] } },
    { "id": "u16.s.32", "en": "You should sleep more and rest at home.", "native": { "uz": "Sen ko'proq uxlashing va uyda dam olishing kerak.", "ru": "Тебе следует больше спать и отдыхать дома.", "tr": "Daha fazla uyumalı ve evde dinlenmelisin." }, "altNative": { "uz": ["Ko'proq uxlashing va uyda dam olishing kerak.", "Sen ko'proq uxlab, uyda dam olishing kerak."], "ru": ["Тебе стоит больше спать и отдыхать дома.", "Тебе нужно больше спать и отдыхать дома.", "Тебе надо больше спать и отдыхать дома.", "Тебе следует больше спать и дома отдыхать."], "tr": ["Daha çok uyumalı ve evde dinlenmelisin.", "Sen daha fazla uyumalı ve evde dinlenmelisin.", "Daha fazla uyumalısın ve evde dinlenmelisin.", "Daha çok uyumalısın ve evde dinlenmelisin."] } },

    { "id": "u16.s.33", "en": "Is there a pharmacy near here?", "native": { "uz": "Shu yerga yaqin dorixona bormi?", "ru": "Здесь рядом есть аптека?", "tr": "Buraya yakın bir eczane var mı?" }, "altNative": { "uz": ["Bu yerga yaqin dorixona bormi?", "Shu atrofda dorixona bormi?", "Yaqin atrofda dorixona bormi?"], "ru": ["Здесь поблизости есть аптека?", "Рядом есть аптека?", "Тут рядом есть аптека?", "Есть ли здесь рядом аптека?", "Поблизости есть аптека?"], "tr": ["Buraya yakın eczane var mı?", "Bu yakınlarda bir eczane var mı?", "Yakınlarda bir eczane var mı?", "Buralarda bir eczane var mı?"] } },
    { "id": "u16.s.34", "en": "Do you have any medicine for a cough?", "native": { "uz": "Senda yo'tal uchun dori bormi?", "ru": "У тебя есть лекарство от кашля?", "tr": "Öksürük için ilacın var mı?" }, "altNative": { "uz": ["Yo'tal uchun dori bormi?", "Senda yo'talga qarshi dori bormi?", "Yo'talga qarshi dori bormi?", "Sizda yo'tal uchun dori bormi?", "Sizda yo'talga qarshi dori bormi?"], "ru": ["У тебя есть какое-нибудь лекарство от кашля?", "У тебя есть что-нибудь от кашля?", "Есть лекарство от кашля?", "У вас есть лекарство от кашля?"], "tr": ["Öksürük için bir ilacın var mı?", "Öksürük ilacın var mı?", "Sende öksürük ilacı var mı?", "Öksürük için ilacınız var mı?", "Öksürük için ilaç var mı?"] } },
    { "id": "u16.s.35", "en": "The pharmacy doesn't have this medicine.", "native": { "uz": "Dorixonada bu dori yo'q.", "ru": "В аптеке нет этого лекарства.", "tr": "Eczanede bu ilaç yok." }, "altNative": { "uz": ["Bu dori dorixonada yo'q.", "Dorixonada bu doridan yo'q."], "ru": ["Этого лекарства нет в аптеке.", "В аптеке этого лекарства нет."], "tr": ["Bu ilaç eczanede yok."] } },
    { "id": "u16.s.36", "en": "Take one pill after breakfast and dinner.", "native": { "uz": "Nonushta va kechki ovqatdan keyin bitta tabletka ich.", "ru": "Принимай по одной таблетке после завтрака и ужина.", "tr": "Kahvaltıdan ve akşam yemeğinden sonra bir hap al." }, "altNative": { "uz": ["Nonushtadan va kechki ovqatdan keyin bitta tabletka ich.", "Nonushta va kechki ovqatdan keyin bittadan tabletka ich.", "Nonushta va kechki ovqatdan so'ng bitta tabletka ich.", "Nonushta va kechki ovqatdan keyin bitta tabletka qabul qil."], "ru": ["Принимай одну таблетку после завтрака и ужина.", "Прими одну таблетку после завтрака и ужина.", "Пей по одной таблетке после завтрака и ужина.", "Принимай по одной таблетке после завтрака и после ужина."], "tr": ["Kahvaltı ve akşam yemeğinden sonra bir hap al.", "Kahvaltıdan ve akşam yemeğinden sonra bir hap iç.", "Kahvaltı ve akşam yemeğinden sonra bir hap iç.", "Kahvaltıdan ve akşam yemeğinden sonra bir tane hap al."] } },
    { "id": "u16.s.37", "en": "You should take these pills with water.", "native": { "uz": "Sen bu tabletkalarni suv bilan ichishing kerak.", "ru": "Тебе следует принимать эти таблетки с водой.", "tr": "Bu hapları suyla almalısın." }, "altNative": { "uz": ["Bu tabletkalarni suv bilan ichishing kerak.", "Sen bu tabletkalarni suv bilan qabul qilishing kerak.", "Bu tabletkalarni suv bilan qabul qilishing kerak."], "ru": ["Тебе стоит принимать эти таблетки с водой.", "Тебе нужно принимать эти таблетки с водой.", "Тебе надо принимать эти таблетки с водой.", "Тебе следует запивать эти таблетки водой.", "Тебе нужно запивать эти таблетки водой.", "Эти таблетки следует принимать с водой."], "tr": ["Bu hapları su ile almalısın.", "Sen bu hapları suyla almalısın.", "Bu hapları suyla içmelisin.", "Bu hapları su ile içmelisin."] } },
    { "id": "u16.s.38", "en": "Do you have a prescription from your doctor?", "native": { "uz": "Senda shifokoringdan retsept bormi?", "ru": "У тебя есть рецепт от врача?", "tr": "Doktorundan reçeten var mı?" }, "altNative": { "uz": ["Shifokoringdan retsept bormi?", "Senda shifokor retsepti bormi?", "Senda shifokordan retsept bormi?", "Senda shifokoringning retsepti bormi?", "Shifokoringning retsepti bormi?", "Sizda shifokoringizdan retsept bormi?"], "ru": ["У тебя есть рецепт от твоего врача?", "У тебя есть рецепт врача?", "Есть рецепт от врача?", "У вас есть рецепт от врача?"], "tr": ["Doktorundan bir reçeten var mı?", "Senin doktorundan reçeten var mı?", "Doktordan reçeten var mı?", "Doktorunun reçetesi var mı?"] } },
    { "id": "u16.s.39", "en": "This medicine will help you feel better.", "native": { "uz": "Bu dori o'zingni yaxshiroq his qilishingga yordam beradi.", "ru": "Это лекарство поможет тебе почувствовать себя лучше.", "tr": "Bu ilaç kendini daha iyi hissetmene yardım edecek." }, "altNative": { "uz": ["Bu dori senga o'zingni yaxshiroq his qilishga yordam beradi.", "Bu dori senga o'zingni yaxshiroq his qilishingga yordam beradi.", "Bu dori bilan o'zingni yaxshiroq his qilasan."], "ru": ["Это лекарство поможет тебе чувствовать себя лучше.", "С этим лекарством тебе станет лучше.", "От этого лекарства тебе станет лучше."], "tr": ["Bu ilaç kendini daha iyi hissetmene yardımcı olacak.", "Bu ilaç daha iyi hissetmene yardım edecek.", "Bu ilaç kendini daha iyi hissetmeni sağlayacak.", "Bu ilaç sana kendini daha iyi hissetmen için yardım edecek."] } },
    { "id": "u16.s.40", "en": "Take the medicine and get well soon!", "native": { "uz": "Dorini ich va tezroq sog'ayib ket!", "ru": "Принимай лекарство и выздоравливай!", "tr": "İlacını al, geçmiş olsun!" }, "altNative": { "uz": ["Dorini ich va tez sog'ayib ket!", "Dorini ich va tezroq tuzalib ket!", "Dorini qabul qil va tezroq sog'ayib ket!", "Dorini ichgin va tezroq sog'ayib ket!"], "ru": ["Прими лекарство и выздоравливай!", "Принимай лекарство и поправляйся!", "Прими лекарство и поправляйся!", "Принимай лекарство и скорее выздоравливай!", "Принимай лекарство и выздоравливай скорее!", "Прими лекарство и скорее выздоравливай!", "Пей лекарство и выздоравливай!"], "tr": ["İlacı al, geçmiş olsun!", "İlacını iç, geçmiş olsun!", "İlacı iç, geçmiş olsun!", "İlacını al ve çabuk iyileş!", "İlacı al ve çabuk iyileş!", "İlacı al ve geçmiş olsun!"] } }
