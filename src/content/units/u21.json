  "sentences": [
    { "id": "u21.s.01", "en": "Tell me about your hometown.", "native": { "uz": "Ona shahringiz haqida gapirib bering.", "ru": "Расскажите о вашем родном городе.", "tr": "Bana memleketinizden bahsedin." } },
    { "id": "u21.s.02", "en": "My hometown is Samarkand.", "native": { "uz": "Mening ona shahrim Samarqand.", "ru": "Мой родной город — Самарканд.", "tr": "Memleketim Semerkant." }, "altNative": { "uz": ["Ona shahrim Samarqand."], "tr": ["Benim memleketim Semerkant."] } },
    { "id": "u21.s.03", "en": "Can you describe your city?", "native": { "uz": "Shahringizni tasvirlay olasizmi?", "ru": "Можете описать ваш город?", "tr": "Şehrinizi tarif edebilir misiniz?" }, "altNative": { "ru": ["Вы можете описать ваш город?"] } },
    { "id": "u21.s.04", "en": "My hometown is quiet.", "native": { "uz": "Ona shahrim tinch.", "ru": "Мой родной город тихий.", "tr": "Memleketim sakin." }, "altNative": { "uz": ["Mening ona shahrim tinch."] } },
    { "id": "u21.s.05", "en": "What is your favorite subject?", "native": { "uz": "Sevimli faningiz qaysi?", "ru": "Какой ваш любимый предмет?", "tr": "Favori dersiniz hangisi?" }, "altNative": { "ru": ["Какой у вас любимый предмет?"] } },
    { "id": "u21.s.06", "en": "My favorite subject is English.", "native": { "uz": "Mening sevimli fanim ingliz tili.", "ru": "Мой любимый предмет — английский.", "tr": "Favori dersim İngilizce." }, "altNative": { "uz": ["Sevimli fanim ingliz tili."] } },
    { "id": "u21.s.07", "en": "This place is popular.", "native": { "uz": "Bu joy mashhur.", "ru": "Это место популярное.", "tr": "Bu yer popüler." } },
    { "id": "u21.s.08", "en": "It is a quiet and popular park.", "native": { "uz": "Bu tinch va mashhur park.", "ru": "Это тихий и популярный парк.", "tr": "Bu sakin ve popüler bir park." } },

    { "id": "u21.s.09", "en": "What do you think?", "native": { "uz": "Siz nima deb o'ylaysiz?", "ru": "Что вы думаете?", "tr": "Siz ne düşünüyorsunuz?" }, "altNative": { "uz": ["Nima deb o'ylaysiz?"], "tr": ["Ne düşünüyorsunuz?"] } },
    { "id": "u21.s.10", "en": "I think it is a good idea.", "native": { "uz": "Menimcha, bu yaxshi g'oya.", "ru": "Я думаю, это хорошая идея.", "tr": "Bence bu iyi bir fikir." } },
    { "id": "u21.s.11", "en": "In my opinion, books are important.", "native": { "uz": "Mening fikrimcha, kitoblar muhim.", "ru": "По моему мнению, книги важны.", "tr": "Benim görüşüme göre kitaplar önemli." } },
    { "id": "u21.s.12", "en": "I agree with you.", "native": { "uz": "Men sizga qo'shilaman.", "ru": "Я согласен с вами.", "tr": "Size katılıyorum." }, "altNative": { "ru": ["Я согласна с вами."] } },
    { "id": "u21.s.13", "en": "I do not agree.", "native": { "uz": "Men qo'shilmayman.", "ru": "Я не согласен.", "tr": "Katılmıyorum." }, "altNative": { "ru": ["Я не согласна."] } },
    { "id": "u21.s.14", "en": "I like my city because it is quiet.", "native": { "uz": "Menga shahrim yoqadi, chunki u tinch.", "ru": "Мне нравится мой город, потому что он тихий.", "tr": "Şehrimi seviyorum çünkü sakin." } },
    { "id": "u21.s.15", "en": "What is the reason?", "native": { "uz": "Sababi nima?", "ru": "В чём причина?", "tr": "Sebebi nedir?" } },
    { "id": "u21.s.16", "en": "There are two reasons.", "native": { "uz": "Ikkita sabab bor.", "ru": "Есть две причины.", "tr": "İki sebep var." } },

    { "id": "u21.s.17", "en": "I prefer tea.", "native": { "uz": "Men choyni afzal ko'raman.", "ru": "Я предпочитаю чай.", "tr": "Çayı tercih ederim." } },
    { "id": "u21.s.18", "en": "I prefer books to films.", "native": { "uz": "Men filmlardan ko'ra kitoblarni afzal ko'raman.", "ru": "Я предпочитаю книги фильмам.", "tr": "Kitapları filmlere tercih ederim." } },
    { "id": "u21.s.19", "en": "English is easy for me.", "native": { "uz": "Ingliz tili men uchun oson.", "ru": "Английский для меня лёгкий.", "tr": "İngilizce benim için kolay." } },
    { "id": "u21.s.20", "en": "Math is difficult.", "native": { "uz": "Matematika qiyin.", "ru": "Математика трудная.", "tr": "Matematik zor." }, "altNative": { "ru": ["Математика сложная."] } },
    { "id": "u21.s.21", "en": "This book is useful.", "native": { "uz": "Bu kitob foydali.", "ru": "Эта книга полезная.", "tr": "Bu kitap faydalı." } },
    { "id": "u21.s.22", "en": "The film is boring.", "native": { "uz": "Film zerikarli.", "ru": "Фильм скучный.", "tr": "Film sıkıcı." } },
    { "id": "u21.s.23", "en": "I think the city is better.", "native": { "uz": "Menimcha, shahar yaxshiroq.", "ru": "Я думаю, город лучше.", "tr": "Bence şehir daha iyi." } },
    { "id": "u21.s.24", "en": "It is useful but difficult.", "native": { "uz": "Bu foydali, lekin qiyin.", "ru": "Это полезно, но трудно.", "tr": "Bu faydalı ama zor." } },

    { "id": "u21.s.25", "en": "Can you give an example?", "native": { "uz": "Misol keltira olasizmi?", "ru": "Можете привести пример?", "tr": "Bir örnek verebilir misiniz?" } },
    { "id": "u21.s.26", "en": "For example, I read every day.", "native": { "uz": "Masalan, men har kuni o'qiyman.", "ru": "Например, я читаю каждый день.", "tr": "Örneğin, her gün okurum." } },
    { "id": "u21.s.27", "en": "I often read books.", "native": { "uz": "Men tez-tez kitob o'qiyman.", "ru": "Я часто читаю книги.", "tr": "Sık sık kitap okurum." } },
    { "id": "u21.s.28", "en": "Sometimes I watch films.", "native": { "uz": "Ba'zan film ko'raman.", "ru": "Иногда я смотрю фильмы.", "tr": "Bazen film izlerim." }, "altEn": ["I sometimes watch films."] },
    { "id": "u21.s.29", "en": "I usually study at home.", "native": { "uz": "Men odatda uyda dars qilaman.", "ru": "Обычно я занимаюсь дома.", "tr": "Genellikle evde ders çalışırım." } },
    { "id": "u21.s.30", "en": "I never study at night.", "native": { "uz": "Men hech qachon kechasi dars qilmayman.", "ru": "Я никогда не занимаюсь ночью.", "tr": "Geceleri asla ders çalışmam." } },
    { "id": "u21.s.31", "en": "This is a good example.", "native": { "uz": "Bu yaxshi misol.", "ru": "Это хороший пример.", "tr": "Bu iyi bir örnek." } },
    { "id": "u21.s.32", "en": "I usually drink tea.", "native": { "uz": "Men odatda choy ichaman.", "ru": "Обычно я пью чай.", "tr": "Genellikle çay içerim." } },

    { "id": "u21.s.33", "en": "The examiner is friendly.", "native": { "uz": "Imtihon oluvchi samimiy.", "ru": "Экзаменатор дружелюбный.", "tr": "Sınav görevlisi güler yüzlü." } },
    { "id": "u21.s.34", "en": "Can you repeat the question, please?", "native": { "uz": "Savolni takrorlay olasizmi, iltimos?", "ru": "Можете повторить вопрос, пожалуйста?", "tr": "Soruyu tekrarlar mısınız, lütfen?" } },
    { "id": "u21.s.35", "en": "I do not understand the question.", "native": { "uz": "Men savolni tushunmayapman.", "ru": "Я не понимаю вопрос.", "tr": "Soruyu anlamıyorum." } },
    { "id": "u21.s.36", "en": "Please speak slowly.", "native": { "uz": "Iltimos, sekin gapiring.", "ru": "Пожалуйста, говорите медленно.", "tr": "Lütfen yavaş konuşun." } },
    { "id": "u21.s.37", "en": "What is the topic?", "native": { "uz": "Mavzu nima?", "ru": "Какая тема?", "tr": "Konu nedir?" } },
    { "id": "u21.s.38", "en": "The topic is my family.", "native": { "uz": "Mavzu mening oilam.", "ru": "Тема — моя семья.", "tr": "Konu benim ailem." } },
    { "id": "u21.s.39", "en": "I want a good score.", "native": { "uz": "Men yaxshi ball xohlayman.", "ru": "Я хочу хороший балл.", "tr": "İyi bir puan istiyorum." } },
    { "id": "u21.s.40", "en": "Now I understand.", "native": { "uz": "Endi tushunyapman.", "ru": "Теперь я понимаю.", "tr": "Şimdi anlıyorum." } }
  ],
