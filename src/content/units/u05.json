  "sentences": [
    { "id": "u05.s.01", "en": "One, two, three!", "native": { "uz": "Bir, ikki, uch!", "ru": "Один, два, три!", "tr": "Bir, iki, üç!" }, "altNative": { "ru": ["Раз, два, три!"] } },
    { "id": "u05.s.02", "en": "I have one brother.", "native": { "uz": "Mening bitta akam bor.", "ru": "У меня один брат.", "tr": "Bir erkek kardeşim var." }, "altEnFor": { "tr": ["I have a brother."] }, "altNative": { "uz": ["Mening bitta ukam bor.", "Bitta akam bor.", "Bitta ukam bor.", "Mening bir akam bor."], "ru": ["У меня есть один брат."], "tr": ["Benim bir erkek kardeşim var.", "Bir tane erkek kardeşim var.", "Bir abim var."] } },
    { "id": "u05.s.03", "en": "I have two sisters.", "native": { "uz": "Mening ikkita opam bor.", "ru": "У меня две сестры.", "tr": "İki kız kardeşim var." }, "altNative": { "uz": ["Mening ikkita singlim bor.", "Ikkita opam bor.", "Ikkita singlim bor.", "Mening ikki opam bor."], "ru": ["У меня есть две сестры."], "tr": ["Benim iki kız kardeşim var.", "İki ablam var."] } },
    { "id": "u05.s.04", "en": "Count to three.", "native": { "uz": "Uchgacha sana.", "ru": "Посчитай до трёх.", "tr": "Üçe kadar say." }, "altNative": { "ru": ["Считай до трёх.", "Сосчитай до трёх."] } },
    { "id": "u05.s.05", "en": "Is this your book?", "native": { "uz": "Bu sening kitobingmi?", "ru": "Это твоя книга?", "tr": "Bu senin kitabın mı?" }, "altNative": { "uz": ["Bu kitobingmi?"], "tr": ["Bu kitabın mı?"] } },
    { "id": "u05.s.06", "en": "This is not my book.", "native": { "uz": "Bu mening kitobim emas.", "ru": "Это не моя книга.", "tr": "Bu benim kitabım değil." }, "altNative": { "uz": ["Bu kitobim emas."], "tr": ["Bu kitabım değil."] } },
    { "id": "u05.s.07", "en": "What is your number?", "native": { "uz": "Sening raqaming qanday?", "ru": "Какой у тебя номер?", "tr": "Numaran kaç?" }, "altNative": { "uz": ["Raqaming qanday?", "Sening raqaming nechchi?", "Raqaming nechchi?", "Sening raqaming nima?"], "ru": ["Какой твой номер?"], "tr": ["Senin numaran kaç?", "Numaran ne?", "Senin numaran ne?"] } },
    { "id": "u05.s.08", "en": "Two coffees, please.", "native": { "uz": "Ikkita qahva, iltimos.", "ru": "Два кофе, пожалуйста.", "tr": "İki kahve, lütfen." }, "altNative": { "uz": ["Iltimos, ikkita qahva.", "Ikki qahva, iltimos."], "ru": ["Пожалуйста, два кофе."], "tr": ["Lütfen, iki kahve."] } },

    { "id": "u05.s.09", "en": "We have four children.", "native": { "uz": "Bizning to'rtta bolamiz bor.", "ru": "У нас четверо детей.", "tr": "Dört çocuğumuz var." }, "altNative": { "uz": ["Bizning to'rtta farzandimiz bor.", "To'rtta bolamiz bor.", "Bizning to'rt bolamiz bor."], "ru": ["У нас четыре ребёнка.", "У нас есть четверо детей."], "tr": ["Bizim dört çocuğumuz var."] } },
    { "id": "u05.s.10", "en": "I have five books.", "native": { "uz": "Menda beshta kitob bor.", "ru": "У меня пять книг.", "tr": "Beş kitabım var." }, "altNative": { "uz": ["Mening beshta kitobim bor.", "Beshta kitobim bor.", "Menda besh kitob bor."], "ru": ["У меня есть пять книг."], "tr": ["Benim beş kitabım var."] } },
    { "id": "u05.s.11", "en": "The teacher has six students.", "native": { "uz": "O'qituvchining oltita talabasi bor.", "ru": "У учителя шесть студентов.", "tr": "Öğretmenin altı öğrencisi var." }, "altNative": { "uz": ["O'qituvchining olti talabasi bor.", "O'qituvchida oltita talaba bor."], "ru": ["У учителя шесть учеников.", "У учительницы шесть студентов."] } },
    { "id": "u05.s.12", "en": "Seven, eight, nine, ten!", "native": { "uz": "Yetti, sakkiz, to'qqiz, o'n!", "ru": "Семь, восемь, девять, десять!", "tr": "Yedi, sekiz, dokuz, on!" } },
    { "id": "u05.s.13", "en": "Not seven, eight!", "altEn": ["Not seven, but eight!"], "native": { "uz": "Yetti emas, sakkiz!", "ru": "Не семь, а восемь!", "tr": "Yedi değil, sekiz!" }, "altNative": { "uz": ["Yettita emas, sakkizta!"], "ru": ["Не семь, восемь!"] } },
    { "id": "u05.s.14", "en": "There are nine people here.", "altEn": ["Nine people are here."], "native": { "uz": "Shu yerda to'qqizta odam bor.", "ru": "Здесь девять человек.", "tr": "Burada dokuz kişi var." }, "altNative": { "uz": ["Bu yerda to'qqizta odam bor.", "Shu yerda to'qqiz kishi bor.", "Bu yerda to'qqiz kishi bor.", "Shu yerda to'qqiz odam bor."], "ru": ["Тут девять человек."], "tr": ["Burada dokuz insan var."] } },
    { "id": "u05.s.15", "en": "Count to ten, please.", "native": { "uz": "O'ngacha sana, iltimos.", "ru": "Посчитай до десяти, пожалуйста.", "tr": "Ona kadar say, lütfen." }, "altNative": { "uz": ["Iltimos, o'ngacha sana."], "ru": ["Считай до десяти, пожалуйста.", "Сосчитай до десяти, пожалуйста.", "Пожалуйста, посчитай до десяти."], "tr": ["Lütfen ona kadar say."] } },
    { "id": "u05.s.16", "en": "Do you have six eggs?", "native": { "uz": "Senda oltita tuxum bormi?", "ru": "У тебя есть шесть яиц?", "tr": "Altı yumurtan var mı?" }, "altNative": { "uz": ["Sening oltita tuxuming bormi?", "Oltita tuxuming bormi?", "Senda olti tuxum bormi?"], "tr": ["Senin altı yumurtan var mı?", "Sende altı yumurta var mı?"] } },

    { "id": "u05.s.17", "en": "How old are you?", "native": { "uz": "Sen necha yoshdasan?", "ru": "Сколько тебе лет?", "tr": "Kaç yaşındasın?" }, "altNative": { "uz": ["Necha yoshdasan?", "Yoshing nechada?", "Sening yoshing nechada?"], "ru": ["Тебе сколько лет?"], "tr": ["Sen kaç yaşındasın?"] } },
    { "id": "u05.s.18", "en": "I am ten years old.", "altEn": ["I am ten."], "native": { "uz": "Men o'n yoshdaman.", "ru": "Мне десять лет.", "tr": "Ben on yaşındayım." }, "altNative": { "uz": ["O'n yoshdaman.", "Mening yoshim o'nda."], "tr": ["On yaşındayım."] } },
    { "id": "u05.s.19", "en": "How old is your daughter?", "native": { "uz": "Sening qizing necha yoshda?", "ru": "Сколько лет твоей дочери?", "tr": "Kızın kaç yaşında?" }, "altNative": { "uz": ["Qizing necha yoshda?", "Qizingning yoshi nechada?"], "ru": ["Сколько лет твоей дочке?", "Сколько твоей дочери лет?"], "tr": ["Senin kızın kaç yaşında?"] } },
    { "id": "u05.s.20", "en": "My daughter is only one year old.", "altEn": ["My daughter is only a year old.", "My daughter is only one."], "native": { "uz": "Mening qizim faqat bir yoshda.", "ru": "Моей дочери всего один год.", "tr": "Kızım sadece bir yaşında." }, "altNative": { "uz": ["Qizim faqat bir yoshda.", "Mening qizim atigi bir yoshda.", "Mening qizim endigina bir yoshda."], "ru": ["Моей дочери только один год.", "Моей дочке всего один год.", "Моей дочери всего год.", "Моей дочке всего год."], "tr": ["Benim kızım sadece bir yaşında.", "Kızım daha bir yaşında."] } },
    { "id": "u05.s.21", "en": "My baby is six months old.", "native": { "uz": "Mening chaqalog'im olti oylik.", "ru": "Моему малышу шесть месяцев.", "tr": "Bebeğim altı aylık." }, "altNative": { "uz": ["Chaqalog'im olti oylik.", "Mening bolam olti oylik."], "ru": ["Моему ребёнку шесть месяцев."], "tr": ["Benim bebeğim altı aylık."] } },
    { "id": "u05.s.22", "en": "Today is my birthday.", "altEn": ["It is my birthday today.", "My birthday is today."], "native": { "uz": "Bugun mening tug'ilgan kunim.", "ru": "Сегодня мой день рождения.", "tr": "Bugün benim doğum günüm." }, "altNative": { "uz": ["Bugun tug'ilgan kunim."], "ru": ["У меня сегодня день рождения.", "Сегодня у меня день рождения."], "tr": ["Bugün doğum günüm."] } },
    { "id": "u05.s.23", "en": "Happy birthday, Madina!", "native": { "uz": "Tug'ilgan kuning bilan, Madina!", "ru": "С днём рождения, Мадина!", "tr": "Doğum günün kutlu olsun, Madina!" }, "altNative": { "uz": ["Tug'ilgan kuning muborak, Madina!", "Madina, tug'ilgan kuning bilan!"], "ru": ["Мадина, с днём рождения!"], "tr": ["İyi ki doğdun, Madina!", "Mutlu yıllar, Madina!", "Madina, doğum günün kutlu olsun!"] } },
    { "id": "u05.s.24", "en": "Age is only a number.", "native": { "uz": "Yosh — bu faqat raqam.", "ru": "Возраст — это только цифра.", "tr": "Yaş sadece bir sayı." }, "altNative": { "uz": ["Yosh faqat raqam.", "Yosh bu shunchaki raqam."], "ru": ["Возраст — это всего лишь цифра.", "Возраст — это просто число.", "Возраст — это только число.", "Возраст — только цифра."], "tr": ["Yaş sadece bir sayıdır.", "Yaş sadece bir rakam.", "Yaş sadece bir numara."] } },

    { "id": "u05.s.25", "en": "How many brothers do you have?", "native": { "uz": "Sening nechta akang bor?", "ru": "Сколько у тебя братьев?", "tr": "Kaç erkek kardeşin var?" }, "altNative": { "uz": ["Nechta akang bor?", "Sening nechta ukang bor?", "Nechta ukang bor?", "Sening nechta aka-ukang bor?", "Nechta aka-ukang bor?"], "ru": ["У тебя сколько братьев?"], "tr": ["Senin kaç erkek kardeşin var?", "Kaç tane erkek kardeşin var?", "Kaç abin var?"] } },
    { "id": "u05.s.26", "en": "I have four brothers and two sisters.", "native": { "uz": "Mening to'rtta akam va ikkita opam bor.", "ru": "У меня четыре брата и две сестры.", "tr": "Dört erkek kardeşim ve iki kız kardeşim var." }, "altNative": { "uz": ["Mening to'rtta ukam va ikkita singlim bor.", "Mening to'rtta akam va ikkita singlim bor.", "Mening to'rtta ukam va ikkita opam bor.", "To'rtta akam va ikkita opam bor."], "ru": ["У меня есть четыре брата и две сестры."], "tr": ["Benim dört erkek kardeşim ve iki kız kardeşim var.", "Dört abim ve iki ablam var."] } },
    { "id": "u05.s.27", "en": "How many people live here?", "native": { "uz": "Shu yerda nechta odam yashaydi?", "ru": "Сколько людей здесь живёт?", "tr": "Burada kaç kişi yaşıyor?" }, "altNative": { "uz": ["Bu yerda nechta odam yashaydi?", "Shu yerda necha kishi yashaydi?", "Bu yerda necha kishi yashaydi?"], "ru": ["Сколько человек здесь живёт?", "Сколько людей живёт здесь?", "Сколько человек живёт здесь?", "Сколько людей тут живёт?"], "tr": ["Burada kaç insan yaşıyor?", "Burada kaç tane insan yaşıyor?"] } },
    { "id": "u05.s.28", "en": "I do not have many books.", "native": { "uz": "Menda ko'p kitob yo'q.", "ru": "У меня не так много книг.", "tr": "Çok kitabım yok." }, "altNative": { "uz": ["Mening kitobim ko'p emas.", "Kitoblarim ko'p emas.", "Mening ko'p kitobim yo'q."], "ru": ["У меня немного книг.", "У меня не много книг.", "У меня мало книг."], "tr": ["Benim çok kitabım yok.", "Fazla kitabım yok.", "Pek kitabım yok."] } },
    { "id": "u05.s.29", "en": "What is your phone number?", "native": { "uz": "Sening telefon raqaming qanday?", "ru": "Какой у тебя номер телефона?", "tr": "Telefon numaran kaç?" }, "altNative": { "uz": ["Telefon raqaming qanday?", "Sening telefon raqaming nechchi?", "Telefon raqaming nechchi?", "Sening telefon raqaming nima?"], "ru": ["Какой твой номер телефона?"], "tr": ["Senin telefon numaran kaç?", "Telefon numaran ne?", "Senin telefon numaran ne?"] } },
    { "id": "u05.s.30", "en": "Do you want more tea?", "native": { "uz": "Yana choy xohlaysanmi?", "ru": "Хочешь ещё чая?", "tr": "Biraz daha çay ister misin?" }, "altNative": { "uz": ["Sen yana choy xohlaysanmi?", "Ko'proq choy xohlaysanmi?", "Yana choy ichasanmi?"], "ru": ["Ты хочешь ещё чая?", "Хочешь ещё чаю?", "Ты хочешь ещё чаю?", "Ты хочешь больше чая?"], "tr": ["Daha çay ister misin?", "Daha fazla çay ister misin?", "Daha çok çay ister misin?", "Sen biraz daha çay ister misin?"] } },
    { "id": "u05.s.31", "en": "All my friends are here.", "altEn": ["All of my friends are here."], "native": { "uz": "Hamma do'stlarim shu yerda.", "ru": "Все мои друзья здесь.", "tr": "Bütün arkadaşlarım burada." }, "altNative": { "uz": ["Mening hamma do'stlarim shu yerda.", "Barcha do'stlarim shu yerda.", "Hamma do'stlarim bu yerda.", "Do'stlarimning hammasi shu yerda."], "ru": ["Все мои друзья тут.", "Здесь все мои друзья."], "tr": ["Tüm arkadaşlarım burada.", "Arkadaşlarımın hepsi burada.", "Benim bütün arkadaşlarım burada."] } },
    { "id": "u05.s.32", "en": "This is my first English book.", "native": { "uz": "Bu mening birinchi inglizcha kitobim.", "ru": "Это моя первая английская книга.", "tr": "Bu benim ilk İngilizce kitabım." }, "altNative": { "uz": ["Bu mening birinchi ingliz tili kitobim.", "Bu birinchi inglizcha kitobim.", "Bu mening ingliz tilidagi birinchi kitobim."], "ru": ["Это моя первая книга на английском."], "tr": ["Bu ilk İngilizce kitabım.", "Bu benim birinci İngilizce kitabım."] } },

    { "id": "u05.s.33", "en": "I am twenty years old.", "altEn": ["I am twenty."], "native": { "uz": "Men yigirma yoshdaman.", "ru": "Мне двадцать лет.", "tr": "Ben yirmi yaşındayım." }, "altNative": { "uz": ["Yigirma yoshdaman.", "Mening yoshim yigirmada."], "tr": ["Yirmi yaşındayım."] } },
    { "id": "u05.s.34", "en": "My sister is fifteen years old.", "altEn": ["My sister is fifteen."], "native": { "uz": "Mening opam o'n besh yoshda.", "ru": "Моей сестре пятнадцать лет.", "tr": "Kız kardeşim on beş yaşında." }, "altNative": { "uz": ["Mening singlim o'n besh yoshda.", "Opam o'n besh yoshda.", "Singlim o'n besh yoshda."], "tr": ["Benim kız kardeşim on beş yaşında.", "Ablam on beş yaşında."] } },
    { "id": "u05.s.35", "en": "I am not eleven, I am twelve!", "native": { "uz": "Men o'n bir emas, o'n ikki yoshdaman!", "ru": "Мне не одиннадцать, а двенадцать!", "tr": "Ben on bir değil, on iki yaşındayım!" }, "altNative": { "uz": ["O'n bir emas, o'n ikki yoshdaman!", "Men o'n birda emas, o'n ikkidaman!"], "ru": ["Мне не одиннадцать, мне двенадцать!", "Мне не одиннадцать лет, а двенадцать!"], "tr": ["On bir değil, on iki yaşındayım!", "Ben on bir yaşında değilim, on iki yaşındayım!"] } },
    { "id": "u05.s.36", "en": "There are twelve months in a year.", "altEn": ["A year has twelve months."], "native": { "uz": "Bir yilda o'n ikki oy bor.", "ru": "В году двенадцать месяцев.", "tr": "Bir yılda on iki ay var." }, "altNative": { "uz": ["Yilda o'n ikki oy bor.", "Bir yilda o'n ikkita oy bor."], "ru": ["В одном году двенадцать месяцев."], "tr": ["Bir yılda on iki ay vardır.", "Yılda on iki ay var."] } },
    { "id": "u05.s.37", "en": "Can you count to twenty?", "native": { "uz": "Yigirmagacha sanay olasanmi?", "ru": "Ты умеешь считать до двадцати?", "tr": "Yirmiye kadar sayabilir misin?" }, "altNative": { "uz": ["Sen yigirmagacha sanay olasanmi?", "Yigirmagacha sanashni bilasanmi?"], "ru": ["Умеешь считать до двадцати?", "Ты можешь считать до двадцати?", "Ты можешь посчитать до двадцати?", "Можешь посчитать до двадцати?"], "tr": ["Sen yirmiye kadar sayabilir misin?", "Yirmiye kadar saymayı biliyor musun?"] } },
    { "id": "u05.s.38", "en": "Do you have my new phone number?", "native": { "uz": "Senda mening yangi telefon raqamim bormi?", "ru": "У тебя есть мой новый номер телефона?", "tr": "Sende yeni telefon numaram var mı?" }, "altNative": { "uz": ["Senda yangi telefon raqamim bormi?", "Mening yangi telefon raqamim senda bormi?"], "ru": ["У тебя есть мой новый номер?", "Мой новый номер телефона у тебя есть?"], "tr": ["Yeni telefon numaram sende var mı?", "Sende benim yeni telefon numaram var mı?"] } },
    { "id": "u05.s.39", "en": "This is the last week of the month.", "altEn": ["It is the last week of the month."], "native": { "uz": "Bu oyning oxirgi haftasi.", "ru": "Это последняя неделя месяца.", "tr": "Bu ayın son haftası." }, "altNative": { "uz": ["Bu oyning so'nggi haftasi."], "tr": ["Bu, ayın son haftasıdır."] } },
    { "id": "u05.s.40", "en": "Only eleven people are here today.", "altEn": ["There are only eleven people here today."], "native": { "uz": "Bugun shu yerda faqat o'n bitta odam bor.", "ru": "Сегодня здесь только одиннадцать человек.", "tr": "Bugün burada sadece on bir kişi var." }, "altNative": { "uz": ["Bugun bu yerda faqat o'n bitta odam bor.", "Bugun shu yerda faqat o'n bir kishi bor.", "Bugun bu yerda faqat o'n bir kishi bor."], "ru": ["Сегодня здесь всего одиннадцать человек.", "Здесь сегодня только одиннадцать человек.", "Сегодня тут только одиннадцать человек."], "tr": ["Bugün burada yalnızca on bir kişi var.", "Burada bugün sadece on bir kişi var."] } }
