  "sentences": [
    { "id": "u06.s.01", "en": "It is red.", "native": { "uz": "U qizil.", "ru": "Оно красное.", "tr": "O kırmızı." }, "altNative": { "uz": ["Qizil."], "ru": ["Он красный.", "Она красная.", "Это красное."], "tr": ["Kırmızı."] } },
