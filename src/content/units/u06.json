    { "id": "u06.s.29", "en": "The table is not clean.", "native": { "uz": "Stol toza emas.", "ru": "Стол не чистый.", "tr": "Masa temiz değil." } },
    { "id": "u06.s.30", "en": "Red is my favorite color.", "altEn": ["Red is my favourite colour.", "My favorite color is red.", "My favourite colour is red."], "native": { "uz": "Qizil mening sevimli rangim.", "ru": "Красный — мой любимый цвет.", "tr": "Kırmızı benim en sevdiğim renk." }, "altNative": { "uz": ["Mening sevimli rangim qizil.", "Qizil sevimli rangim.", "Sevimli rangim qizil."], "ru": ["Мой любимый цвет — красный."], "tr": ["Kırmızı en sevdiğim renk.", "En sevdiğim renk kırmızı.", "Benim en sevdiğim renk kırmızı.", "Kırmızı benim favori rengim.", "Favori rengim kırmızı."] } },
    { "id": "u06.s.31", "en": "What is your favorite color?", "altEn": ["What is your favourite colour?"], "native": { "uz": "Sening sevimli ranging qaysi?", "ru": "Какой твой любимый цвет?", "tr": "En sevdiğin renk ne?" }, "altNative": { "uz": ["Sevimli ranging qaysi?", "Sening sevimli ranging nima?", "Sening sevimli ranging qanday?", "Sevimli ranging qanday?"], "ru": ["Какой у тебя любимый цвет?", "Твой любимый цвет какой?"], "tr": ["Senin en sevdiğin renk ne?", "En sevdiğin renk hangisi?", "Favori rengin ne?", "Senin favori rengin ne?"] } },
    { "id": "u06.s.32", "en": "These chairs are old but clean.", "native": { "uz": "Bu stullar eski, lekin toza.", "ru": "Эти стулья старые, но чистые.", "tr": "Bu sandalyeler eski ama temiz." }, "altNative": { "uz": ["Bu stullar eski, ammo toza.", "Bu stullar eski, biroq toza."], "tr": ["Bu sandalyeler eski fakat temiz.", "Bu sandalyeler eski ancak temiz."] } },

    { "id": "u06.s.33", "en": "Where is my wallet?", "native": { "uz": "Mening hamyonim qayerda?", "ru": "Где мой кошелёк?", "tr": "Cüzdanım nerede?" }, "altNative": { "uz": ["Hamyonim qayerda?", "Qayerda mening hamyonim?"], "ru": ["Где мой бумажник?", "Мой кошелёк где?"], "tr": ["Benim cüzdanım nerede?", "Nerede cüzdanım?"] } },
    { "id": "u06.s.34", "en": "It is under the table.", "native": { "uz": "U stolning ostida.", "ru": "Оно под столом.", "tr": "O masanın altında." }, "altNative": { "uz": ["U stol ostida.", "U stolning tagida.", "U stol tagida.", "Stolning ostida."], "ru": ["Он под столом.", "Она под столом.", "Это под столом.", "Под столом."], "tr": ["Masanın altında."] } },
    { "id": "u06.s.35", "en": "I can't find my glasses.", "native": { "uz": "Men ko'zoynagimni topa olmayapman.", "ru": "Я не могу найти свои очки.", "tr": "Gözlüğümü bulamıyorum." }, "altNative": { "uz": ["Ko'zoynagimni topa olmayapman.", "Men ko'zoynagimni topolmayapman.", "Ko'zoynagimni topolmayapman.", "Men ko'zoynagimni topa olmayman."], "ru": ["Я не могу найти мои очки.", "Я не могу найти очки.", "Не могу найти свои очки.", "Не могу найти очки."], "tr": ["Ben gözlüğümü bulamıyorum.", "Gözlüklerimi bulamıyorum.", "Ben gözlüklerimi bulamıyorum."] } },
    { "id": "u06.s.36", "en": "Look, your keys are on the table.", "native": { "uz": "Qara, kalitlaring stolda.", "ru": "Смотри, твои ключи на столе.", "tr": "Bak, anahtarların masada." }, "altNative": { "uz": ["Qara, sening kalitlaring stolda.", "Qara, kalitlaring stolning ustida.", "Qara, sening kalitlaring stolning ustida.", "Qara, kalitlaring stol ustida."], "ru": ["Посмотри, твои ключи на столе.", "Смотри, твои ключи лежат на столе."], "tr": ["Bak, senin anahtarların masada.", "Bak, anahtarların masanın üstünde.", "Bak, anahtarların masanın üzerinde."] } },
    { "id": "u06.s.37", "en": "Your phone is in that box.", "native": { "uz": "Sening telefoning anavi qutida.", "ru": "Твой телефон в той коробке.", "tr": "Senin telefonun şu kutuda." }, "altNative": { "uz": ["Telefoning anavi qutida.", "Sening telefoning o'sha qutida.", "Telefoning o'sha qutida.", "Sening telefoning u qutida.", "Telefoning u qutida.", "Telefoning anavi qutining ichida."], "tr": ["Telefonun şu kutuda.", "Senin telefonun o kutuda.", "Telefonun o kutuda.", "Telefonun şu kutunun içinde."] } },
    { "id": "u06.s.38", "en": "Are my glasses in your room?", "native": { "uz": "Mening ko'zoynagim sening xonangdami?", "ru": "Мои очки в твоей комнате?", "tr": "Gözlüğüm senin odanda mı?" }, "altNative": { "uz": ["Ko'zoynagim sening xonangdami?", "Ko'zoynagim xonangdami?", "Mening ko'zoynagim xonangdami?"], "ru": ["Мои очки у тебя в комнате?"], "tr": ["Gözlüğüm odanda mı?", "Benim gözlüğüm senin odanda mı?", "Benim gözlüğüm odanda mı?", "Gözlüklerim senin odanda mı?", "Gözlüklerim odanda mı?"] } },
    { "id": "u06.s.39", "en": "There is a beautiful picture in my room.", "altEn": ["In my room there is a beautiful picture."], "native": { "uz": "Mening xonamda chiroyli rasm bor.", "ru": "В моей комнате есть красивая картина.", "tr": "Odamda güzel bir resim var." }, "altNative": { "uz": ["Xonamda chiroyli rasm bor.", "Xonamda bitta chiroyli rasm bor.", "Mening xonamda chiroyli surat bor."], "ru": ["В моей комнате красивая картина.", "У меня в комнате есть красивая картина.", "У меня в комнате красивая картина.", "В моей комнате висит красивая картина."], "tr": ["Benim odamda güzel bir resim var.", "Odamda güzel bir tablo var."] } },
    { "id": "u06.s.40", "en": "Look under the chair, please.", "altEn": ["Please look under the chair."], "native": { "uz": "Stulning ostiga qara, iltimos.", "ru": "Посмотри под стулом, пожалуйста.", "tr": "Sandalyenin altına bak, lütfen." }, "altNative": { "uz": ["Iltimos, stulning ostiga qara.", "Stul ostiga qara, iltimos.", "Iltimos, stul ostiga qara.", "Stulning tagiga qara, iltimos.", "Iltimos, stulning tagiga qara."], "ru": ["Пожалуйста, посмотри под стулом.", "Посмотри под стул, пожалуйста.", "Пожалуйста, посмотри под стул."], "tr": ["Lütfen sandalyenin altına bak."] } }
