    { "id": "u06.s.15", "en": "I don't have a car.", "altEn": ["I have no car."], "native": { "uz": "Menda mashina yo'q.", "ru": "У меня нет машины.", "tr": "Arabam yok." }, "altNative": { "uz": ["Mening mashinam yo'q.", "Mashinam yo'q."], "ru": ["Машины у меня нет."], "tr": ["Benim arabam yok.", "Bir arabam yok.", "Benim bir arabam yok."] } },
