    { "id": "u06.s.22", "en": "Those houses are very big.", "native": { "uz": "Anavi uylar juda katta.", "ru": "Те дома очень большие.", "tr": "Şu evler çok büyük." }, "altNative": { "uz": ["U uylar juda katta.", "Ana u uylar juda katta.", "O'sha uylar juda katta."], "tr": ["O evler çok büyük."] } },
