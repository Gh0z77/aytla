    { "id": "u06.s.03", "en": "My phone is black.", "native": { "uz": "Mening telefonim qora.", "ru": "Мой телефон чёрный.", "tr": "Benim telefonum siyah." }, "altNative": { "uz": ["Telefonim qora."], "tr": ["Telefonum siyah."] } },
    { "id": "u06.s.04", "en": "What color is it?", "altEn": ["What colour is it?"], "native": { "uz": "U qanday rangda?", "ru": "Какого оно цвета?", "tr": "O ne renk?" }, "altNative": { "uz": ["Uning rangi qanday?", "U qaysi rangda?", "Uning rangi qanaqa?", "Qanday rangda?", "Rangi qanday?"], "ru": ["Какого он цвета?", "Какого она цвета?", "Какого это цвета?", "Какой это цвет?", "Какого цвета?", "Оно какого цвета?"], "tr": ["Ne renk?", "Onun rengi ne?", "Rengi ne?"] } },
    { "id": "u06.s.05", "en": "It is not blue.", "native": { "uz": "U ko'k emas.", "ru": "Оно не синее.", "tr": "O mavi değil." }, "altNative": { "uz": ["U moviy emas.", "Ko'k emas."], "ru": ["Он не синий.", "Она не синяя.", "Это не синее.", "Оно не голубое.", "Он не голубой.", "Она не голубая."], "tr": ["Mavi değil."] } },
    { "id": "u06.s.06", "en": "The milk is white.", "altEn": ["Milk is white."], "native": { "uz": "Sut oq.", "ru": "Молоко белое.", "tr": "Süt beyaz." } },
    { "id": "u06.s.07", "en": "Is your cup yellow?", "native": { "uz": "Sening chashkang sariqmi?", "ru": "Твоя чашка жёлтая?", "tr": "Senin fincanın sarı mı?" }, "altNative": { "uz": ["Chashkang sariqmi?", "Sening piyolang sariqmi?", "Piyolang sariqmi?", "Sening finjoning sariqmi?", "Finjoning sariqmi?"], "tr": ["Fincanın sarı mı?"] } },
    { "id": "u06.s.08", "en": "I like red and blue.", "native": { "uz": "Men qizil va ko'kni yoqtiraman.", "ru": "Мне нравятся красный и синий.", "tr": "Ben kırmızıyı ve maviyi severim." }, "altNative": { "uz": ["Menga qizil va ko'k yoqadi.", "Men qizil va ko'k rangni yoqtiraman.", "Qizil va ko'kni yoqtiraman."], "ru": ["Я люблю красный и синий.", "Мне нравится красный и синий."], "tr": ["Kırmızıyı ve maviyi severim.", "Ben kırmızı ve maviyi severim.", "Kırmızı ve maviyi severim.", "Kırmızıyı ve maviyi seviyorum.", "Ben kırmızıyı ve maviyi seviyorum."] } },

