  "sentences": [
    { "id": "u22.s.01", "en": "Hey, how's it going?", "native": { "uz": "Salom, ishlar qalay?", "ru": "Привет, как дела?", "tr": "Selam, nasıl gidiyor?" }, "altEn": ["Hey, how is it going?"] },
    { "id": "u22.s.02", "en": "Pretty good, thanks.", "native": { "uz": "Ancha yaxshi, rahmat.", "ru": "Довольно хорошо, спасибо.", "tr": "Oldukça iyi, teşekkürler." } },
    { "id": "u22.s.03", "en": "I am busy today.", "native": { "uz": "Men bugun bandman.", "ru": "Я сегодня занят.", "tr": "Bugün meşgulüm." }, "altNative": { "ru": ["Я сегодня занята.", "Сегодня я занят.", "Сегодня я занята."] } },
    { "id": "u22.s.04", "en": "I am a little tired.", "native": { "uz": "Men biroz charchaganman.", "ru": "Я немного устал.", "tr": "Biraz yorgunum." }, "altNative": { "uz": ["Men biroz charchadim."], "ru": ["Я немного устала."] } },
    { "id": "u22.s.05", "en": "What is the news?", "native": { "uz": "Qanday yangilik bor?", "ru": "Какие новости?", "tr": "Ne haber?" } },
    { "id": "u22.s.06", "en": "I have great news.", "native": { "uz": "Menda ajoyib yangilik bor.", "ru": "У меня отличная новость.", "tr": "Harika bir haberim var." } },
    { "id": "u22.s.07", "en": "That is great!", "native": { "uz": "Bu ajoyib!", "ru": "Это отлично!", "tr": "Bu harika!" } },
    { "id": "u22.s.08", "en": "Are you busy now?", "native": { "uz": "Hozir bandmisiz?", "ru": "Вы сейчас заняты?", "tr": "Şu an meşgul müsünüz?" }, "altNative": { "uz": ["Hozir bandmisan?"], "ru": ["Ты сейчас занят?", "Ты сейчас занята?"], "tr": ["Şu an meşgul müsün?"] } },

    { "id": "u22.s.09", "en": "What is your plan for tomorrow?", "native": { "uz": "Ertangi rejangiz qanday?", "ru": "Какой у вас план на завтра?", "tr": "Yarın için planınız nedir?" } },
    { "id": "u22.s.10", "en": "Are you free tonight?", "native": { "uz": "Bugun kechqurun bo'shmisiz?", "ru": "Вы свободны сегодня вечером?", "tr": "Bu akşam boş musunuz?" }, "altNative": { "uz": ["Bugun kechqurun bo'shmisan?"], "ru": ["Ты свободен сегодня вечером?", "Ты свободна сегодня вечером?"], "tr": ["Bu akşam boş musun?", "Bu akşam müsait misiniz?"] } },
    { "id": "u22.s.11", "en": "I am free tomorrow.", "native": { "uz": "Men ertaga bo'shman.", "ru": "Я свободен завтра.", "tr": "Yarın boşum." }, "altNative": { "ru": ["Я свободна завтра.", "Завтра я свободен.", "Завтра я свободна."], "tr": ["Yarın müsaitim."] } },
    { "id": "u22.s.12", "en": "We can meet tomorrow.", "native": { "uz": "Biz ertaga uchrasha olamiz.", "ru": "Мы можем встретиться завтра.", "tr": "Yarın buluşabiliriz." } },
    { "id": "u22.s.13", "en": "We eat together.", "native": { "uz": "Biz birga ovqatlanamiz.", "ru": "Мы едим вместе.", "tr": "Birlikte yemek yeriz." }, "altNative": { "tr": ["Birlikte yemek yiyoruz."] } },
    { "id": "u22.s.14", "en": "I have a plan.", "native": { "uz": "Menda reja bor.", "ru": "У меня есть план.", "tr": "Bir planım var." } },
    { "id": "u22.s.15", "en": "I have no plans tonight.", "native": { "uz": "Bugun kechqurun rejam yo'q.", "ru": "Сегодня вечером у меня нет планов.", "tr": "Bu akşam planım yok." } },
    { "id": "u22.s.16", "en": "We work together.", "native": { "uz": "Biz birga ishlaymiz.", "ru": "Мы работаем вместе.", "tr": "Birlikte çalışıyoruz." } },

    { "id": "u22.s.17", "en": "Let's go to the cinema.", "native": { "uz": "Keling, kinoteatrga boramiz.", "ru": "Давай пойдём в кинотеатр.", "tr": "Hadi sinemaya gidelim." }, "altNative": { "uz": ["Keling, kinoga boramiz."], "ru": ["Давайте пойдём в кинотеатр.", "Давай пойдём в кино."] } },
    { "id": "u22.s.18", "en": "I want to invite you.", "native": { "uz": "Men sizni taklif qilmoqchiman.", "ru": "Я хочу вас пригласить.", "tr": "Sizi davet etmek istiyorum." }, "altNative": { "ru": ["Я хочу пригласить вас.", "Я хочу тебя пригласить."], "tr": ["Seni davet etmek istiyorum."] } },
    { "id": "u22.s.19", "en": "There is a party tomorrow.", "native": { "uz": "Ertaga ziyofat bor.", "ru": "Завтра вечеринка.", "tr": "Yarın bir parti var." }, "altNative": { "ru": ["Завтра будет вечеринка."] } },
    { "id": "u22.s.20", "en": "Can you come?", "native": { "uz": "Kela olasizmi?", "ru": "Вы можете прийти?", "tr": "Gelebilir misiniz?" }, "altNative": { "uz": ["Kela olasanmi?"], "ru": ["Ты можешь прийти?"], "tr": ["Gelebilir misin?"] } },
    { "id": "u22.s.21", "en": "Please join us.", "native": { "uz": "Iltimos, bizga qo'shiling.", "ru": "Пожалуйста, присоединяйтесь к нам.", "tr": "Lütfen bize katılın." } },
    { "id": "u22.s.22", "en": "Let's meet at the cinema.", "native": { "uz": "Keling, kinoteatrda uchrashamiz.", "ru": "Давай встретимся в кинотеатре.", "tr": "Hadi sinemada buluşalım." }, "altNative": { "ru": ["Давайте встретимся в кинотеатре."] } },
    { "id": "u22.s.23", "en": "Come to my party!", "native": { "uz": "Mening ziyofatimga keling!", "ru": "Приходите на мою вечеринку!", "tr": "Partime gelin!" }, "altNative": { "uz": ["Ziyofatimga keling!"], "ru": ["Приходи на мою вечеринку!"], "tr": ["Partime gel!"] } },
    { "id": "u22.s.24", "en": "Let's eat together.", "native": { "uz": "Keling, birga ovqatlanamiz.", "ru": "Давай поедим вместе.", "tr": "Hadi birlikte yemek yiyelim." }, "altNative": { "ru": ["Давайте поедим вместе."] } },

    { "id": "u22.s.25", "en": "Sure, I can come.", "native": { "uz": "Albatta, kela olaman.", "ru": "Конечно, я могу прийти.", "tr": "Tabii, gelebilirim." } },
    { "id": "u22.s.26", "en": "Maybe tomorrow.", "native": { "uz": "Balki ertaga.", "ru": "Может быть, завтра.", "tr": "Belki yarın." } },
    { "id": "u22.s.27", "en": "Sounds good!", "native": { "uz": "Yaxshi fikr!", "ru": "Звучит хорошо!", "tr": "Kulağa hoş geliyor!" } },
    { "id": "u22.s.28", "en": "Sorry, I am busy.", "native": { "uz": "Kechirasiz, men bandman.", "ru": "Извините, я занят.", "tr": "Üzgünüm, meşgulüm." }, "altNative": { "ru": ["Извините, я занята."] } },
    { "id": "u22.s.29", "en": "Maybe next time.", "native": { "uz": "Balki keyingi safar.", "ru": "Может быть, в следующий раз.", "tr": "Belki bir dahaki sefere." } },
    { "id": "u22.s.30", "en": "Sorry, I am late.", "native": { "uz": "Kechirasiz, kech qoldim.", "ru": "Извините, я опоздал.", "tr": "Üzgünüm, geç kaldım." }, "altNative": { "ru": ["Извините, я опоздала."] } },
    { "id": "u22.s.31", "en": "It is late.", "native": { "uz": "Kech bo'ldi.", "ru": "Уже поздно.", "tr": "Geç oldu." }, "altNative": { "ru": ["Поздно."] } },
    { "id": "u22.s.32", "en": "Sure, sounds good.", "native": { "uz": "Albatta, yaxshi fikr.", "ru": "Конечно, звучит хорошо.", "tr": "Tabii, kulağa hoş geliyor." } },

    { "id": "u22.s.33", "en": "See you later!", "native": { "uz": "Keyinroq ko'rishamiz!", "ru": "Увидимся позже!", "tr": "Sonra görüşürüz!" } },
    { "id": "u22.s.34", "en": "Have a nice day!", "native": { "uz": "Kuningiz xayrli o'tsin!", "ru": "Хорошего дня!", "tr": "İyi günler!" } },
    { "id": "u22.s.35", "en": "Take care!", "native": { "uz": "O'zingizni asrang!", "ru": "Берегите себя!", "tr": "Kendinize iyi bakın!" }, "altNative": { "uz": ["O'zingni asra!"], "ru": ["Береги себя!"], "tr": ["Kendine iyi bak!"] } },
    { "id": "u22.s.36", "en": "Say hi to your family.", "native": { "uz": "Oilangizga salom ayting.", "ru": "Передавайте привет вашей семье.", "tr": "Ailenize selam söyleyin." } },
    { "id": "u22.s.37", "en": "See you soon!", "native": { "uz": "Tez orada ko'rishamiz!", "ru": "До скорой встречи!", "tr": "Yakında görüşürüz!" }, "altNative": { "ru": ["Скоро увидимся!"] } },
    { "id": "u22.s.38", "en": "The party is fun.", "native": { "uz": "Ziyofat maroqli.", "ru": "Вечеринка весёлая.", "tr": "Parti eğlenceli." } },
    { "id": "u22.s.39", "en": "Thanks, take care!", "native": { "uz": "Rahmat, o'zingizni asrang!", "ru": "Спасибо, берегите себя!", "tr": "Teşekkürler, kendinize iyi bakın!" } },
    { "id": "u22.s.40", "en": "Have fun tonight!", "native": { "uz": "Bugun kechqurun maza qiling!", "ru": "Хорошо повеселитесь сегодня вечером!", "tr": "Bu akşam iyi eğlenceler!" } }
  ],
