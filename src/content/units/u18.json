  "sentences": [
    { "id": "u18.s.01", "en": "I will call you tomorrow.", "altEn": ["I am going to call you tomorrow.", "Tomorrow I will call you."], "native": { "uz": "Men senga ertaga qo'ng'iroq qilaman.", "ru": "Я позвоню тебе завтра.", "tr": "Seni yarın arayacağım." }, "altNative": { "uz": ["Senga ertaga qo'ng'iroq qilaman.", "Ertaga senga qo'ng'iroq qilaman.", "Men ertaga senga qo'ng'iroq qilaman.", "Ertaga men senga qo'ng'iroq qilaman.", "Men senga ertaga telefon qilaman.", "Senga ertaga telefon qilaman."], "ru": ["Я тебе завтра позвоню.", "Завтра я тебе позвоню.", "Я завтра тебе позвоню.", "Завтра я позвоню тебе.", "Я завтра позвоню тебе.", "Я тебе позвоню завтра.", "Позвоню тебе завтра."], "tr": ["Ben seni yarın arayacağım.", "Yarın seni arayacağım.", "Seni yarın ararım."] } },
    { "id": "u18.s.02", "en": "I will try.", "altEn": ["I am going to try."], "native": { "uz": "Men harakat qilaman.", "ru": "Я постараюсь.", "tr": "Deneyeceğim." }, "altNative": { "uz": ["Harakat qilaman.", "Men urinib ko'raman.", "Urinib ko'raman."], "ru": ["Я попробую.", "Я попытаюсь.", "Постараюсь."], "tr": ["Ben deneyeceğim.", "Denerim."] } },
    { "id": "u18.s.03", "en": "I will not forget.", "altEn": ["I am not going to forget."], "native": { "uz": "Men unutmayman.", "ru": "Я не забуду.", "tr": "Unutmayacağım." }, "altNative": { "uz": ["Unutmayman."], "ru": ["Не забуду."], "tr": ["Ben unutmayacağım.", "Unutmam."] } },
    { "id": "u18.s.04", "en": "Will you remember me?", "altEn": ["Are you going to remember me?"], "native": { "uz": "Sen meni eslaysanmi?", "ru": "Ты будешь меня помнить?", "tr": "Beni hatırlayacak mısın?" }, "altNative": { "uz": ["Meni eslaysanmi?", "Sen meni eslab qolasanmi?", "Meni eslab qolasanmi?", "Meni eslab yurasanmi?", "Meni yodda tutasanmi?"], "ru": ["Ты будешь помнить меня?", "Ты меня будешь помнить?", "Будешь меня помнить?", "Ты меня запомнишь?", "Ты запомнишь меня?"], "tr": ["Sen beni hatırlayacak mısın?", "Beni hatırlar mısın?"] } },
    { "id": "u18.s.05", "en": "Maybe I will come later.", "altEn": ["Maybe I am going to come later."], "native": { "uz": "Balki men keyinroq kelaman.", "ru": "Может быть, я приду позже.", "tr": "Belki sonra gelirim." }, "altNative": { "uz": ["Balki keyinroq kelaman.", "Balki men keyinroq kelarman.", "Balki keyinroq kelarman.", "Men balki keyinroq kelaman."], "ru": ["Может, я приду позже.", "Возможно, я приду позже.", "Может быть, я позже приду.", "Я, может быть, приду позже.", "Может быть, приду позже."], "tr": ["Belki daha sonra gelirim.", "Belki sonra geleceğim.", "Belki daha sonra geleceğim.", "Belki ben sonra gelirim."] } },
    { "id": "u18.s.06", "en": "Are you sure?", "native": { "uz": "Ishonching komilmi?", "ru": "Ты уверен?", "tr": "Emin misin?" }, "altNative": { "uz": ["Sening ishonching komilmi?", "Aminmisan?", "Sen aminmisan?"], "ru": ["Ты уверена?", "Уверен?", "Уверена?"], "tr": ["Sen emin misin?"] } },
    { "id": "u18.s.07", "en": "Yes, I promise.", "native": { "uz": "Ha, va'da beraman.", "ru": "Да, обещаю.", "tr": "Evet, söz veriyorum." }, "altNative": { "uz": ["Ha, men va'da beraman."], "ru": ["Да, я обещаю."], "tr": ["Evet, söz veririm.", "Evet, söz."] } },
    { "id": "u18.s.08", "en": "I promise I will try.", "altEn": ["I promise that I will try.", "I promise to try."], "native": { "uz": "Va'da beraman, harakat qilaman.", "ru": "Обещаю, я постараюсь.", "tr": "Söz veriyorum, deneyeceğim." }, "altNative": { "uz": ["Men va'da beraman, harakat qilaman.", "Harakat qilaman, va'da beraman.", "Harakat qilishga va'da beraman."], "ru": ["Обещаю, постараюсь.", "Я постараюсь, обещаю.", "Обещаю, что постараюсь.", "Я обещаю, что постараюсь.", "Я обещаю, я постараюсь.", "Обещаю, я попробую."], "tr": ["Deneyeceğim, söz veriyorum.", "Deneyeceğime söz veriyorum.", "Söz veriyorum, denerim."] } },

    { "id": "u18.s.09", "en": "I am going to learn English.", "altEn": ["I will learn English.", "I am going to study English."], "native": { "uz": "Men ingliz tilini o'rganmoqchiman.", "ru": "Я собираюсь учить английский.", "tr": "İngilizce öğreneceğim." }, "altNative": { "uz": ["Ingliz tilini o'rganmoqchiman.", "Men ingliz tilini o'rganaman.", "Men inglizchani o'rganmoqchiman."], "ru": ["Я буду учить английский.", "Я собираюсь выучить английский.", "Я собираюсь изучать английский.", "Я собираюсь учить английский язык."], "tr": ["Ben İngilizce öğreneceğim.", "İngilizce öğrenmeyi planlıyorum."] } },
    { "id": "u18.s.10", "en": "What are you going to do tomorrow?", "altEn": ["What will you do tomorrow?"], "native": { "uz": "Sen ertaga nima qilmoqchisan?", "ru": "Что ты собираешься делать завтра?", "tr": "Yarın ne yapacaksın?" }, "altNative": { "uz": ["Ertaga nima qilmoqchisan?", "Ertaga sen nima qilmoqchisan?", "Ertaga nima qilasan?", "Sen ertaga nima qilasan?"], "ru": ["Что ты будешь делать завтра?", "Что ты завтра собираешься делать?", "Что ты собираешься завтра делать?", "Что ты завтра будешь делать?"], "tr": ["Sen yarın ne yapacaksın?"] } },
    { "id": "u18.s.11", "en": "My daughter is going to become a doctor.", "altEn": ["My daughter will become a doctor.", "My daughter is going to be a doctor.", "My daughter will be a doctor."], "native": { "uz": "Mening qizim shifokor bo'lmoqchi.", "ru": "Моя дочь собирается стать врачом.", "tr": "Kızım doktor olacak." }, "altNative": { "uz": ["Qizim shifokor bo'lmoqchi.", "Mening qizim shifokor bo'ladi.", "Qizim shifokor bo'ladi.", "Mening qizim doktor bo'lmoqchi.", "Qizim doktor bo'lmoqchi."], "ru": ["Моя дочь станет врачом.", "Моя дочь будет врачом."], "tr": ["Benim kızım doktor olacak.", "Kızım bir doktor olacak."] } },
    { "id": "u18.s.12", "en": "We are going to move to London.", "altEn": ["We will move to London."], "native": { "uz": "Biz Londonga ko'chmoqchimiz.", "ru": "Мы собираемся переехать в Лондон.", "tr": "Londra'ya taşınacağız." }, "altNative": { "uz": ["Biz Londonga ko'chib o'tmoqchimiz.", "Biz Londonga ko'chamiz.", "Londonga ko'chmoqchimiz.", "Londonga ko'chib o'tmoqchimiz."], "ru": ["Мы собираемся переезжать в Лондон.", "Мы переедем в Лондон.", "Мы переезжаем в Лондон."], "tr": ["Biz Londra'ya taşınacağız."] } },
    { "id": "u18.s.13", "en": "I am going to change my job.", "altEn": ["I will change my job.", "I am going to change jobs."], "native": { "uz": "Men ishimni o'zgartirmoqchiman.", "ru": "Я собираюсь сменить работу.", "tr": "İşimi değiştireceğim." }, "altNative": { "uz": ["Ishimni o'zgartirmoqchiman.", "Men ishimni almashtirmoqchiman.", "Men ish joyimni o'zgartirmoqchiman."], "ru": ["Я собираюсь поменять работу.", "Я сменю работу.", "Я поменяю работу."], "tr": ["Ben işimi değiştireceğim."] } },
    { "id": "u18.s.14", "en": "My brother is going to start a business.", "altEn": ["My brother will start a business."], "native": { "uz": "Mening akam biznes boshlamoqchi.", "ru": "Мой брат собирается начать бизнес.", "tr": "Erkek kardeşim bir iş kuracak." }, "altNative": { "uz": ["Mening ukam biznes boshlamoqchi.", "Akam biznes boshlamoqchi.", "Ukam biznes boshlamoqchi.", "Mening akam biznes ochmoqchi.", "Mening akam biznes boshlaydi."], "ru": ["Мой брат собирается открыть бизнес.", "Мой брат собирается открыть своё дело.", "Мой брат начнёт бизнес.", "Мой брат откроет бизнес."], "tr": ["Benim erkek kardeşim bir iş kuracak.", "Abim bir iş kuracak.", "Erkek kardeşim iş kuracak.", "Erkek kardeşim bir işletme kuracak.", "Erkek kardeşim kendi işini kuracak."] } },
    { "id": "u18.s.15", "en": "What are your plans for the future?", "altEn": ["What are your future plans?", "What plans do you have for the future?"], "native": { "uz": "Kelajak uchun rejalaring qanday?", "ru": "Какие у тебя планы на будущее?", "tr": "Gelecek için planların neler?" }, "altNative": { "uz": ["Sening kelajak uchun rejalaring qanday?", "Kelajakka rejalaring qanday?", "Kelajakdagi rejalaring qanday?", "Kelajak uchun rejalaring nima?"], "ru": ["Какие твои планы на будущее?", "Какие планы у тебя на будущее?"], "tr": ["Gelecek için planların ne?", "Gelecek planların neler?", "Gelecekle ilgili planların neler?", "Senin gelecek için planların neler?"] } },
    { "id": "u18.s.16", "en": "I am not going to change my plan.", "altEn": ["I will not change my plan."], "native": { "uz": "Men rejamni o'zgartirmoqchi emasman.", "ru": "Я не собираюсь менять свой план.", "tr": "Planımı değiştirmeyeceğim." }, "altNative": { "uz": ["Rejamni o'zgartirmoqchi emasman.", "Men rejamni o'zgartirmayman.", "Rejamni o'zgartirmayman."], "ru": ["Я не собираюсь менять план.", "Я не собираюсь менять свои планы.", "Я не буду менять свой план.", "Я не буду менять план."], "tr": ["Ben planımı değiştirmeyeceğim."] } },

    { "id": "u18.s.17", "en": "I want to see the world.", "native": { "uz": "Men dunyoni ko'rishni xohlayman.", "ru": "Я хочу увидеть мир.", "tr": "Dünyayı görmek istiyorum." }, "altNative": { "uz": ["Dunyoni ko'rishni xohlayman.", "Men dunyoni ko'rmoqchiman."], "ru": ["Я хочу посмотреть мир.", "Я хочу повидать мир."], "tr": ["Ben dünyayı görmek istiyorum."] } },
    { "id": "u18.s.18", "en": "What do you want to become?", "altEn": ["What do you want to be?", "Who do you want to become?", "Who do you want to be?"], "native": { "uz": "Sen kim bo'lishni xohlaysan?", "ru": "Кем ты хочешь стать?", "tr": "Ne olmak istiyorsun?" }, "altNative": { "uz": ["Kim bo'lishni xohlaysan?", "Sen kim bo'lmoqchisan?", "Kim bo'lmoqchisan?"], "ru": ["Кем хочешь стать?", "Ты кем хочешь стать?", "Кем ты хочешь быть?"], "tr": ["Sen ne olmak istiyorsun?", "Ne olmak istersin?"] } },
    { "id": "u18.s.19", "en": "I want to become an engineer.", "altEn": ["I want to be an engineer."], "native": { "uz": "Men muhandis bo'lishni xohlayman.", "ru": "Я хочу стать инженером.", "tr": "Mühendis olmak istiyorum." }, "altNative": { "uz": ["Muhandis bo'lishni xohlayman.", "Men muhandis bo'lmoqchiman."], "ru": ["Хочу стать инженером.", "Я хочу быть инженером."], "tr": ["Ben mühendis olmak istiyorum."] } },
    { "id": "u18.s.20", "en": "My dream is to live in London.", "native": { "uz": "Mening orzuim Londonda yashash.", "ru": "Моя мечта — жить в Лондоне.", "tr": "Hayalim Londra'da yaşamak." }, "altNative": { "uz": ["Orzuim Londonda yashash.", "Londonda yashash mening orzuim."], "ru": ["Жить в Лондоне — моя мечта."], "tr": ["Benim hayalim Londra'da yaşamak.", "Londra'da yaşamak benim hayalim."] } },
    { "id": "u18.s.21", "en": "I hope to see you soon.", "altEn": ["I hope I will see you soon.", "I hope I see you soon.", "I hope that I will see you soon."], "native": { "uz": "Seni tez orada ko'rishga umid qilaman.", "ru": "Надеюсь скоро тебя увидеть.", "tr": "Seni yakında görmeyi umuyorum." }, "altNative": { "uz": ["Tez orada seni ko'rishga umid qilaman.", "Men seni tez orada ko'rishga umid qilaman.", "Tez orada ko'rishamiz degan umiddaman."], "ru": ["Я надеюсь скоро тебя увидеть.", "Надеюсь скоро увидеть тебя.", "Надеюсь, скоро увидимся."], "tr": ["Yakında seni görmeyi umuyorum.", "Umarım seni yakında görürüm.", "Umarım yakında görüşürüz."] } },
    { "id": "u18.s.22", "en": "My goal is to speak English well.", "altEn": ["My goal is to speak good English."], "native": { "uz": "Mening maqsadim ingliz tilida yaxshi gapirish.", "ru": "Моя цель — хорошо говорить по-английски.", "tr": "Hedefim iyi İngilizce konuşmak." }, "altNative": { "uz": ["Maqsadim ingliz tilida yaxshi gapirish.", "Mening maqsadim inglizcha yaxshi gapirish."], "ru": ["Моя цель — говорить по-английски хорошо."], "tr": ["Benim hedefim iyi İngilizce konuşmak.", "Hedefim İngilizceyi iyi konuşmak.", "Amacım iyi İngilizce konuşmak."] } },
    { "id": "u18.s.23", "en": "She doesn't want to change her life.", "altEnFor": { "uz": ["He doesn't want to change his life."], "tr": ["He doesn't want to change his life."] }, "native": { "uz": "U hayotini o'zgartirishni xohlamaydi.", "ru": "Она не хочет менять свою жизнь.", "tr": "O hayatını değiştirmek istemiyor." }, "altNative": { "uz": ["Hayotini o'zgartirishni xohlamaydi.", "U o'z hayotini o'zgartirishni xohlamaydi.", "U hayotini o'zgartirmoqchi emas."], "ru": ["Она не хочет менять жизнь.", "Она не хочет изменить свою жизнь."], "tr": ["Hayatını değiştirmek istemiyor.", "O kendi hayatını değiştirmek istemiyor."] } },
    { "id": "u18.s.24", "en": "I want to live in Turkey someday.", "altEn": ["Someday I want to live in Turkey.", "I want to live in Turkey one day."], "native": { "uz": "Men bir kun kelib Turkiyada yashashni xohlayman.", "ru": "Я хочу когда-нибудь жить в Турции.", "tr": "Bir gün Türkiye'de yaşamak istiyorum." }, "altNative": { "uz": ["Bir kun kelib men Turkiyada yashashni xohlayman.", "Bir kun kelib Turkiyada yashashni xohlayman.", "Men qachondir Turkiyada yashashni xohlayman."], "ru": ["Когда-нибудь я хочу жить в Турции.", "Я хочу когда-нибудь пожить в Турции.", "Я хочу жить в Турции когда-нибудь."], "tr": ["Ben bir gün Türkiye'de yaşamak istiyorum.", "Türkiye'de bir gün yaşamak istiyorum.", "Günün birinde Türkiye'de yaşamak istiyorum."] } },

    { "id": "u18.s.25", "en": "Why do you want to learn English?", "altEn": ["Why do you want to study English?"], "native": { "uz": "Sen nega ingliz tilini o'rganishni xohlaysan?", "ru": "Почему ты хочешь учить английский?", "tr": "Neden İngilizce öğrenmek istiyorsun?" }, "altNative": { "uz": ["Nega ingliz tilini o'rganishni xohlaysan?", "Nega sen ingliz tilini o'rganishni xohlaysan?", "Nima uchun ingliz tilini o'rganishni xohlaysan?", "Nega ingliz tilini o'rganmoqchisan?"], "ru": ["Почему ты хочешь выучить английский?", "Почему ты хочешь изучать английский?", "Почему ты хочешь учить английский язык?", "Зачем ты хочешь учить английский?"], "tr": ["Sen neden İngilizce öğrenmek istiyorsun?", "Niçin İngilizce öğrenmek istiyorsun?", "Niye İngilizce öğrenmek istiyorsun?"] } },
    { "id": "u18.s.26", "en": "Because I want a good job.", "altEn": ["Because I want to have a good job."], "native": { "uz": "Chunki men yaxshi ish xohlayman.", "ru": "Потому что я хочу хорошую работу.", "tr": "Çünkü iyi bir iş istiyorum." }, "altNative": { "uz": ["Chunki yaxshi ish xohlayman.", "Chunki menga yaxshi ish kerak."], "ru": ["Потому что хочу хорошую работу."], "tr": ["Çünkü ben iyi bir iş istiyorum."] } },
    { "id": "u18.s.27", "en": "That is a great idea!", "altEn": ["This is a great idea!", "It is a great idea!"], "native": { "uz": "Bu zo'r g'oya!", "ru": "Это отличная идея!", "tr": "Bu harika bir fikir!" }, "altNative": { "uz": ["Bu ajoyib g'oya!", "Bu zo'r fikr!", "Bu ajoyib fikr!"], "ru": ["Отличная идея!", "Это прекрасная идея!"], "tr": ["Harika bir fikir!", "Bu harika fikir!"] } },
    { "id": "u18.s.28", "en": "I am ready because I study every day.", "native": { "uz": "Men tayyorman, chunki har kuni dars qilaman.", "ru": "Я готов, потому что занимаюсь каждый день.", "tr": "Hazırım çünkü her gün ders çalışıyorum." }, "altNative": { "uz": ["Men tayyorman, chunki men har kuni dars qilaman.", "Tayyorman, chunki har kuni dars qilaman.", "Men tayyorman, chunki har kuni o'qiyman."], "ru": ["Я готова, потому что занимаюсь каждый день.", "Я готов, потому что учусь каждый день.", "Я готова, потому что учусь каждый день.", "Я готов, потому что каждый день занимаюсь.", "Я готова, потому что каждый день занимаюсь."], "tr": ["Ben hazırım çünkü her gün ders çalışıyorum.", "Hazırım çünkü her gün çalışıyorum."] } },
    { "id": "u18.s.29", "en": "I believe it is possible.", "altEn": ["I believe that it is possible.", "I believe this is possible."], "native": { "uz": "Men buning mumkinligiga ishonaman.", "ru": "Я верю, что это возможно.", "tr": "Bunun mümkün olduğuna inanıyorum." }, "altNative": { "uz": ["Buning mumkinligiga ishonaman.", "Men bu mumkin deb ishonaman.", "Ishonamanki, bu mumkin."], "ru": ["Верю, что это возможно.", "Я верю, это возможно."], "tr": ["Ben bunun mümkün olduğuna inanıyorum.", "İnanıyorum ki bu mümkün."] } },
    { "id": "u18.s.30", "en": "She can't come because she is busy.", "altEnFor": { "uz": ["He can't come because he is busy."], "tr": ["He can't come because he is busy."] }, "native": { "uz": "U kela olmaydi, chunki u band.", "ru": "Она не может прийти, потому что занята.", "tr": "O gelemiyor çünkü meşgul." }, "altNative": { "uz": ["U kela olmaydi, chunki band.", "U kelolmaydi, chunki u band.", "U kelolmaydi, chunki band."], "ru": ["Она не может прийти, потому что она занята.", "Она не сможет прийти, потому что занята."], "tr": ["O gelemez çünkü meşgul.", "O gelemiyor çünkü o meşgul.", "Gelemiyor çünkü meşgul."] } },
    { "id": "u18.s.31", "en": "Why don't you believe me?", "altEn": ["Why do you not believe me?"], "native": { "uz": "Nega menga ishonmaysan?", "ru": "Почему ты мне не веришь?", "tr": "Neden bana inanmıyorsun?" }, "altNative": { "uz": ["Nega sen menga ishonmaysan?", "Sen nega menga ishonmaysan?", "Nima uchun menga ishonmaysan?", "Nega menga ishonmayapsan?"], "ru": ["Почему ты не веришь мне?"], "tr": ["Bana neden inanmıyorsun?", "Niye bana inanmıyorsun?", "Niçin bana inanmıyorsun?"] } },
    { "id": "u18.s.32", "en": "I have an idea for a new business.", "native": { "uz": "Menda yangi biznes uchun g'oya bor.", "ru": "У меня есть идея для нового бизнеса.", "tr": "Yeni bir işletme için bir fikrim var." }, "altNative": { "uz": ["Menda yangi biznes uchun bir g'oya bor.", "Yangi biznes uchun g'oyam bor.", "Menda yangi biznes uchun fikr bor."], "ru": ["У меня есть идея нового бизнеса.", "У меня идея для нового бизнеса."], "tr": ["Yeni bir işletme için fikrim var.", "Benim yeni bir işletme için bir fikrim var.", "Yeni bir iş için bir fikrim var.", "Yeni bir iş için fikrim var.", "Yeni bir iş fikrim var."] } },

    { "id": "u18.s.33", "en": "My dream is to reach the summit.", "native": { "uz": "Mening orzuim cho'qqiga yetib borish.", "ru": "Моя мечта — достичь вершины.", "tr": "Hayalim zirveye ulaşmak." }, "altNative": { "uz": ["Orzuim cho'qqiga yetib borish.", "Mening orzuim cho'qqiga yetish.", "Mening orzuim cho'qqiga chiqish."], "ru": ["Моя мечта — дойти до вершины.", "Моя мечта — добраться до вершины."], "tr": ["Benim hayalim zirveye ulaşmak."] } },
    { "id": "u18.s.34", "en": "You can choose your future.", "native": { "uz": "Sen kelajagingni tanlay olasan.", "ru": "Ты можешь выбрать своё будущее.", "tr": "Geleceğini seçebilirsin." }, "altNative": { "uz": ["Sen o'z kelajagingni tanlay olasan.", "Kelajagingni tanlay olasan.", "Sen kelajagingni tanlashing mumkin."], "ru": ["Ты можешь выбирать своё будущее.", "Ты можешь сам выбрать своё будущее.", "Ты можешь сама выбрать своё будущее."], "tr": ["Sen geleceğini seçebilirsin.", "Kendi geleceğini seçebilirsin."] } },
    { "id": "u18.s.35", "en": "When are you going to decide?", "altEn": ["When will you decide?"], "native": { "uz": "Sen qachon qaror qilmoqchisan?", "ru": "Когда ты собираешься принять решение?", "tr": "Ne zaman karar vereceksin?" }, "altNative": { "uz": ["Qachon qaror qilmoqchisan?", "Qachon qaror qilasan?", "Sen qachon qaror qilasan?"], "ru": ["Когда ты собираешься решить?", "Когда ты собираешься решать?", "Когда ты решишь?", "Когда ты примешь решение?"], "tr": ["Sen ne zaman karar vereceksin?"] } },
    { "id": "u18.s.36", "en": "I can't decide because I am not sure.", "native": { "uz": "Men qaror qila olmayapman, chunki ishonchim komil emas.", "ru": "Я не могу решить, потому что не уверен.", "tr": "Karar veremiyorum çünkü emin değilim." }, "altNative": { "uz": ["Qaror qila olmayapman, chunki ishonchim komil emas.", "Men qaror qila olmayman, chunki ishonchim komil emas.", "Men qaror qila olmayapman, chunki amin emasman."], "ru": ["Я не могу решить, потому что не уверена.", "Я не могу решить, потому что я не уверен.", "Я не могу решить, потому что я не уверена.", "Я не могу решиться, потому что не уверен.", "Я не могу решиться, потому что не уверена."], "tr": ["Ben karar veremiyorum çünkü emin değilim.", "Karar veremem çünkü emin değilim."] } },
    { "id": "u18.s.37", "en": "I will succeed because I try every day.", "altEn": ["I am going to succeed because I try every day."], "native": { "uz": "Men muvaffaqiyatga erishaman, chunki har kuni harakat qilaman.", "ru": "Я добьюсь успеха, потому что стараюсь каждый день.", "tr": "Başaracağım çünkü her gün çabalıyorum." }, "altNative": { "uz": ["Muvaffaqiyatga erishaman, chunki har kuni harakat qilaman.", "Men muvaffaqiyatga erishaman, chunki men har kuni harakat qilaman."], "ru": ["Я добьюсь успеха, потому что я стараюсь каждый день.", "Я добьюсь успеха, потому что каждый день стараюсь.", "Я преуспею, потому что стараюсь каждый день."], "tr": ["Ben başaracağım çünkü her gün çabalıyorum.", "Başaracağım çünkü her gün deniyorum.", "Başaracağım çünkü her gün uğraşıyorum.", "Başarılı olacağım çünkü her gün çabalıyorum."] } },
    { "id": "u18.s.38", "en": "Our business is going to grow next year.", "altEn": ["Our business will grow next year."], "native": { "uz": "Bizning biznesimiz kelasi yil o'sadi.", "ru": "Наш бизнес вырастет в следующем году.", "tr": "İşletmemiz gelecek yıl büyüyecek." }, "altNative": { "uz": ["Biznesimiz kelasi yil o'sadi.", "Bizning biznesimiz keyingi yil o'sadi.", "Bizning biznesimiz kelasi yili o'sadi.", "Kelasi yil bizning biznesimiz o'sadi."], "ru": ["В следующем году наш бизнес вырастет.", "Наш бизнес в следующем году вырастет.", "Наш бизнес будет расти в следующем году."], "tr": ["Bizim işletmemiz gelecek yıl büyüyecek.", "İşletmemiz seneye büyüyecek.", "Gelecek yıl işletmemiz büyüyecek.", "İşimiz gelecek yıl büyüyecek.", "Bizim işimiz gelecek yıl büyüyecek.", "İşimiz seneye büyüyecek."] } },
    { "id": "u18.s.39", "en": "I believe you will succeed someday.", "altEn": ["I believe that you will succeed someday.", "I believe you will succeed one day.", "I believe someday you will succeed."], "native": { "uz": "Ishonamanki, sen bir kun kelib muvaffaqiyatga erishasan.", "ru": "Я верю, что когда-нибудь ты добьёшься успеха.", "tr": "Bir gün başaracağına inanıyorum." }, "altNative": { "uz": ["Men ishonamanki, sen bir kun kelib muvaffaqiyatga erishasan.", "Bir kun kelib muvaffaqiyatga erishishingga ishonaman.", "Men sening bir kun kelib muvaffaqiyatga erishishingga ishonaman."], "ru": ["Я верю, что ты когда-нибудь добьёшься успеха.", "Я верю, ты когда-нибудь добьёшься успеха.", "Верю, что когда-нибудь ты добьёшься успеха."], "tr": ["Ben bir gün başaracağına inanıyorum.", "Senin bir gün başaracağına inanıyorum.", "Bir gün başarılı olacağına inanıyorum."] } },
    { "id": "u18.s.40", "en": "We will reach the summit together.", "altEn": ["We are going to reach the summit together.", "Together we will reach the summit."], "native": { "uz": "Biz cho'qqiga birga yetib boramiz.", "ru": "Мы достигнем вершины вместе.", "tr": "Zirveye birlikte ulaşacağız." }, "altNative": { "uz": ["Biz birga cho'qqiga yetib boramiz.", "Cho'qqiga birga yetib boramiz.", "Biz cho'qqiga birgalikda yetib boramiz.", "Biz cho'qqiga birga chiqamiz."], "ru": ["Мы вместе достигнем вершины.", "Мы дойдём до вершины вместе.", "Мы вместе дойдём до вершины."], "tr": ["Biz zirveye birlikte ulaşacağız.", "Birlikte zirveye ulaşacağız.", "Zirveye beraber ulaşacağız."] } }
