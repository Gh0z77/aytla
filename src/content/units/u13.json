    { "id": "u13.s.18", "en": "We write to customers in English.", "altEn": ["We write to the customers in English."], "native": { "uz": "Biz mijozlarga ingliz tilida yozamiz.", "ru": "Мы пишем клиентам по-английски.", "tr": "Müşterilere İngilizce yazıyoruz." }, "altNative": { "uz": ["Biz mijozlarga inglizcha yozamiz.", "Mijozlarga ingliz tilida yozamiz."], "ru": ["Мы пишем клиентам на английском."], "tr": ["Biz müşterilere İngilizce yazıyoruz.", "Müşterilere İngilizce yazarız."] } },
    { "id": "u13.s.19", "en": "He sends an email to the team.", "altEn": ["He sends the team an email."], "native": { "uz": "U jamoaga elektron xat yuboradi.", "ru": "Он отправляет команде электронное письмо.", "tr": "O ekibe bir e-posta gönderiyor." }, "altEnFor": { "uz": ["She sends an email to the team.", "She sends the team an email."], "tr": ["She sends an email to the team.", "She sends the team an email."] }, "altNative": { "uz": ["U jamoaga email yuboradi.", "U jamoaga elektron xat jo'natadi."], "ru": ["Он отправляет электронное письмо команде.", "Он отправляет команде имейл.", "Он посылает команде электронное письмо."], "tr": ["O ekibe e-posta gönderiyor.", "Ekibe bir e-posta gönderiyor.", "O takıma bir e-posta gönderiyor."] } },
    { "id": "u13.s.20", "en": "Can you send me an email?", "altEn": ["Can you send an email to me?"], "native": { "uz": "Menga elektron xat yubora olasanmi?", "ru": "Можешь отправить мне электронное письмо?", "tr": "Bana bir e-posta gönderebilir misin?" }, "altNative": { "uz": ["Sen menga elektron xat yubora olasanmi?", "Menga email yubora olasanmi?", "Menga elektron xat jo'nata olasanmi?"], "ru": ["Ты можешь отправить мне электронное письмо?", "Можешь отправить мне имейл?", "Можешь прислать мне электронное письмо?"], "tr": ["Bana e-posta gönderebilir misin?", "Bana bir e-posta atabilir misin?"] } },
    { "id": "u13.s.21", "en": "Does she help her colleagues?", "native": { "uz": "U hamkasblariga yordam beradimi?", "ru": "Она помогает своим коллегам?", "tr": "O iş arkadaşlarına yardım ediyor mu?" }, "altEnFor": { "uz": ["Does he help his colleagues?"], "tr": ["Does he help his colleagues?"] }, "altNative": { "uz": ["U o'z hamkasblariga yordam beradimi?"], "ru": ["Она помогает коллегам?"], "tr": ["İş arkadaşlarına yardım ediyor mu?", "O iş arkadaşlarına yardım eder mi?"] } },
    { "id": "u13.s.22", "en": "My boss does not call me at night.", "native": { "uz": "Boshlig'im menga tunda qo'ng'iroq qilmaydi.", "ru": "Мой начальник не звонит мне ночью.", "tr": "Patronum beni gece aramıyor." }, "altNative": { "uz": ["Mening boshlig'im menga tunda qo'ng'iroq qilmaydi.", "Boshlig'im menga kechasi qo'ng'iroq qilmaydi.", "Boshlig'im tunda menga qo'ng'iroq qilmaydi."], "ru": ["Мой начальник ночью мне не звонит.", "Моя начальница не звонит мне ночью.", "Мой босс не звонит мне ночью."], "tr": ["Patronum gece beni aramıyor.", "Benim patronum beni gece aramıyor.", "Patronum beni gece aramaz.", "Patronum beni geceleri aramaz."] } },
    { "id": "u13.s.23", "en": "My colleague calls the customer in the morning.", "native": { "uz": "Hamkasbim ertalab mijozga qo'ng'iroq qiladi.", "ru": "Мой коллега звонит клиенту утром.", "tr": "İş arkadaşım sabah müşteriyi arıyor." }, "altNative": { "uz": ["Mening hamkasbim ertalab mijozga qo'ng'iroq qiladi.", "Hamkasbim mijozga ertalab qo'ng'iroq qiladi."], "ru": ["Утром мой коллега звонит клиенту.", "Мой коллега утром звонит клиенту.", "Моя коллега звонит клиенту утром."], "tr": ["Benim iş arkadaşım sabah müşteriyi arıyor.", "İş arkadaşım müşteriyi sabah arıyor.", "İş arkadaşım sabahları müşteriyi arar.", "Meslektaşım sabah müşteriyi arıyor."] } },
    { "id": "u13.s.24", "en": "Our team helps customers.", "altEn": ["Our team helps the customers."], "native": { "uz": "Bizning jamoamiz mijozlarga yordam beradi.", "ru": "Наша команда помогает клиентам.", "tr": "Ekibimiz müşterilere yardım ediyor." }, "altNative": { "uz": ["Jamoamiz mijozlarga yordam beradi."], "tr": ["Bizim ekibimiz müşterilere yardım ediyor.", "Ekibimiz müşterilere yardım eder.", "Takımımız müşterilere yardım ediyor."] } },

    { "id": "u13.s.25", "en": "I study at university.", "altEn": ["I study at a university.", "I study at the university."], "native": { "uz": "Men universitetda o'qiyman.", "ru": "Я учусь в университете.", "tr": "Ben üniversitede okuyorum." }, "altNative": { "uz": ["Universitetda o'qiyman."], "tr": ["Üniversitede okuyorum."] } },
    { "id": "u13.s.26", "en": "Where does your brother study?", "native": { "uz": "Sening akang qayerda o'qiydi?", "ru": "Где учится твой брат?", "tr": "Erkek kardeşin nerede okuyor?" }, "altNative": { "uz": ["Akang qayerda o'qiydi?", "Sening ukang qayerda o'qiydi?", "Ukang qayerda o'qiydi?"], "ru": ["Где твой брат учится?", "Твой брат где учится?"], "tr": ["Senin erkek kardeşin nerede okuyor?", "Abin nerede okuyor?", "Kardeşin nerede okuyor?"] } },
    { "id": "u13.s.27", "en": "My daughter studies at university in Turkey.", "altEn": ["My daughter studies at a university in Turkey."], "native": { "uz": "Mening qizim Turkiyada universitetda o'qiydi.", "ru": "Моя дочь учится в университете в Турции.", "tr": "Kızım Türkiye'de üniversitede okuyor." }, "altNative": { "uz": ["Qizim Turkiyada universitetda o'qiydi.", "Mening qizim Turkiyadagi universitetda o'qiydi.", "Qizim Turkiyadagi universitetda o'qiydi."], "ru": ["Моя дочка учится в университете в Турции.", "Моя дочь учится в Турции в университете."], "tr": ["Benim kızım Türkiye'de üniversitede okuyor.", "Kızım Türkiye'de üniversite okuyor.", "Kızım Türkiye'de bir üniversitede okuyor."] } },
    { "id": "u13.s.28", "en": "I have an English lesson today.", "native": { "uz": "Bugun menda ingliz tili darsi bor.", "ru": "У меня сегодня урок английского.", "tr": "Bugün İngilizce dersim var." }, "altNative": { "uz": ["Menda bugun ingliz tili darsi bor.", "Bugun mening ingliz tili darsim bor.", "Bugun ingliz tili darsim bor."], "ru": ["Сегодня у меня урок английского.", "У меня сегодня урок английского языка.", "Сегодня у меня урок английского языка.", "У меня сегодня занятие по английскому."], "tr": ["Benim bugün İngilizce dersim var.", "Bugün bir İngilizce dersim var."] } },
    { "id": "u13.s.29", "en": "We have an exam tomorrow.", "native": { "uz": "Ertaga bizda imtihon bor.", "ru": "У нас завтра экзамен.", "tr": "Yarın sınavımız var." }, "altNative": { "uz": ["Bizda ertaga imtihon bor.", "Ertaga imtihonimiz bor."], "ru": ["Завтра у нас экзамен."], "tr": ["Yarın bir sınavımız var.", "Bizim yarın sınavımız var."] } },
    { "id": "u13.s.30", "en": "My son does not do his homework.", "native": { "uz": "Mening o'g'lim uy vazifasini qilmaydi.", "ru": "Мой сын не делает домашнее задание.", "tr": "Oğlum ödevini yapmıyor." }, "altNative": { "uz": ["O'g'lim uy vazifasini qilmaydi.", "Mening o'g'lim uy vazifasini bajarmaydi.", "O'g'lim uy vazifasini bajarmaydi."], "ru": ["Мой сын не делает уроки.", "Мой сын не делает своё домашнее задание."], "tr": ["Benim oğlum ödevini yapmıyor.", "Oğlum ödevini yapmaz.", "Oğlum ev ödevini yapmıyor."] } },
    { "id": "u13.s.31", "en": "The teacher answers our questions.", "native": { "uz": "O'qituvchi savollarimizga javob beradi.", "ru": "Учитель отвечает на наши вопросы.", "tr": "Öğretmen sorularımıza cevap veriyor." }, "altNative": { "uz": ["O'qituvchi bizning savollarimizga javob beradi."], "ru": ["Учительница отвечает на наши вопросы."], "tr": ["Öğretmen sorularımızı cevaplıyor.", "Öğretmen bizim sorularımıza cevap veriyor.", "Öğretmen sorularımıza cevap verir.", "Öğretmen sorularımızı yanıtlıyor."] } },
    { "id": "u13.s.32", "en": "Can you answer this question?", "native": { "uz": "Bu savolga javob bera olasanmi?", "ru": "Ты можешь ответить на этот вопрос?", "tr": "Bu soruya cevap verebilir misin?" }, "altNative": { "uz": ["Sen bu savolga javob bera olasanmi?"], "ru": ["Можешь ответить на этот вопрос?"], "tr": ["Sen bu soruya cevap verebilir misin?", "Bu soruyu cevaplayabilir misin?", "Bu soruyu yanıtlayabilir misin?"] } },

    { "id": "u13.s.33", "en": "This job has a good salary.", "native": { "uz": "Bu ishning maoshi yaxshi.", "ru": "На этой работе хорошая зарплата.", "tr": "Bu işin maaşı iyi." }, "altNative": { "uz": ["Bu ishda maosh yaxshi.", "Bu ishning oyligi yaxshi."], "ru": ["У этой работы хорошая зарплата.", "Это работа с хорошей зарплатой."], "tr": ["Bu işin iyi bir maaşı var.", "Bu işin maaşı güzel."] } },
    { "id": "u13.s.34", "en": "My salary is small, but I love my job.", "native": { "uz": "Maoshim kam, lekin men ishimni yaxshi ko'raman.", "ru": "У меня маленькая зарплата, но я люблю свою работу.", "tr": "Maaşım düşük ama işimi seviyorum." }, "altNative": { "uz": ["Maoshim kam, lekin men ishimni sevaman.", "Mening maoshim kam, lekin men ishimni yaxshi ko'raman.", "Maoshim kichik, lekin men ishimni yaxshi ko'raman.", "Maoshim kam, lekin ishimni yaxshi ko'raman."], "ru": ["Моя зарплата маленькая, но я люблю свою работу.", "Зарплата у меня маленькая, но я люблю свою работу."], "tr": ["Maaşım az ama işimi seviyorum.", "Maaşım küçük ama işimi seviyorum.", "Maaşım düşük ama ben işimi seviyorum.", "Maaşım düşük, fakat işimi seviyorum."] } },
    { "id": "u13.s.35", "en": "I have an interview tomorrow morning.", "altEn": ["I have a job interview tomorrow morning."], "native": { "uz": "Ertaga ertalab menda ish suhbati bor.", "ru": "Завтра утром у меня собеседование.", "tr": "Yarın sabah iş görüşmem var." }, "altNative": { "uz": ["Menda ertaga ertalab ish suhbati bor.", "Ertaga ertalab ish suhbatim bor.", "Ertaga ertalab mening ish suhbatim bor."], "ru": ["У меня завтра утром собеседование.", "У меня собеседование завтра утром."], "tr": ["Yarın sabah bir iş görüşmem var.", "Yarın sabah mülakatım var.", "Benim yarın sabah iş görüşmem var."] } },
    { "id": "u13.s.36", "en": "Do you have any experience?", "altEn": ["Do you have experience?"], "native": { "uz": "Sening tajribang bormi?", "ru": "У тебя есть опыт?", "tr": "Deneyimin var mı?" }, "altNative": { "uz": ["Tajribang bormi?", "Senda tajriba bormi?"], "ru": ["У тебя есть опыт работы?"], "tr": ["Senin deneyimin var mı?", "Tecrüben var mı?", "Hiç deneyimin var mı?"] } },
    { "id": "u13.s.37", "en": "Experience is very important for this job.", "native": { "uz": "Bu ish uchun tajriba juda muhim.", "ru": "Для этой работы очень важен опыт.", "tr": "Bu iş için deneyim çok önemli." }, "altNative": { "uz": ["Tajriba bu ish uchun juda muhim."], "ru": ["Опыт очень важен для этой работы.", "Для этой работы опыт очень важен."], "tr": ["Deneyim bu iş için çok önemli.", "Bu iş için tecrübe çok önemli."] } },
    { "id": "u13.s.38", "en": "We have an important project with a new customer.", "native": { "uz": "Bizda yangi mijoz bilan muhim loyiha bor.", "ru": "У нас важный проект с новым клиентом.", "tr": "Yeni bir müşteriyle önemli bir projemiz var." }, "altNative": { "uz": ["Yangi mijoz bilan muhim loyihamiz bor.", "Bizning yangi mijoz bilan muhim loyihamiz bor."], "ru": ["У нас есть важный проект с новым клиентом."], "tr": ["Yeni bir müşteri ile önemli bir projemiz var.", "Bizim yeni bir müşteriyle önemli bir projemiz var.", "Yeni müşteriyle önemli bir projemiz var."] } },
    { "id": "u13.s.39", "en": "She does not have a lunch break today.", "native": { "uz": "Bugun uning tushlik tanaffusi yo'q.", "ru": "Сегодня у неё нет обеденного перерыва.", "tr": "Bugün onun öğle molası yok." }, "altEnFor": { "uz": ["He does not have a lunch break today."], "tr": ["He does not have a lunch break today."] }, "altNative": { "uz": ["Uning bugun tushlik tanaffusi yo'q.", "Bugun unda tushlik tanaffusi yo'q."], "ru": ["У неё сегодня нет обеденного перерыва.", "Сегодня у неё нет перерыва на обед.", "У неё сегодня нет перерыва на обед."], "tr": ["Onun bugün öğle molası yok.", "Bugün öğle molası yok.", "Bugün onun öğle arası yok."] } },
    { "id": "u13.s.40", "en": "Does your brother work on this project?", "native": { "uz": "Sening akang bu loyihada ishlaydimi?", "ru": "Твой брат работает над этим проектом?", "tr": "Erkek kardeşin bu projede çalışıyor mu?" }, "altNative": { "uz": ["Akang bu loyihada ishlaydimi?", "Sening ukang bu loyihada ishlaydimi?", "Ukang bu loyihada ishlaydimi?", "Akang bu loyiha ustida ishlaydimi?"], "ru": ["Твой брат работает в этом проекте?", "Твой брат работает на этом проекте?"], "tr": ["Senin erkek kardeşin bu projede çalışıyor mu?", "Abin bu projede çalışıyor mu?", "Kardeşin bu projede çalışıyor mu?", "Erkek kardeşin bu proje üzerinde çalışıyor mu?"] } }
