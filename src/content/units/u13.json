  "sentences": [
    { "id": "u13.s.01", "en": "What do you do?", "altEn": ["What is your job?"], "native": { "uz": "Sen nima ish qilasan?", "ru": "Чем ты занимаешься?", "tr": "Ne iş yapıyorsun?" }, "altNative": { "uz": ["Nima ish qilasan?", "Sen kim bo'lib ishlaysan?", "Kim bo'lib ishlaysan?"], "ru": ["Кем ты работаешь?", "Ты кем работаешь?", "Чем занимаешься?"], "tr": ["Sen ne iş yapıyorsun?", "Ne iş yaparsın?", "Mesleğin ne?"] } },
    { "id": "u13.s.02", "en": "I am an engineer.", "native": { "uz": "Men muhandisman.", "ru": "Я инженер.", "tr": "Ben mühendisim." }, "altNative": { "uz": ["Muhandisman."], "tr": ["Mühendisim.", "Ben bir mühendisim."] } },
    { "id": "u13.s.03", "en": "Where do you work?", "native": { "uz": "Sen qayerda ishlaysan?", "ru": "Где ты работаешь?", "tr": "Nerede çalışıyorsun?" }, "altNative": { "uz": ["Qayerda ishlaysan?"], "ru": ["Ты где работаешь?"], "tr": ["Sen nerede çalışıyorsun?"] } },
    { "id": "u13.s.04", "en": "What does he do?", "altEn": ["What is his job?"], "native": { "uz": "U nima ish qiladi?", "ru": "Чем он занимается?", "tr": "O ne iş yapıyor?" }, "altEnFor": { "uz": ["What does she do?", "What is her job?"], "tr": ["What does she do?", "What is her job?"] }, "altNative": { "uz": ["U kim bo'lib ishlaydi?"], "ru": ["Кем он работает?", "Он кем работает?"], "tr": ["Ne iş yapıyor?", "O ne iş yapar?"] } },
    { "id": "u13.s.05", "en": "He is a driver.", "native": { "uz": "U haydovchi.", "ru": "Он водитель.", "tr": "O bir şoför." }, "altEnFor": { "uz": ["She is a driver."], "tr": ["She is a driver."] }, "altNative": { "uz": ["U shofyor."], "ru": ["Он шофёр."], "tr": ["O şoför.", "O bir sürücü.", "O sürücü."] } },
    { "id": "u13.s.06", "en": "My sister is a nurse.", "native": { "uz": "Mening opam hamshira.", "ru": "Моя сестра — медсестра.", "tr": "Kız kardeşim hemşire." }, "altNative": { "uz": ["Opam hamshira.", "Mening singlim hamshira.", "Singlim hamshira."], "ru": ["Моя сестра работает медсестрой."], "tr": ["Benim kız kardeşim hemşire.", "Kız kardeşim bir hemşire.", "Ablam hemşire."] } },
    { "id": "u13.s.07", "en": "Is she a manager?", "native": { "uz": "U menejermi?", "ru": "Она менеджер?", "tr": "O bir müdür mü?" }, "altEnFor": { "uz": ["Is he a manager?"], "tr": ["Is he a manager?"] }, "altNative": { "uz": ["U boshqaruvchimi?"], "tr": ["O müdür mü?", "O bir yönetici mi?", "O yönetici mi?"] } },
    { "id": "u13.s.08", "en": "I like my job.", "native": { "uz": "Menga ishim yoqadi.", "ru": "Мне нравится моя работа.", "tr": "İşimi seviyorum." }, "altNative": { "uz": ["Men ishimni yoqtiraman.", "Men ishimni yaxshi ko'raman.", "Ishim menga yoqadi."], "ru": ["Я люблю свою работу.", "Мне нравится работа."], "tr": ["Ben işimi seviyorum.", "İşimi severim.", "Ben işimi severim."] } },

    { "id": "u13.s.09", "en": "I work in an office.", "native": { "uz": "Men ofisda ishlayman.", "ru": "Я работаю в офисе.", "tr": "Ben bir ofiste çalışıyorum." }, "altNative": { "uz": ["Ofisda ishlayman."], "tr": ["Bir ofiste çalışıyorum.", "Ben ofiste çalışıyorum.", "Ofiste çalışıyorum."] } },
    { "id": "u13.s.10", "en": "This is my colleague.", "native": { "uz": "Bu mening hamkasbim.", "ru": "Это мой коллега.", "tr": "Bu benim iş arkadaşım." }, "altNative": { "uz": ["Bu hamkasbim."], "ru": ["Это моя коллега."], "tr": ["Bu iş arkadaşım.", "Bu benim meslektaşım."] } },
    { "id": "u13.s.11", "en": "My boss is very kind.", "native": { "uz": "Mening boshlig'im juda mehribon.", "ru": "Мой начальник очень добрый.", "tr": "Patronum çok nazik." }, "altNative": { "uz": ["Boshlig'im juda mehribon."], "ru": ["Моя начальница очень добрая.", "Мой босс очень добрый."], "tr": ["Benim patronum çok nazik."] } },
    { "id": "u13.s.12", "en": "Do you have a computer?", "native": { "uz": "Senda kompyuter bormi?", "ru": "У тебя есть компьютер?", "tr": "Bilgisayarın var mı?" }, "altNative": { "uz": ["Sening kompyutering bormi?", "Kompyutering bormi?"], "tr": ["Senin bilgisayarın var mı?", "Bir bilgisayarın var mı?", "Senin bir bilgisayarın var mı?"] } },
    { "id": "u13.s.13", "en": "We work for a big company.", "altEn": ["We work in a big company.", "We work at a big company."], "native": { "uz": "Biz katta kompaniyada ishlaymiz.", "ru": "Мы работаем в большой компании.", "tr": "Biz büyük bir şirkette çalışıyoruz." }, "altNative": { "uz": ["Katta kompaniyada ishlaymiz.", "Biz katta bir kompaniyada ishlaymiz."], "ru": ["Мы работаем на большую компанию."], "tr": ["Büyük bir şirkette çalışıyoruz.", "Biz büyük bir şirket için çalışıyoruz."] } },
    { "id": "u13.s.14", "en": "I have a new email.", "native": { "uz": "Menda yangi elektron xat bor.", "ru": "У меня новое электронное письмо.", "tr": "Yeni bir e-postam var." }, "altNative": { "uz": ["Menga yangi elektron xat keldi.", "Menda yangi email bor."], "ru": ["У меня есть новое электронное письмо.", "У меня новый имейл.", "У меня новое письмо."], "tr": ["Benim yeni bir e-postam var.", "Yeni bir mailim var."] } },
