    { "id": "u03.s.37", "en": "I live with my parents.", "native": { "uz": "Men ota-onam bilan yashayman.", "ru": "Я живу с родителями.", "tr": "Ben ebeveynlerimle yaşıyorum." }, "altNative": { "ru": ["Я живу со своими родителями.", "Я живу с моими родителями."], "tr": ["Ebeveynlerimle yaşıyorum.", "Ailemle yaşıyorum.", "Annem ve babamla yaşıyorum."] } },
