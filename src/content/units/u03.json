    { "id": "u03.s.16", "en": "I love my sister.", "native": { "uz": "Men opamni sevaman.", "ru": "Я люблю свою сестру.", "tr": "Ben kız kardeşimi seviyorum." }, "altNative": { "uz": ["Men singlimni sevaman."], "ru": ["Я люблю мою сестру.", "Я люблю сестру."], "tr": ["Kız kardeşimi seviyorum.", "Ablamı seviyorum."] } },

    { "id": "u03.s.17", "en": "This is my son.", "native": { "uz": "Bu mening o'g'lim.", "ru": "Это мой сын.", "tr": "Bu benim oğlum." }, "altNative": { "uz": ["Bu o'g'lim."], "tr": ["Bu oğlum."] } },
    { "id": "u03.s.18", "en": "This is my daughter.", "native": { "uz": "Bu mening qizim.", "ru": "Это моя дочь.", "tr": "Bu benim kızım." }, "altNative": { "uz": ["Bu qizim."], "ru": ["Это моя дочка."], "tr": ["Bu kızım."] } },
