    { "id": "u03.s.20", "en": "My wife is a teacher.", "native": { "uz": "Mening xotinim o'qituvchi.", "ru": "Моя жена — учительница.", "tr": "Benim karım öğretmen." }, "altNative": { "uz": ["Xotinim o'qituvchi.", "Mening turmush o'rtog'im o'qituvchi.", "Mening rafiqam o'qituvchi."], "ru": ["Моя жена учитель."], "tr": ["Karım öğretmen.", "Eşim öğretmen.", "Karım bir öğretmen."] } },
    { "id": "u03.s.21", "en": "We have a son and a daughter.", "native": { "uz": "Bizning bir o'g'il va bir qizimiz bor.", "ru": "У нас есть сын и дочь.", "tr": "Bizim bir oğlumuz ve bir kızımız var." }, "altNative": { "uz": ["Bizning o'g'limiz va qizimiz bor.", "Bizning bir o'g'limiz va bir qizimiz bor."], "ru": ["У нас есть сын и дочка."], "tr": ["Bir oğlumuz ve bir kızımız var."] } },
    { "id": "u03.s.22", "en": "The children are at home.", "native": { "uz": "Bolalar uyda.", "ru": "Дети дома.", "tr": "Çocuklar evde." } },
    { "id": "u03.s.23", "en": "My family is at home.", "native": { "uz": "Mening oilam uyda.", "ru": "Моя семья дома.", "tr": "Benim ailem evde." }, "altNative": { "uz": ["Oilam uyda."], "tr": ["Ailem evde."] } },
