  "sentences": [
    { "id": "u03.s.01", "en": "This is my mother.", "native": { "uz": "Bu mening onam.", "ru": "Это моя мама.", "tr": "Bu benim annem." }, "altNative": { "uz": ["Bu onam."], "ru": ["Это моя мать."], "tr": ["Bu annem."] } },
    { "id": "u03.s.02", "en": "This is my father.", "native": { "uz": "Bu mening otam.", "ru": "Это мой папа.", "tr": "Bu benim babam." }, "altNative": { "uz": ["Bu otam."], "ru": ["Это мой отец."], "tr": ["Bu babam."] } },
    { "id": "u03.s.03", "en": "I love my family.", "native": { "uz": "Men oilamni sevaman.", "ru": "Я люблю свою семью.", "tr": "Ben ailemi seviyorum." }, "altNative": { "uz": ["Men o'z oilamni sevaman."], "ru": ["Я люблю мою семью."], "tr": ["Ailemi seviyorum."] } },
    { "id": "u03.s.04", "en": "I have a family.", "native": { "uz": "Mening oilam bor.", "ru": "У меня есть семья.", "tr": "Benim bir ailem var." }, "altNative": { "uz": ["Oilam bor."], "tr": ["Bir ailem var."] } },
    { "id": "u03.s.05", "en": "My mother is a teacher.", "native": { "uz": "Mening onam o'qituvchi.", "ru": "Моя мама — учительница.", "tr": "Benim annem öğretmen." }, "altNative": { "uz": ["Onam o'qituvchi."], "ru": ["Моя мама учитель."], "tr": ["Annem öğretmen.", "Annem bir öğretmen."] } },
    { "id": "u03.s.06", "en": "My father is a doctor.", "native": { "uz": "Mening otam shifokor.", "ru": "Мой папа — врач.", "tr": "Benim babam doktor." }, "altNative": { "uz": ["Otam shifokor."], "ru": ["Мой отец — врач."], "tr": ["Babam doktor.", "Babam bir doktor."] } },
    { "id": "u03.s.07", "en": "I love my mother and father.", "native": { "uz": "Men onam va otamni sevaman.", "ru": "Я люблю маму и папу.", "tr": "Ben annemi ve babamı seviyorum." }, "altNative": { "uz": ["Men onamni va otamni sevaman."], "ru": ["Я люблю свою маму и папу.", "Я люблю мою маму и папу."], "tr": ["Annemi ve babamı seviyorum."] } },
    { "id": "u03.s.08", "en": "This is our family.", "native": { "uz": "Bu bizning oilamiz.", "ru": "Это наша семья.", "tr": "Bu bizim ailemiz." } },

    { "id": "u03.s.09", "en": "I have a brother.", "native": { "uz": "Mening akam bor.", "ru": "У меня есть брат.", "tr": "Benim bir erkek kardeşim var." }, "altNative": { "uz": ["Mening ukam bor.", "Akam bor.", "Ukam bor."], "tr": ["Bir erkek kardeşim var.", "Benim bir abim var.", "Bir abim var."] } },
    { "id": "u03.s.10", "en": "I have a sister.", "native": { "uz": "Mening opam bor.", "ru": "У меня есть сестра.", "tr": "Benim bir kız kardeşim var." }, "altNative": { "uz": ["Mening singlim bor.", "Opam bor.", "Singlim bor."], "tr": ["Bir kız kardeşim var.", "Benim bir ablam var.", "Bir ablam var."] } },
    { "id": "u03.s.11", "en": "My brother is a student.", "native": { "uz": "Mening akam talaba.", "ru": "Мой брат — студент.", "tr": "Benim erkek kardeşim öğrenci." }, "altNative": { "uz": ["Mening ukam talaba.", "Akam talaba.", "Ukam talaba."], "tr": ["Erkek kardeşim öğrenci.", "Abim öğrenci.", "Erkek kardeşim bir öğrenci."] } },
    { "id": "u03.s.12", "en": "My sister has a baby.", "native": { "uz": "Mening opamning chaqalog'i bor.", "ru": "У моей сестры есть малыш.", "tr": "Kız kardeşimin bir bebeği var." }, "altNative": { "uz": ["Opamning chaqalog'i bor.", "Mening singlimning chaqalog'i bor.", "Singlimning chaqalog'i bor."], "ru": ["У моей сестры есть ребёнок."], "tr": ["Benim kız kardeşimin bir bebeği var.", "Ablamın bir bebeği var."] } },
    { "id": "u03.s.13", "en": "Our family is big.", "native": { "uz": "Bizning oilamiz katta.", "ru": "Наша семья большая.", "tr": "Bizim ailemiz büyük." }, "altNative": { "uz": ["Oilamiz katta."], "ru": ["У нас большая семья."], "tr": ["Ailemiz büyük."] } },
    { "id": "u03.s.14", "en": "The baby is very small.", "native": { "uz": "Chaqaloq juda kichik.", "ru": "Малыш очень маленький.", "tr": "Bebek çok küçük." }, "altNative": { "ru": ["Ребёнок очень маленький."] } },
