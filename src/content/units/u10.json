    { "id": "u10.s.22", "en": "I do not have any money.", "altEn": ["I have no money.", "I do not have money."], "native": { "uz": "Menda pul yo'q.", "ru": "У меня нет денег.", "tr": "Hiç param yok." }, "altNative": { "uz": ["Menda umuman pul yo'q.", "Menda hech qanday pul yo'q.", "Mening pulim yo'q.", "Pulim yo'q."], "ru": ["У меня денег нет.", "Денег у меня нет.", "У меня совсем нет денег."], "tr": ["Param yok.", "Benim hiç param yok.", "Benim param yok."] } },
    { "id": "u10.s.23", "en": "The jacket is seventy dollars, not sixty.", "altEn": ["The jacket costs seventy dollars, not sixty.", "The jacket is not sixty but seventy dollars.", "The jacket is not sixty dollars but seventy."], "native": { "uz": "Kurtka oltmish emas, yetmish dollar turadi.", "ru": "Куртка стоит семьдесят долларов, а не шестьдесят.", "tr": "Ceket altmış değil, yetmiş dolar." }, "altNative": { "uz": ["Kurtka yetmish dollar turadi, oltmish emas.", "Kurtka oltmish emas, yetmish dollar."], "ru": ["Куртка стоит не шестьдесят, а семьдесят долларов.", "Пиджак стоит семьдесят долларов, а не шестьдесят."], "tr": ["Ceket yetmiş dolar, altmış değil."] } },
    { "id": "u10.s.24", "en": "I only have one hundred dollars.", "altEn": ["I only have a hundred dollars.", "I have only one hundred dollars.", "I have only a hundred dollars."], "native": { "uz": "Menda faqat yuz dollar bor.", "ru": "У меня только сто долларов.", "tr": "Sadece yüz dolarım var." }, "altNative": { "uz": ["Menda atigi yuz dollar bor.", "Menda faqat bir yuz dollar bor.", "Mening faqat yuz dollarim bor.", "Faqat yuz dollarim bor."], "ru": ["У меня всего сто долларов.", "У меня есть только сто долларов."], "tr": ["Benim sadece yüz dolarım var.", "Yalnızca yüz dolarım var."] } },

    { "id": "u10.s.25", "en": "I need a jacket.", "native": { "uz": "Menga kurtka kerak.", "ru": "Мне нужна куртка.", "tr": "Bir cekete ihtiyacım var." }, "altNative": { "uz": ["Menga bitta kurtka kerak.", "Menga pidjak kerak."], "ru": ["Мне нужен пиджак."], "tr": ["Bana bir ceket lazım.", "Bana ceket lazım.", "Benim bir cekete ihtiyacım var.", "Cekete ihtiyacım var.", "Bir monta ihtiyacım var."] } },
    { "id": "u10.s.26", "en": "Can I try it on?", "altEn": ["Can I try this on?", "May I try it on?"], "native": { "uz": "Buni kiyib ko'rsam bo'ladimi?", "ru": "Можно это примерить?", "tr": "Bunu deneyebilir miyim?" }, "altNative": { "uz": ["Kiyib ko'rsam bo'ladimi?", "Uni kiyib ko'rsam bo'ladimi?", "Buni kiyib ko'rsam maylimi?", "Kiyib ko'rsam maylimi?", "Buni kiyib ko'ra olamanmi?"], "ru": ["Можно примерить?", "Могу я это примерить?", "Я могу это примерить?", "Можно его примерить?", "Можно её примерить?"], "tr": ["Deneyebilir miyim?", "Onu deneyebilir miyim?", "Bunu üzerimde deneyebilir miyim?"] } },
    { "id": "u10.s.27", "en": "Can I try on this dress?", "altEn": ["Can I try this dress on?", "May I try on this dress?"], "native": { "uz": "Bu ko'ylakni kiyib ko'rsam bo'ladimi?", "ru": "Можно примерить это платье?", "tr": "Bu elbiseyi deneyebilir miyim?" }, "altEnFor": { "uz": ["Can I try on this shirt?", "Can I try this shirt on?"] }, "altNative": { "uz": ["Bu ko'ylakni kiyib ko'rsam maylimi?", "Shu ko'ylakni kiyib ko'rsam bo'ladimi?", "Bu ko'ylakni kiyib ko'ra olamanmi?"], "ru": ["Можно мне примерить это платье?", "Могу я примерить это платье?", "Я могу примерить это платье?"], "tr": ["Bu elbiseyi üzerimde deneyebilir miyim?", "Ben bu elbiseyi deneyebilir miyim?"] } },
    { "id": "u10.s.28", "en": "What size do you need?", "native": { "uz": "Senga qaysi o'lcham kerak?", "ru": "Какой размер тебе нужен?", "tr": "Sana hangi beden lazım?" }, "altNative": { "uz": ["Qaysi o'lcham kerak?", "Senga qanday o'lcham kerak?", "Senga qaysi razmer kerak?", "Senga nechanchi o'lcham kerak?"], "ru": ["Какой тебе нужен размер?", "Тебе какой размер нужен?", "Какой размер вам нужен?"], "tr": ["Hangi beden lazım?", "Hangi bedene ihtiyacın var?", "Sana kaç beden lazım?", "Kaç beden lazım?"] } },
    { "id": "u10.s.29", "en": "I need a small size.", "native": { "uz": "Menga kichik o'lcham kerak.", "ru": "Мне нужен маленький размер.", "tr": "Bana küçük beden lazım." }, "altNative": { "uz": ["Menga kichik razmer kerak.", "Menga kichkina o'lcham kerak."], "tr": ["Küçük beden lazım.", "Bana küçük bir beden lazım.", "Küçük bedene ihtiyacım var.", "Küçük bir bedene ihtiyacım var."] } },
    { "id": "u10.s.30", "en": "Can I pay with a card?", "altEn": ["Can I pay by card?", "Can I pay with card?", "May I pay with a card?"], "native": { "uz": "Karta bilan to'lasam bo'ladimi?", "ru": "Можно заплатить картой?", "tr": "Kartla ödeyebilir miyim?" }, "altNative": { "uz": ["Karta orqali to'lasam bo'ladimi?", "Kartadan to'lasam bo'ladimi?", "Karta bilan to'lasam maylimi?", "Karta bilan to'lay olamanmi?"], "ru": ["Можно оплатить картой?", "Можно расплатиться картой?", "Можно платить картой?", "Могу я заплатить картой?", "Я могу заплатить картой?"], "tr": ["Kart ile ödeyebilir miyim?", "Kredi kartıyla ödeyebilir miyim?", "Kartla ödeme yapabilir miyim?"] } },
    { "id": "u10.s.31", "en": "I do not have cash, only a card.", "native": { "uz": "Menda naqd pul yo'q, faqat karta bor.", "ru": "У меня нет наличных, только карта.", "tr": "Nakit param yok, sadece kartım var." }, "altNative": { "uz": ["Menda naqd pul yo'q, faqat karta.", "Menda naqd yo'q, faqat karta bor.", "Naqd pulim yo'q, faqat kartam bor."], "ru": ["У меня нет наличных, есть только карта.", "Наличных у меня нет, только карта."], "tr": ["Nakitim yok, sadece kartım var.", "Nakit param yok, sadece kart var.", "Nakit yok, sadece kart var.", "Benim nakit param yok, sadece kartım var."] } },
    { "id": "u10.s.32", "en": "I always pay in cash.", "altEn": ["I always pay cash.", "I always pay with cash."], "native": { "uz": "Men doim naqd pul bilan to'layman.", "ru": "Я всегда плачу наличными.", "tr": "Ben her zaman nakit öderim." }, "altNative": { "uz": ["Men har doim naqd pul bilan to'layman.", "Men doimo naqd pul bilan to'layman.", "Doim naqd pul bilan to'layman.", "Men doim naqd to'layman."], "ru": ["Я всегда расплачиваюсь наличными."], "tr": ["Her zaman nakit öderim.", "Ben hep nakit öderim.", "Hep nakit öderim.", "Ben her zaman nakit ödüyorum.", "Her zaman nakit ödüyorum."] } },

    { "id": "u10.s.33", "en": "The market is closed today.", "altEn": ["Today the market is closed."], "native": { "uz": "Bugun bozor yopiq.", "ru": "Сегодня рынок закрыт.", "tr": "Pazar bugün kapalı." }, "altNative": { "uz": ["Bozor bugun yopiq."], "ru": ["Рынок сегодня закрыт.", "Сегодня базар закрыт."], "tr": ["Bugün pazar kapalı."] } },
    { "id": "u10.s.34", "en": "They sell cheap fruit at the market.", "altEn": ["They sell cheap fruit in the market."], "native": { "uz": "Bozorda arzon meva sotishadi.", "ru": "На рынке продают дешёвые фрукты.", "tr": "Pazarda ucuz meyve satıyorlar." }, "altNative": { "uz": ["Ular bozorda arzon meva sotishadi.", "Bozorda arzon mevalar sotishadi.", "Bozorda arzon meva sotiladi.", "Ular bozorda arzon meva sotadilar."], "ru": ["Они продают дешёвые фрукты на рынке.", "На рынке они продают дешёвые фрукты.", "На базаре продают дешёвые фрукты."], "tr": ["Onlar pazarda ucuz meyve satıyorlar.", "Pazarda ucuz meyve satarlar.", "Pazarda ucuz meyve satılıyor."] } },
    { "id": "u10.s.35", "en": "I want to buy a gift for Anna.", "native": { "uz": "Men Anna uchun sovg'a sotib olmoqchiman.", "ru": "Я хочу купить подарок для Анны.", "tr": "Anna için bir hediye almak istiyorum." }, "altNative": { "uz": ["Anna uchun sovg'a sotib olmoqchiman.", "Men Annaga sovg'a sotib olmoqchiman.", "Annaga sovg'a sotib olmoqchiman.", "Men Anna uchun sovg'a sotib olishni xohlayman."], "ru": ["Я хочу купить Анне подарок.", "Я хочу купить подарок Анне."], "tr": ["Ben Anna için bir hediye almak istiyorum.", "Anna için hediye almak istiyorum.", "Anna'ya bir hediye almak istiyorum.", "Anna için bir hediye satın almak istiyorum."] } },
    { "id": "u10.s.36", "en": "Is there a discount on this jacket?", "native": { "uz": "Bu kurtkaga chegirma bormi?", "ru": "На эту куртку есть скидка?", "tr": "Bu cekette indirim var mı?" }, "altNative": { "uz": ["Bu kurtka uchun chegirma bormi?", "Bu kurtkada chegirma bormi?", "Bu kurtkaga skidka bormi?"], "ru": ["Есть скидка на эту куртку?", "Есть ли скидка на эту куртку?", "На этот пиджак есть скидка?"], "tr": ["Bu ceket için indirim var mı?", "Bu cekete indirim var mı?", "Bu ceketin indirimi var mı?"] } },
    { "id": "u10.s.37", "en": "The dress is eighty dollars with the discount.", "altEn": ["With the discount the dress is eighty dollars.", "The dress is eighty dollars with a discount."], "native": { "uz": "Ko'ylak chegirma bilan sakson dollar turadi.", "ru": "Платье со скидкой стоит восемьдесят долларов.", "tr": "Elbise indirimle seksen dolar." }, "altEnFor": { "uz": ["The shirt is eighty dollars with the discount.", "With the discount the shirt is eighty dollars."] }, "altNative": { "uz": ["Chegirma bilan ko'ylak sakson dollar turadi.", "Ko'ylak chegirma bilan sakson dollar.", "Ko'ylak skidka bilan sakson dollar turadi."], "ru": ["Со скидкой платье стоит восемьдесят долларов.", "Платье стоит восемьдесят долларов со скидкой."], "tr": ["İndirimle elbise seksen dolar.", "Elbise indirimli seksen dolar.", "Elbise indirimle seksen dolar tutuyor."] } },
    { "id": "u10.s.38", "en": "Ninety dollars? That is very expensive!", "altEn": ["Ninety dollars? It is very expensive!", "Ninety dollars? This is very expensive!"], "native": { "uz": "To'qson dollar? Bu juda qimmat!", "ru": "Девяносто долларов? Это очень дорого!", "tr": "Doksan dolar mı? Bu çok pahalı!" }, "altNative": { "uz": ["To'qson dollarmi? Bu juda qimmat!", "To'qson dollar? Juda qimmat!"], "ru": ["Девяносто долларов? Очень дорого!"], "tr": ["Doksan dolar mı? Çok pahalı!", "Doksan dolar? Bu çok pahalı!", "Doksan dolar mı? O çok pahalı!"] } },
    { "id": "u10.s.39", "en": "Sorry, we do not sell gifts here.", "native": { "uz": "Kechirasiz, biz bu yerda sovg'a sotmaymiz.", "ru": "Извините, мы здесь не продаём подарки.", "tr": "Üzgünüm, burada hediye satmıyoruz." }, "altNative": { "uz": ["Kechirasiz, bu yerda sovg'a sotmaymiz.", "Kechirasiz, biz shu yerda sovg'a sotmaymiz.", "Kechirasiz, biz bu yerda sovg'alar sotmaymiz.", "Uzr, biz bu yerda sovg'a sotmaymiz."], "ru": ["Извините, мы не продаём здесь подарки.", "Извините, здесь мы не продаём подарки.", "Извините, мы тут не продаём подарки.", "Простите, мы здесь не продаём подарки.", "Извини, мы здесь не продаём подарки."], "tr": ["Özür dilerim, burada hediye satmıyoruz.", "Üzgünüm, biz burada hediye satmıyoruz.", "Kusura bakmayın, burada hediye satmıyoruz."] } },
    { "id": "u10.s.40", "en": "Is the market closed on the weekend?", "altEn": ["Is the market closed at the weekend?", "Is the market closed on weekends?"], "native": { "uz": "Bozor dam olish kunlari yopiqmi?", "ru": "Рынок закрыт по выходным?", "tr": "Pazar hafta sonu kapalı mı?" }, "altNative": { "uz": ["Dam olish kunlari bozor yopiqmi?", "Bozor dam olish kunlarida yopiqmi?", "Bozor hafta oxirida yopiqmi?"], "ru": ["Рынок закрыт в выходные?", "В выходные рынок закрыт?", "По выходным рынок закрыт?", "Базар закрыт по выходным?"], "tr": ["Hafta sonu pazar kapalı mı?", "Pazar hafta sonları kapalı mı?", "Hafta sonları pazar kapalı mı?"] } }
