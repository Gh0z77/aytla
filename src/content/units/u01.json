  "sentences": [
    { "id": "u01.s.01", "en": "Hello!", "native": { "uz": "Salom!", "ru": "Привет!", "tr": "Merhaba!" } },
    { "id": "u01.s.02", "en": "Goodbye!", "native": { "uz": "Xayr!", "ru": "Пока!", "tr": "Hoşça kal!" } },
    { "id": "u01.s.03", "en": "Yes, please.", "native": { "uz": "Ha, iltimos.", "ru": "Да, пожалуйста.", "tr": "Evet, lütfen." } },
    { "id": "u01.s.04", "en": "No, thanks.", "native": { "uz": "Yo'q, rahmat.", "ru": "Нет, спасибо.", "tr": "Hayır, teşekkürler." } },
    { "id": "u01.s.05", "en": "Hello and goodbye.", "native": { "uz": "Salom va xayr.", "ru": "Привет и пока.", "tr": "Merhaba ve hoşça kal." } },
    { "id": "u01.s.06", "en": "Yes and no.", "native": { "uz": "Ha va yo'q.", "ru": "Да и нет.", "tr": "Evet ve hayır." } },
    { "id": "u01.s.07", "en": "Thanks, goodbye!", "native": { "uz": "Rahmat, xayr!", "ru": "Спасибо, пока!", "tr": "Teşekkürler, hoşça kal!" } },
    { "id": "u01.s.08", "en": "Please and thanks.", "native": { "uz": "Iltimos va rahmat.", "ru": "Пожалуйста и спасибо.", "tr": "Lütfen ve teşekkürler." } },

    { "id": "u01.s.09", "en": "Good morning!", "native": { "uz": "Xayrli tong!", "ru": "Доброе утро!", "tr": "Günaydın!" } },
    { "id": "u01.s.10", "en": "Good evening!", "native": { "uz": "Xayrli kech!", "ru": "Добрый вечер!", "tr": "İyi akşamlar!" } },
    { "id": "u01.s.11", "en": "Good night!", "native": { "uz": "Xayrli tun!", "ru": "Спокойной ночи!", "tr": "İyi geceler!" } },
    { "id": "u01.s.12", "en": "Hello, my friend!", "native": { "uz": "Salom, do'stim!", "ru": "Привет, мой друг!", "tr": "Merhaba, arkadaşım!" } },
    { "id": "u01.s.13", "en": "Good morning, my friend!", "native": { "uz": "Xayrli tong, do'stim!", "ru": "Доброе утро, мой друг!", "tr": "Günaydın, arkadaşım!" } },
    { "id": "u01.s.14", "en": "Good night, my friend.", "native": { "uz": "Xayrli tun, do'stim.", "ru": "Спокойной ночи, мой друг.", "tr": "İyi geceler, arkadaşım." } },
    { "id": "u01.s.15", "en": "Good evening and goodbye.", "native": { "uz": "Xayrli kech va xayr.", "ru": "Добрый вечер и пока.", "tr": "İyi akşamlar ve hoşça kal." } },
    { "id": "u01.s.16", "en": "Thanks, my friend!", "native": { "uz": "Rahmat, do'stim!", "ru": "Спасибо, мой друг!", "tr": "Teşekkürler, arkadaşım!" } },

    { "id": "u01.s.17", "en": "How are you?", "native": { "uz": "Qalaysan?", "ru": "Как дела?", "tr": "Nasılsın?" }, "altNative": { "uz": ["Qandaysan?", "Ahvoling qanday?"], "ru": ["Как ты?"] } },
    { "id": "u01.s.18", "en": "I am great!", "altEn": ["I'm great!"], "native": { "uz": "Men zo'rman!", "ru": "У меня всё отлично!", "tr": "Ben harikayım!" } },
    { "id": "u01.s.19", "en": "I am happy.", "native": { "uz": "Men xursandman.", "ru": "Я счастлив.", "tr": "Ben mutluyum." }, "altNative": { "ru": ["Я счастлива."] } },
    { "id": "u01.s.20", "en": "I am tired.", "native": { "uz": "Men charchadim.", "ru": "Я устал.", "tr": "Ben yorgunum." }, "altNative": { "ru": ["Я устала."], "uz": ["Men charchaganman."] } },
    { "id": "u01.s.21", "en": "Are you happy?", "native": { "uz": "Sen xursandmisan?", "ru": "Ты счастлив?", "tr": "Sen mutlu musun?" }, "altNative": { "ru": ["Ты счастлива?"] } },
    { "id": "u01.s.22", "en": "Are you tired?", "native": { "uz": "Sen charchadingmi?", "ru": "Ты устал?", "tr": "Sen yorgun musun?" }, "altNative": { "ru": ["Ты устала?"] } },
    { "id": "u01.s.23", "en": "I am great, thanks!", "native": { "uz": "Men zo'rman, rahmat!", "ru": "У меня всё отлично, спасибо!", "tr": "Ben harikayım, teşekkürler!" } },
    { "id": "u01.s.24", "en": "Hello! How are you?", "native": { "uz": "Salom! Qalaysan?", "ru": "Привет! Как дела?", "tr": "Merhaba! Nasılsın?" } },

    { "id": "u01.s.25", "en": "Welcome!", "native": { "uz": "Xush kelibsiz!", "ru": "Добро пожаловать!", "tr": "Hoş geldiniz!" } },
    { "id": "u01.s.26", "en": "I am sorry.", "native": { "uz": "Kechirasiz.", "ru": "Извините.", "tr": "Özür dilerim." }, "altNative": { "uz": ["Uzr."], "ru": ["Простите."] } },
    { "id": "u01.s.27", "en": "I am very happy.", "native": { "uz": "Men juda xursandman.", "ru": "Я очень счастлив.", "tr": "Ben çok mutluyum." }, "altNative": { "ru": ["Я очень счастлива."] } },
    { "id": "u01.s.28", "en": "I am very tired.", "native": { "uz": "Men juda charchadim.", "ru": "Я очень устал.", "tr": "Ben çok yorgunum." }, "altNative": { "ru": ["Я очень устала."] } },
    { "id": "u01.s.29", "en": "Are you sad?", "native": { "uz": "Sen xafamisan?", "ru": "Тебе грустно?", "tr": "Sen üzgün müsün?" } },
    { "id": "u01.s.30", "en": "I am sad too.", "native": { "uz": "Men ham xafaman.", "ru": "Мне тоже грустно.", "tr": "Ben de üzgünüm." } },
    { "id": "u01.s.31", "en": "Okay, thanks!", "native": { "uz": "Mayli, rahmat!", "ru": "Ладно, спасибо!", "tr": "Tamam, teşekkürler!" } },
    { "id": "u01.s.32", "en": "Welcome, my friend!", "native": { "uz": "Xush kelibsiz, do'stim!", "ru": "Добро пожаловать, мой друг!", "tr": "Hoş geldin, arkadaşım!" } },

    { "id": "u01.s.33", "en": "See you tomorrow!", "native": { "uz": "Ertaga ko'rishguncha!", "ru": "До завтра!", "tr": "Yarın görüşürüz!" } },
    { "id": "u01.s.34", "en": "See you later!", "native": { "uz": "Keyinroq ko'rishguncha!", "ru": "Увидимся позже!", "tr": "Sonra görüşürüz!" } },
    { "id": "u01.s.35", "en": "See you soon!", "native": { "uz": "Tez orada ko'rishguncha!", "ru": "До скорой встречи!", "tr": "Yakında görüşürüz!" } },
    { "id": "u01.s.36", "en": "I am happy today.", "native": { "uz": "Men bugun xursandman.", "ru": "Сегодня я счастлив.", "tr": "Ben bugün mutluyum." }, "altNative": { "ru": ["Сегодня я счастлива.", "Я сегодня счастлив.", "Я сегодня счастлива."], "uz": ["Bugun men xursandman."], "tr": ["Bugün ben mutluyum."] } },
    { "id": "u01.s.37", "en": "Are you tired now?", "native": { "uz": "Sen hozir charchadingmi?", "ru": "Ты сейчас устал?", "tr": "Sen şimdi yorgun musun?" }, "altNative": { "ru": ["Ты сейчас устала?"] } },
    { "id": "u01.s.38", "en": "Good night! See you tomorrow.", "native": { "uz": "Xayrli tun! Ertaga ko'rishguncha.", "ru": "Спокойной ночи! До завтра.", "tr": "İyi geceler! Yarın görüşürüz." } },
    { "id": "u01.s.39", "en": "Goodbye, see you soon!", "native": { "uz": "Xayr, tez orada ko'rishguncha!", "ru": "Пока, до скорой встречи!", "tr": "Hoşça kal, yakında görüşürüz!" } },
    { "id": "u01.s.40", "en": "How are you today?", "native": { "uz": "Bugun qalaysan?", "ru": "Как дела сегодня?", "tr": "Bugün nasılsın?" }, "altNative": { "uz": ["Bugun qandaysan?"], "ru": ["Как ты сегодня?"] } }
  ],
