  "sentences": [
    { "id": "u19.s.01", "en": "Your passport, please.", "native": { "uz": "Pasportingiz, iltimos.", "ru": "Ваш паспорт, пожалуйста.", "tr": "Pasaportunuz, lütfen." } },
    { "id": "u19.s.02", "en": "Here is my visa.", "native": { "uz": "Mana mening vizam.", "ru": "Вот моя виза.", "tr": "İşte vizem." }, "altNative": { "uz": ["Mana vizam."], "tr": ["İşte benim vizem."] } },
    { "id": "u19.s.03", "en": "What is the purpose of your visit?", "native": { "uz": "Tashrifingizdan maqsad nima?", "ru": "Какова цель вашего визита?", "tr": "Ziyaretinizin amacı nedir?" } },
    { "id": "u19.s.04", "en": "I am here for tourism.", "native": { "uz": "Men bu yerga turizm uchun keldim.", "ru": "Я здесь с целью туризма.", "tr": "Turizm için buradayım." } },
    { "id": "u19.s.05", "en": "I am here on business.", "native": { "uz": "Men bu yerga biznes bo'yicha keldim.", "ru": "Я здесь по делам бизнеса.", "tr": "İş için buradayım." }, "altNative": { "uz": ["Men bu yerga ish bo'yicha keldim."], "ru": ["Я здесь по делам."] } },
    { "id": "u19.s.06", "en": "The officer is at the border.", "native": { "uz": "Xodim chegarada.", "ru": "Сотрудник на границе.", "tr": "Görevli sınırda." } },
    { "id": "u19.s.07", "en": "I have a tourist visa.", "native": { "uz": "Menda turistik viza bor.", "ru": "У меня туристическая виза.", "tr": "Turist vizem var." } },
    { "id": "u19.s.08", "en": "Is this the border?", "native": { "uz": "Bu chegarami?", "ru": "Это граница?", "tr": "Burası sınır mı?" } },

    { "id": "u19.s.09", "en": "How long is your stay?", "native": { "uz": "Qancha vaqt qolasiz?", "ru": "Как долго вы пробудете?", "tr": "Ne kadar kalacaksınız?" } },
    { "id": "u19.s.10", "en": "For one week.", "native": { "uz": "Bir haftaga.", "ru": "На одну неделю.", "tr": "Bir haftalığına." } },
    { "id": "u19.s.11", "en": "For two months.", "native": { "uz": "Ikki oyga.", "ru": "На два месяца.", "tr": "İki aylığına." } },
    { "id": "u19.s.12", "en": "I have a return ticket.", "native": { "uz": "Menda qaytish chiptasi bor.", "ru": "У меня есть обратный билет.", "tr": "Dönüş biletim var." } },
    { "id": "u19.s.13", "en": "What is your address here?", "native": { "uz": "Bu yerdagi manzilingiz qanday?", "ru": "Какой у вас здесь адрес?", "tr": "Buradaki adresiniz nedir?" } },
    { "id": "u19.s.14", "en": "This is my invitation.", "native": { "uz": "Bu mening taklifnomam.", "ru": "Это моё приглашение.", "tr": "Bu benim davetiyem." } },
    { "id": "u19.s.15", "en": "Please fill in this form.", "native": { "uz": "Iltimos, bu anketani to'ldiring.", "ru": "Пожалуйста, заполните эту анкету.", "tr": "Lütfen bu formu doldurun." } },
    { "id": "u19.s.16", "en": "The address is on the form.", "native": { "uz": "Manzil anketada.", "ru": "Адрес в анкете.", "tr": "Adres formda." } },

    { "id": "u19.s.17", "en": "Where is customs?", "native": { "uz": "Bojxona qayerda?", "ru": "Где таможня?", "tr": "Gümrük nerede?" } },
    { "id": "u19.s.18", "en": "I have nothing to declare.", "native": { "uz": "Deklaratsiya qiladigan narsam yo'q.", "ru": "Мне нечего декларировать.", "tr": "Beyan edecek bir şeyim yok." } },
    { "id": "u19.s.19", "en": "Please open your bag.", "native": { "uz": "Iltimos, sumkangizni oching.", "ru": "Пожалуйста, откройте сумку.", "tr": "Lütfen çantanızı açın." }, "altNative": { "ru": ["Пожалуйста, откройте вашу сумку."] } },
    { "id": "u19.s.20", "en": "I have some cash.", "native": { "uz": "Menda biroz naqd pul bor.", "ru": "У меня есть немного наличных.", "tr": "Biraz nakitim var." } },
    { "id": "u19.s.21", "en": "This is a gift for my friend.", "native": { "uz": "Bu do'stim uchun sovg'a.", "ru": "Это подарок для моего друга.", "tr": "Bu arkadaşım için bir hediye." }, "altNative": { "ru": ["Это подарок для моей подруги."] } },
    { "id": "u19.s.22", "en": "This is my medicine.", "native": { "uz": "Bu mening dorim.", "ru": "Это моё лекарство.", "tr": "Bu benim ilacım." } },
    { "id": "u19.s.23", "en": "Do you have cash?", "native": { "uz": "Sizda naqd pul bormi?", "ru": "У вас есть наличные?", "tr": "Nakitiniz var mı?" } },
    { "id": "u19.s.24", "en": "The gift is in my bag.", "native": { "uz": "Sovg'a sumkamda.", "ru": "Подарок в моей сумке.", "tr": "Hediye çantamda." } },

    { "id": "u19.s.25", "en": "Where is baggage claim?", "native": { "uz": "Bagaj olish joyi qayerda?", "ru": "Где выдача багажа?", "tr": "Bagaj teslim nerede?" } },
    { "id": "u19.s.26", "en": "My bag is missing.", "native": { "uz": "Sumkam yo'qolgan.", "ru": "Моя сумка пропала.", "tr": "Çantam kayıp." } },
    { "id": "u19.s.27", "en": "I have a problem.", "native": { "uz": "Menda muammo bor.", "ru": "У меня проблема.", "tr": "Bir sorunum var." } },
    { "id": "u19.s.28", "en": "Where is the information desk?", "native": { "uz": "Ma'lumot byurosi qayerda?", "ru": "Где справочная?", "tr": "Danışma nerede?" } },
    { "id": "u19.s.29", "en": "Here is my phone number.", "native": { "uz": "Mana mening telefon raqamim.", "ru": "Вот мой номер телефона.", "tr": "İşte telefon numaram." } },
    { "id": "u19.s.30", "en": "Please find my bag.", "native": { "uz": "Iltimos, sumkamni toping.", "ru": "Пожалуйста, найдите мою сумку.", "tr": "Lütfen çantamı bulun." } },
    { "id": "u19.s.31", "en": "What is your phone number?", "native": { "uz": "Telefon raqamingiz qanday?", "ru": "Какой у вас номер телефона?", "tr": "Telefon numaranız nedir?" } },
    { "id": "u19.s.32", "en": "It is not a big problem.", "native": { "uz": "Bu katta muammo emas.", "ru": "Это не большая проблема.", "tr": "Bu büyük bir sorun değil." } },

    { "id": "u19.s.33", "en": "Where can I exchange money?", "native": { "uz": "Pulni qayerda almashtirsam bo'ladi?", "ru": "Где можно обменять деньги?", "tr": "Nerede para bozdurabilirim?" } },
    { "id": "u19.s.34", "en": "I need a SIM card.", "native": { "uz": "Menga SIM karta kerak.", "ru": "Мне нужна сим-карта.", "tr": "Bir SIM karta ihtiyacım var." } },
    { "id": "u19.s.35", "en": "Do you have a charger?", "native": { "uz": "Sizda quvvatlagich bormi?", "ru": "У вас есть зарядка?", "tr": "Şarj aletiniz var mı?" } },
    { "id": "u19.s.36", "en": "Is there Wi-Fi here?", "native": { "uz": "Bu yerda Wi-Fi bormi?", "ru": "Здесь есть Wi-Fi?", "tr": "Burada Wi-Fi var mı?" } },
    { "id": "u19.s.37", "en": "What is the password?", "native": { "uz": "Parol qanday?", "ru": "Какой пароль?", "tr": "Şifre nedir?" } },
    { "id": "u19.s.38", "en": "This is an emergency.", "native": { "uz": "Bu favqulodda holat.", "ru": "Это экстренный случай.", "tr": "Bu acil bir durum." } },
    { "id": "u19.s.39", "en": "The Wi-Fi password is on the wall.", "native": { "uz": "Wi-Fi paroli devorda.", "ru": "Пароль от Wi-Fi на стене.", "tr": "Wi-Fi şifresi duvarda." } },
    { "id": "u19.s.40", "en": "I need help, please.", "native": { "uz": "Menga yordam kerak, iltimos.", "ru": "Мне нужна помощь, пожалуйста.", "tr": "Yardıma ihtiyacım var, lütfen." } }
  ],
