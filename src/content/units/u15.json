  "sentences": [
    { "id": "u15.s.01", "en": "I travel by train.", "native": { "uz": "Men poyezdda sayohat qilaman.", "ru": "Я путешествую на поезде.", "tr": "Ben trenle seyahat ediyorum." }, "altNative": { "uz": ["Poyezdda sayohat qilaman.", "Men poyezd bilan sayohat qilaman."], "ru": ["Я путешествую поездом.", "Я езжу на поезде."], "tr": ["Trenle seyahat ediyorum.", "Ben trenle seyahat ederim.", "Trenle seyahat ederim."] } },
    { "id": "u15.s.02", "en": "By train or by plane?", "native": { "uz": "Poyezddami yoki samolyotdami?", "ru": "На поезде или на самолёте?", "tr": "Trenle mi, uçakla mı?" }, "altNative": { "uz": ["Poyezdda yoki samolyotdami?", "Poyezdda yoki samolyotda?", "Poyezd bilanmi yoki samolyot bilanmi?"], "ru": ["На поезде или самолёте?", "Поездом или самолётом?"], "tr": ["Trenle mi yoksa uçakla mı?"] } },
    { "id": "u15.s.03", "en": "I don't have a ticket.", "native": { "uz": "Menda chipta yo'q.", "ru": "У меня нет билета.", "tr": "Biletim yok." }, "altNative": { "uz": ["Mening chiptam yo'q.", "Chiptam yo'q.", "Menda bilet yo'q."], "tr": ["Benim biletim yok.", "Bir biletim yok."] } },
    { "id": "u15.s.04", "en": "We go by plane.", "native": { "uz": "Biz samolyotda boramiz.", "ru": "Мы летим на самолёте.", "tr": "Biz uçakla gidiyoruz." }, "altNative": { "uz": ["Samolyotda boramiz.", "Biz samolyot bilan boramiz.", "Biz samolyotda uchamiz."], "ru": ["Мы летим самолётом.", "Мы летаем на самолёте."], "tr": ["Uçakla gidiyoruz.", "Biz uçakla gideriz.", "Uçakla gideriz."] } },
    { "id": "u15.s.05", "en": "Do you like to travel?", "altEn": ["Do you like traveling?", "Do you like travelling?"], "native": { "uz": "Sen sayohat qilishni yoqtirasanmi?", "ru": "Ты любишь путешествовать?", "tr": "Seyahat etmeyi sever misin?" }, "altNative": { "uz": ["Sayohat qilishni yoqtirasanmi?", "Senga sayohat qilish yoqadimi?"], "ru": ["Тебе нравится путешествовать?"], "tr": ["Sen seyahat etmeyi sever misin?", "Seyahat etmeyi seviyor musun?"] } },
    { "id": "u15.s.06", "en": "Have a good trip!", "altEn": ["Have a nice trip!", "Have a safe trip!", "Have a great trip!"], "native": { "uz": "Safaring bexatar bo'lsin!", "ru": "Хорошей поездки!", "tr": "İyi yolculuklar!" }, "altNative": { "uz": ["Oq yo'l!", "Yaxshi safar!", "Safaringiz bexatar bo'lsin!", "Yo'ling bexatar bo'lsin!", "Yo'ling bo'lsin!", "Safaring xayrli bo'lsin!"], "ru": ["Счастливого пути!", "Удачной поездки!", "Приятной поездки!"], "tr": ["Hayırlı yolculuklar!"] } },
    { "id": "u15.s.07", "en": "Where is my ticket?", "native": { "uz": "Mening chiptam qayerda?", "ru": "Где мой билет?", "tr": "Biletim nerede?" }, "altNative": { "uz": ["Chiptam qayerda?", "Mening biletim qayerda?"], "tr": ["Benim biletim nerede?"] } },
    { "id": "u15.s.08", "en": "Our trip starts today.", "native": { "uz": "Bizning safarimiz bugun boshlanadi.", "ru": "Наша поездка начинается сегодня.", "tr": "Yolculuğumuz bugün başlıyor." }, "altNative": { "uz": ["Safarimiz bugun boshlanadi.", "Bugun safarimiz boshlanadi.", "Bizning sayohatimiz bugun boshlanadi."], "ru": ["Сегодня начинается наша поездка.", "Наше путешествие начинается сегодня."], "tr": ["Bizim yolculuğumuz bugün başlıyor.", "Gezimiz bugün başlıyor.", "Seyahatimiz bugün başlıyor."] } },

    { "id": "u15.s.09", "en": "Where is the airport?", "native": { "uz": "Aeroport qayerda?", "ru": "Где аэропорт?", "tr": "Havalimanı nerede?" }, "altNative": { "ru": ["Где находится аэропорт?"], "tr": ["Havaalanı nerede?"] } },
    { "id": "u15.s.10", "en": "Here is my passport.", "native": { "uz": "Mana mening pasportim.", "ru": "Вот мой паспорт.", "tr": "İşte pasaportum." }, "altNative": { "uz": ["Mana pasportim."], "tr": ["İşte benim pasaportum.", "Buyur, pasaportum."] } },
    { "id": "u15.s.11", "en": "Your passport and ticket, please.", "native": { "uz": "Pasporting va chiptang, iltimos.", "ru": "Твой паспорт и билет, пожалуйста.", "tr": "Pasaportun ve biletin, lütfen." }, "altNative": { "uz": ["Iltimos, pasporting va chiptang.", "Sening pasporting va chiptang, iltimos.", "Pasporting bilan chiptang, iltimos."], "ru": ["Пожалуйста, твой паспорт и билет."], "tr": ["Lütfen pasaportun ve biletin.", "Senin pasaportun ve biletin, lütfen."] } },
    { "id": "u15.s.12", "en": "My flight to London is at seven.", "altEn": ["My flight to London is at seven o'clock."], "native": { "uz": "Mening Londonga reysim soat yettida.", "ru": "Мой рейс в Лондон в семь.", "tr": "Londra uçuşum saat yedide." }, "altNative": { "uz": ["Londonga reysim soat yettida.", "Mening Londonga reysim yettida.", "Mening Londonga parvozim soat yettida."], "ru": ["Мой рейс в Лондон в семь часов.", "Мой рейс до Лондона в семь."], "tr": ["Londra'ya uçuşum saat yedide.", "Benim Londra uçuşum saat yedide.", "Londra uçuşum yedide.", "Londra uçağım saat yedide."] } },
    { "id": "u15.s.13", "en": "Where is gate five?", "altEn": ["Where is gate 5?"], "native": { "uz": "Beshinchi chiqish eshigi qayerda?", "ru": "Где выход номер пять?", "tr": "Beş numaralı biniş kapısı nerede?" }, "altNative": { "uz": ["Beshinchi chiqish qayerda?", "5-chiqish qayerda?", "Beshinchi geyt qayerda?"], "ru": ["Где пятый выход?", "Где выход на посадку номер пять?", "Где пятый выход на посадку?", "Где гейт номер пять?"], "tr": ["Beş numaralı kapı nerede?", "Beşinci kapı nerede?", "5 numaralı kapı nerede?"] } },
    { "id": "u15.s.14", "en": "My luggage is not here.", "native": { "uz": "Mening bagajim bu yerda emas.", "ru": "Моего багажа здесь нет.", "tr": "Bagajım burada değil." }, "altNative": { "uz": ["Bagajim bu yerda emas.", "Mening bagajim bu yerda yo'q.", "Bagajim bu yerda yo'q.", "Mening bagajim shu yerda emas.", "Mening yukim bu yerda emas."], "ru": ["Мой багаж не здесь.", "Моего багажа тут нет."], "tr": ["Benim bagajım burada değil.", "Bagajım burada yok."] } },
    { "id": "u15.s.15", "en": "Is this seat free?", "native": { "uz": "Bu o'rindiq bo'shmi?", "ru": "Это место свободно?", "tr": "Bu koltuk boş mu?" }, "altNative": { "uz": ["Bu joy bo'shmi?", "Bu o'rin bo'shmi?"], "ru": ["Это место свободное?", "Здесь свободно?"], "tr": ["Bu yer boş mu?"] } },
    { "id": "u15.s.16", "en": "Is there a delay?", "native": { "uz": "Kechikish bormi?", "ru": "Есть задержка?", "tr": "Gecikme var mı?" }, "altNative": { "ru": ["Задержка есть?", "Есть ли задержка?"], "tr": ["Rötar var mı?", "Bir gecikme var mı?"] } },

    { "id": "u15.s.17", "en": "I have a reservation.", "native": { "uz": "Menda bron bor.", "ru": "У меня есть бронь.", "tr": "Rezervasyonum var." }, "altNative": { "uz": ["Mening bronim bor.", "Men xona band qilganman."], "ru": ["У меня бронь.", "У меня есть бронирование.", "У меня забронировано."], "tr": ["Benim rezervasyonum var.", "Bir rezervasyonum var."] } },
    { "id": "u15.s.18", "en": "We want a double room, please.", "native": { "uz": "Biz ikki kishilik xona xohlaymiz, iltimos.", "ru": "Мы хотим двухместный номер, пожалуйста.", "tr": "Çift kişilik bir oda istiyoruz, lütfen." }, "altNative": { "uz": ["Ikki kishilik xona xohlaymiz, iltimos.", "Bizga ikki kishilik xona kerak, iltimos.", "Iltimos, biz ikki kishilik xona xohlaymiz."], "ru": ["Нам двухместный номер, пожалуйста.", "Мы хотим номер на двоих, пожалуйста."], "tr": ["Biz çift kişilik bir oda istiyoruz, lütfen.", "Çift kişilik oda istiyoruz, lütfen.", "İki kişilik bir oda istiyoruz, lütfen.", "Lütfen çift kişilik bir oda istiyoruz."] } },
    { "id": "u15.s.19", "en": "Can we stay here for three nights?", "altEn": ["Can we stay here three nights?", "Can we stay for three nights here?"], "native": { "uz": "Bu yerda uch kecha qolsak bo'ladimi?", "ru": "Мы можем остаться здесь на три ночи?", "tr": "Burada üç gece kalabilir miyiz?" }, "altNative": { "uz": ["Biz bu yerda uch kecha qolsak bo'ladimi?", "Bu yerda uch kecha qola olamizmi?", "Biz bu yerda uch kecha qola olamizmi?", "Shu yerda uch kecha qolsak bo'ladimi?", "Bu yerda uch kechaga qolsak bo'ladimi?", "Bu yerda uch kecha qolishimiz mumkinmi?"], "ru": ["Можно нам остаться здесь на три ночи?", "Можно остаться здесь на три ночи?", "Можем мы остаться здесь на три ночи?", "Мы можем остановиться здесь на три ночи?", "Можно нам остановиться здесь на три ночи?"], "tr": ["Biz burada üç gece kalabilir miyiz?", "Üç gece burada kalabilir miyiz?", "Burada üç geceliğine kalabilir miyiz?"] } },
    { "id": "u15.s.20", "en": "Here is your key.", "native": { "uz": "Mana sening kaliting.", "ru": "Вот твой ключ.", "tr": "İşte anahtarın." }, "altNative": { "uz": ["Mana kaliting."], "tr": ["İşte senin anahtarın.", "Buyur, anahtarın."] } },
    { "id": "u15.s.21", "en": "Where can I check in?", "native": { "uz": "Qayerda ro'yxatdan o'tsam bo'ladi?", "ru": "Где я могу зарегистрироваться?", "tr": "Nerede check-in yapabilirim?" }, "altNative": { "uz": ["Men qayerda ro'yxatdan o'ta olaman?", "Qayerda ro'yxatdan o'ta olaman?", "Qayerda ro'yxatdan o'tish mumkin?"], "ru": ["Где можно зарегистрироваться?", "Где мне зарегистрироваться?", "Где я могу заселиться?"], "tr": ["Ben nerede check-in yapabilirim?", "Check-in'i nerede yapabilirim?", "Nerede giriş yapabilirim?"] } },
    { "id": "u15.s.22", "en": "My suitcase is not in the room.", "native": { "uz": "Mening chamadonim xonada emas.", "ru": "Моего чемодана нет в номере.", "tr": "Bavulum odada değil." }, "altNative": { "uz": ["Chamadonim xonada emas.", "Mening chamadonim xonada yo'q.", "Chamadonim xonada yo'q."], "ru": ["Мой чемодан не в номере.", "Моего чемодана нет в комнате.", "Мой чемодан не в комнате."], "tr": ["Benim bavulum odada değil.", "Bavulum odada yok.", "Valizim odada değil."] } },
    { "id": "u15.s.23", "en": "Is there a double room for tonight?", "native": { "uz": "Bugun kechaga ikki kishilik xona bormi?", "ru": "Есть двухместный номер на сегодня?", "tr": "Bu gece için çift kişilik oda var mı?" }, "altNative": { "uz": ["Bugun kechqurunga ikki kishilik xona bormi?", "Bugun tunga ikki kishilik xona bormi?", "Bu kechaga ikki kishilik xona bormi?"], "ru": ["Есть двухместный номер на эту ночь?", "Есть ли двухместный номер на сегодня?", "Есть двухместный номер на сегодняшнюю ночь?", "Есть номер на двоих на сегодня?"], "tr": ["Bu gece için çift kişilik bir oda var mı?", "Bu geceye çift kişilik oda var mı?", "Bu gece için iki kişilik oda var mı?"] } },
    { "id": "u15.s.24", "en": "The reservation is in my name.", "native": { "uz": "Bron mening nomimga qilingan.", "ru": "Бронь на моё имя.", "tr": "Rezervasyon benim adıma." }, "altNative": { "uz": ["Bron mening nomimga.", "Bron mening ismimga qilingan.", "Bron mening nomimda."], "ru": ["Бронирование на моё имя.", "Номер забронирован на моё имя."], "tr": ["Rezervasyon adıma.", "Rezervasyon benim adıma yapıldı.", "Rezervasyon benim ismime."] } },

    { "id": "u15.s.25", "en": "I am going to travel abroad.", "native": { "uz": "Men chet elga sayohat qilmoqchiman.", "ru": "Я собираюсь путешествовать за границей.", "tr": "Yurt dışına seyahat edeceğim." }, "altNative": { "uz": ["Chet elga sayohat qilmoqchiman.", "Men xorijga sayohat qilmoqchiman.", "Men chet elga sayohatga bormoqchiman."], "ru": ["Я собираюсь поехать за границу.", "Я собираюсь в путешествие за границу."], "tr": ["Ben yurt dışına seyahat edeceğim.", "Yurt dışında seyahat edeceğim.", "Yurt dışına seyahate çıkacağım."] } },
    { "id": "u15.s.26", "en": "I am going to visit London.", "native": { "uz": "Men Londonni borib ko'rmoqchiman.", "ru": "Я собираюсь посетить Лондон.", "tr": "Londra'yı ziyaret edeceğim." }, "altNative": { "uz": ["Londonni borib ko'rmoqchiman.", "Men Londonga bormoqchiman.", "Men Londonga tashrif buyurmoqchiman.", "Men Londonni ziyorat qilmoqchiman."], "ru": ["Я собираюсь поехать в Лондон.", "Я собираюсь побывать в Лондоне."], "tr": ["Ben Londra'yı ziyaret edeceğim.", "Londra'ya gideceğim."] } },
    { "id": "u15.s.27", "en": "When are you going to leave?", "native": { "uz": "Sen qachon jo'nab ketmoqchisan?", "ru": "Когда ты собираешься уезжать?", "tr": "Ne zaman ayrılacaksın?" }, "altNative": { "uz": ["Qachon jo'nab ketmoqchisan?", "Sen qachon ketmoqchisan?", "Qachon ketmoqchisan?", "Sen qachon jo'namoqchisan?"], "ru": ["Когда ты собираешься уехать?", "Когда ты уезжаешь?", "Когда ты собираешься уходить?"], "tr": ["Sen ne zaman ayrılacaksın?", "Ne zaman gideceksin?", "Ne zaman yola çıkacaksın?"] } },
    { "id": "u15.s.28", "en": "The train leaves from platform two.", "altEn": ["The train leaves from platform 2."], "native": { "uz": "Poyezd ikkinchi platformadan jo'nab ketadi.", "ru": "Поезд отправляется со второй платформы.", "tr": "Tren ikinci perondan kalkıyor." }, "altNative": { "uz": ["Poyezd ikkinchi platformadan jo'naydi.", "Poyezd ikkinchi perrondan jo'naydi.", "Poyezd 2-platformadan jo'naydi.", "Poyezd ikkinchi platformadan ketadi."], "ru": ["Поезд уходит со второй платформы.", "Поезд отходит со второй платформы.", "Поезд уезжает со второй платформы.", "Поезд отправляется с платформы номер два."], "tr": ["Tren iki numaralı perondan kalkıyor.", "Tren ikinci perondan kalkar.", "Tren ikinci perondan ayrılıyor.", "Tren ikinci perondan hareket ediyor."] } },
    { "id": "u15.s.29", "en": "We arrive in London at nine.", "altEn": ["We arrive in London at nine o'clock."], "native": { "uz": "Biz Londonga soat to'qqizda yetib boramiz.", "ru": "Мы прибываем в Лондон в девять.", "tr": "Londra'ya saat dokuzda varıyoruz." }, "altNative": { "uz": ["Biz Londonga soat to'qqizda yetib kelamiz.", "Londonga soat to'qqizda yetib boramiz.", "Biz Londonga to'qqizda yetib boramiz.", "Biz soat to'qqizda Londonga yetib boramiz."], "ru": ["Мы приезжаем в Лондон в девять.", "Мы прилетаем в Лондон в девять.", "Мы прибываем в Лондон в девять часов.", "Мы будем в Лондоне в девять."], "tr": ["Biz Londra'ya saat dokuzda varıyoruz.", "Londra'ya dokuzda varıyoruz.", "Londra'ya saat dokuzda varacağız.", "Saat dokuzda Londra'ya varıyoruz."] } },
    { "id": "u15.s.30", "en": "She is not going to travel by plane.", "native": { "uz": "U samolyotda sayohat qilmoqchi emas.", "ru": "Она не собирается путешествовать на самолёте.", "tr": "O uçakla seyahat etmeyecek." }, "altEnFor": { "uz": ["He is not going to travel by plane."], "tr": ["He is not going to travel by plane."] }, "altNative": { "uz": ["U samolyot bilan sayohat qilmoqchi emas.", "U samolyotda uchmoqchi emas."], "ru": ["Она не собирается лететь на самолёте.", "Она не собирается лететь самолётом.", "Она не собирается путешествовать самолётом."], "tr": ["Uçakla seyahat etmeyecek.", "O uçakla yolculuk etmeyecek."] } },
    { "id": "u15.s.31", "en": "What time does the plane arrive?", "native": { "uz": "Samolyot soat nechada yetib keladi?", "ru": "Во сколько прибывает самолёт?", "tr": "Uçak saat kaçta varıyor?" }, "altNative": { "uz": ["Samolyot soat nechada keladi?", "Samolyot soat nechada qo'nadi?", "Samolyot nechada yetib keladi?"], "ru": ["Во сколько прилетает самолёт?", "Во сколько самолёт прибывает?", "Во сколько самолёт прилетает?", "В котором часу прибывает самолёт?"], "tr": ["Uçak kaçta varıyor?", "Uçak saat kaçta iniyor?", "Uçak saat kaçta geliyor?", "Uçak saat kaçta varacak?"] } },
    { "id": "u15.s.32", "en": "Are you going to visit your parents?", "native": { "uz": "Sen ota-onangni borib ko'rmoqchimisan?", "ru": "Ты собираешься навестить родителей?", "tr": "Ebeveynlerini ziyaret edecek misin?" }, "altNative": { "uz": ["Ota-onangni borib ko'rmoqchimisan?", "Sen ota-onangni ko'rgani bormoqchimisan?", "Ota-onangni ko'rgani bormoqchimisan?", "Sen ota-onangnikiga bormoqchimisan?"], "ru": ["Ты собираешься навестить своих родителей?", "Ты собираешься навестить твоих родителей?", "Ты собираешься поехать к родителям?", "Ты собираешься посетить родителей?"], "tr": ["Sen ebeveynlerini ziyaret edecek misin?", "Anne babanı ziyaret edecek misin?", "Sen anne babanı ziyaret edecek misin?", "Aileni ziyaret edecek misin?"] } },

    { "id": "u15.s.33", "en": "We are on vacation in Turkey now.", "altEn": ["Now we are on vacation in Turkey.", "We are now on vacation in Turkey."], "native": { "uz": "Biz hozir Turkiyada ta'tildamiz.", "ru": "Мы сейчас в отпуске в Турции.", "tr": "Şimdi Türkiye'de tatildeyiz." }, "altNative": { "uz": ["Hozir biz Turkiyada ta'tildamiz.", "Hozir Turkiyada ta'tildamiz.", "Biz Turkiyada hozir ta'tildamiz.", "Biz hozir Turkiyada dam olyapmiz."], "ru": ["Сейчас мы в отпуске в Турции.", "Мы в отпуске в Турции сейчас.", "Мы сейчас на отдыхе в Турции.", "Мы сейчас отдыхаем в Турции.", "Мы сейчас на каникулах в Турции."], "tr": ["Biz şimdi Türkiye'de tatildeyiz.", "Şu anda Türkiye'de tatildeyiz.", "Biz şu anda Türkiye'de tatildeyiz.", "Şu an Türkiye'de tatildeyiz."] } },
    { "id": "u15.s.34", "en": "I am going to swim in the sea.", "native": { "uz": "Men dengizda suzmoqchiman.", "ru": "Я собираюсь плавать в море.", "tr": "Denizde yüzeceğim." }, "altNative": { "uz": ["Dengizda suzmoqchiman.", "Men dengizda cho'milmoqchiman."], "ru": ["Я собираюсь купаться в море.", "Я собираюсь поплавать в море.", "Я собираюсь искупаться в море."], "tr": ["Ben denizde yüzeceğim."] } },
    { "id": "u15.s.35", "en": "The beach is near our hotel.", "native": { "uz": "Plyaj mehmonxonamizga yaqin.", "ru": "Пляж рядом с нашей гостиницей.", "tr": "Plaj otelimize yakın." }, "altNative": { "uz": ["Plyaj bizning mehmonxonamizga yaqin.", "Sohil mehmonxonamizga yaqin.", "Plyaj mehmonxonamiz yaqinida.", "Plyaj otelimizga yaqin."], "ru": ["Пляж рядом с нашим отелем.", "Пляж недалеко от нашей гостиницы.", "Пляж недалеко от нашего отеля.", "Пляж около нашей гостиницы."], "tr": ["Plaj bizim otelimize yakın.", "Sahil otelimize yakın.", "Plaj otelimizin yakınında."] } },
    { "id": "u15.s.36", "en": "There are many tourists in the city.", "altEn": ["There are a lot of tourists in the city."], "native": { "uz": "Shaharda sayyohlar ko'p.", "ru": "В городе много туристов.", "tr": "Şehirde çok turist var." }, "altNative": { "uz": ["Shaharda ko'p sayyohlar bor.", "Shaharda ko'p sayyoh bor.", "Shaharda turistlar ko'p.", "Shaharda ko'p turistlar bor."], "ru": ["Туристов в городе много."], "tr": ["Şehirde birçok turist var.", "Şehirde çok sayıda turist var."] } },
    { "id": "u15.s.37", "en": "Do you like the mountains or the sea?", "native": { "uz": "Sen tog'larni yoqtirasanmi yoki dengiznimi?", "ru": "Тебе нравятся горы или море?", "tr": "Dağları mı, denizi mi seversin?" }, "altNative": { "uz": ["Tog'larni yoqtirasanmi yoki dengiznimi?", "Senga tog'lar yoqadimi yoki dengizmi?", "Senga tog'lar yoqadimi yoki dengiz?", "Sen tog'ni yoqtirasanmi yoki dengiznimi?"], "ru": ["Ты любишь горы или море?", "Тебе больше нравятся горы или море?"], "tr": ["Dağları mı yoksa denizi mi seversin?", "Sen dağları mı denizi mi seversin?", "Dağları mı seversin, denizi mi?", "Dağları mı yoksa denizi mi seviyorsun?"] } },
    { "id": "u15.s.38", "en": "The city tour starts at ten o'clock.", "altEn": ["The city tour starts at ten."], "native": { "uz": "Shahar bo'ylab ekskursiya soat o'nda boshlanadi.", "ru": "Экскурсия по городу начинается в десять часов.", "tr": "Şehir turu saat onda başlıyor." }, "altNative": { "uz": ["Shahar ekskursiyasi soat o'nda boshlanadi.", "Shahar turi soat o'nda boshlanadi.", "Shahar bo'ylab ekskursiya o'nda boshlanadi.", "Shahar bo'ylab sayohat soat o'nda boshlanadi."], "ru": ["Экскурсия по городу начинается в десять.", "Тур по городу начинается в десять часов.", "Городская экскурсия начинается в десять часов."], "tr": ["Şehir turu onda başlıyor.", "Şehir turu saat onda başlar.", "Şehir gezisi saat onda başlıyor."] } },
    { "id": "u15.s.39", "en": "I am not going to work on vacation.", "native": { "uz": "Men ta'tilda ishlamoqchi emasman.", "ru": "Я не собираюсь работать в отпуске.", "tr": "Tatilde çalışmayacağım." }, "altNative": { "uz": ["Ta'tilda ishlamoqchi emasman.", "Men ta'til paytida ishlamoqchi emasman.", "Men ta'tilda ishlamayman."], "ru": ["В отпуске я не собираюсь работать.", "Я не собираюсь работать во время отпуска.", "Я не собираюсь работать на каникулах."], "tr": ["Ben tatilde çalışmayacağım."] } },
    { "id": "u15.s.40", "en": "Next summer we are going to visit the mountains.", "altEn": ["We are going to visit the mountains next summer.", "Next summer we are going to go to the mountains.", "We are going to go to the mountains next summer."], "native": { "uz": "Kelasi yozda biz tog'larga bormoqchimiz.", "ru": "Следующим летом мы собираемся поехать в горы.", "tr": "Gelecek yaz dağlara gideceğiz." }, "altNative": { "uz": ["Kelasi yozda tog'larga bormoqchimiz.", "Biz kelasi yozda tog'larga bormoqchimiz.", "Keyingi yozda biz tog'larga bormoqchimiz.", "Keyingi yozda tog'larga bormoqchimiz.", "Kelasi yozda biz tog'larni borib ko'rmoqchimiz."], "ru": ["Следующим летом мы собираемся в горы.", "Мы собираемся поехать в горы следующим летом.", "Следующим летом мы собираемся посетить горы.", "Следующим летом мы собираемся побывать в горах."], "tr": ["Biz gelecek yaz dağlara gideceğiz.", "Gelecek yaz dağları ziyaret edeceğiz.", "Önümüzdeki yaz dağlara gideceğiz.", "Gelecek yaz dağlara gitmeyi planlıyoruz."] } }
