    { "id": "u14.s.24", "en": "My sister can draw very well.", "native": { "uz": "Mening opam juda yaxshi rasm chiza oladi.", "ru": "Моя сестра умеет очень хорошо рисовать.", "tr": "Kız kardeşim çok iyi resim çizebilir." }, "altNative": { "uz": ["Opam juda yaxshi rasm chiza oladi.", "Mening singlim juda yaxshi rasm chiza oladi.", "Singlim juda yaxshi rasm chiza oladi.", "Mening opam rasmni juda yaxshi chiza oladi."], "ru": ["Моя сестра умеет рисовать очень хорошо.", "Моя сестра очень хорошо рисует.", "Моя сестра может очень хорошо рисовать."], "tr": ["Benim kız kardeşim çok iyi resim çizebilir.", "Kız kardeşim çok iyi resim yapabilir.", "Kız kardeşim çok iyi çizebilir.", "Kız kardeşim çok iyi resim çizebiliyor.", "Ablam çok iyi resim çizebilir."] } },

    { "id": "u14.s.25", "en": "Football is a great sport.", "native": { "uz": "Futbol zo'r sport.", "ru": "Футбол — отличный вид спорта.", "tr": "Futbol harika bir spor." }, "altNative": { "uz": ["Futbol zo'r sport turi.", "Futbol ajoyib sport.", "Futbol ajoyib sport turi."], "ru": ["Футбол — отличный спорт.", "Футбол — это отличный вид спорта.", "Футбол — это отличный спорт."], "tr": ["Futbol harika bir spordur.", "Futbol harika bir spor dalı."] } },
    { "id": "u14.s.26", "en": "What sports do you like?", "altEn": ["Which sports do you like?", "What sport do you like?"], "native": { "uz": "Sen qaysi sport turlarini yoqtirasan?", "ru": "Какие виды спорта тебе нравятся?", "tr": "Hangi sporları seversin?" }, "altNative": { "uz": ["Qaysi sport turlarini yoqtirasan?", "Senga qaysi sport turlari yoqadi?", "Sen qanday sportni yoqtirasan?"], "ru": ["Какие виды спорта ты любишь?", "Какой спорт тебе нравится?", "Какой вид спорта тебе нравится?"], "tr": ["Sen hangi sporları seversin?", "Hangi sporları seviyorsun?", "Hangi spor dallarını seversin?", "Hangi sporu seversin?"] } },
    { "id": "u14.s.27", "en": "I play football with my friends.", "native": { "uz": "Men do'stlarim bilan futbol o'ynayman.", "ru": "Я играю в футбол с друзьями.", "tr": "Arkadaşlarımla futbol oynuyorum." }, "altNative": { "uz": ["Do'stlarim bilan futbol o'ynayman.", "Men o'rtoqlarim bilan futbol o'ynayman."], "ru": ["Я играю с друзьями в футбол.", "Я играю в футбол со своими друзьями.", "Я играю в футбол с моими друзьями."], "tr": ["Ben arkadaşlarımla futbol oynuyorum.", "Arkadaşlarımla futbol oynarım.", "Ben arkadaşlarımla futbol oynarım."] } },
    { "id": "u14.s.28", "en": "Do you want to play tennis today?", "native": { "uz": "Bugun tennis o'ynashni xohlaysanmi?", "ru": "Ты хочешь сегодня поиграть в теннис?", "tr": "Bugün tenis oynamak ister misin?" }, "altNative": { "uz": ["Sen bugun tennis o'ynashni xohlaysanmi?", "Bugun tennis o'ynamoqchimisan?"], "ru": ["Хочешь сегодня поиграть в теннис?", "Ты хочешь поиграть в теннис сегодня?", "Ты хочешь сегодня играть в теннис?", "Ты хочешь играть в теннис сегодня?"], "tr": ["Sen bugün tenis oynamak ister misin?", "Bugün tenis oynamak istiyor musun?"] } },
    { "id": "u14.s.29", "en": "Is the game today or tomorrow?", "native": { "uz": "O'yin bugunmi yoki ertagami?", "ru": "Игра сегодня или завтра?", "tr": "Oyun bugün mü yarın mı?" }, "altNative": { "uz": ["O'yin bugunmi yoki ertaga?"], "ru": ["Матч сегодня или завтра?"], "tr": ["Oyun bugün mü yoksa yarın mı?", "Maç bugün mü yarın mı?", "Maç bugün mü yoksa yarın mı?"] } },
    { "id": "u14.s.30", "en": "We can win this game.", "native": { "uz": "Biz bu o'yinda yuta olamiz.", "ru": "Мы можем выиграть эту игру.", "tr": "Biz bu oyunu kazanabiliriz." }, "altNative": { "uz": ["Bu o'yinda yuta olamiz.", "Biz bu o'yinni yuta olamiz.", "Biz bu o'yinda g'alaba qozona olamiz."], "ru": ["Мы можем победить в этой игре.", "Мы сможем выиграть эту игру.", "Мы можем выиграть этот матч."], "tr": ["Bu oyunu kazanabiliriz.", "Bu maçı kazanabiliriz.", "Biz bu maçı kazanabiliriz."] } },
    { "id": "u14.s.31", "en": "I don't want to lose.", "native": { "uz": "Men yutqazishni xohlamayman.", "ru": "Я не хочу проигрывать.", "tr": "Ben kaybetmek istemiyorum." }, "altNative": { "uz": ["Yutqazishni xohlamayman.", "Men yutqazishni istamayman.", "Men mag'lub bo'lishni xohlamayman."], "ru": ["Я не хочу проиграть."], "tr": ["Kaybetmek istemiyorum.", "Ben yenilmek istemiyorum."] } },
    { "id": "u14.s.32", "en": "My brother can play tennis very well.", "native": { "uz": "Mening akam tennisni juda yaxshi o'ynay oladi.", "ru": "Мой брат умеет очень хорошо играть в теннис.", "tr": "Erkek kardeşim çok iyi tenis oynayabilir." }, "altNative": { "uz": ["Akam tennisni juda yaxshi o'ynay oladi.", "Mening ukam tennisni juda yaxshi o'ynay oladi.", "Ukam tennisni juda yaxshi o'ynay oladi.", "Mening akam juda yaxshi tennis o'ynay oladi.", "Mening akam tennisni juda yaxshi o'ynaydi."], "ru": ["Мой брат умеет играть в теннис очень хорошо.", "Мой брат очень хорошо играет в теннис.", "Мой брат может очень хорошо играть в теннис."], "tr": ["Benim erkek kardeşim çok iyi tenis oynayabilir.", "Erkek kardeşim çok iyi tenis oynayabiliyor.", "Erkek kardeşim tenisi çok iyi oynayabilir.", "Abim çok iyi tenis oynayabilir.", "Erkek kardeşim çok iyi tenis oynar."] } },

    { "id": "u14.s.33", "en": "I often watch movies at the weekend.", "altEn": ["I often watch movies on the weekend.", "I often watch movies on weekends.", "I often watch movies at weekends.", "At the weekend I often watch movies."], "native": { "uz": "Men dam olish kunlari tez-tez kino ko'raman.", "ru": "По выходным я часто смотрю фильмы.", "tr": "Hafta sonu sık sık film izlerim." }, "altNative": { "uz": ["Dam olish kunlari men tez-tez kino ko'raman.", "Dam olish kunlari tez-tez kino ko'raman.", "Men dam olish kunlarida tez-tez kino ko'raman.", "Men hafta oxirida tez-tez kino ko'raman.", "Men tez-tez dam olish kunlari kino ko'raman."], "ru": ["Я часто смотрю фильмы по выходным.", "На выходных я часто смотрю фильмы.", "Я часто смотрю фильмы на выходных.", "По выходным я часто смотрю кино.", "Я часто смотрю кино по выходным."], "tr": ["Ben hafta sonu sık sık film izlerim.", "Hafta sonları sık sık film izlerim.", "Hafta sonunda sık sık film izlerim.", "Hafta sonu sık sık film izliyorum.", "Hafta sonu sık sık film seyrederim."] } },
    { "id": "u14.s.34", "en": "What do you do in your free time?", "native": { "uz": "Bo'sh vaqtingda nima qilasan?", "ru": "Что ты делаешь в свободное время?", "tr": "Boş zamanında ne yaparsın?" }, "altNative": { "uz": ["Sen bo'sh vaqtingda nima qilasan?", "Bo'sh vaqtingda nima bilan shug'ullanasan?"], "ru": ["Чем ты занимаешься в свободное время?", "Что ты делаешь в своё свободное время?"], "tr": ["Sen boş zamanında ne yaparsın?", "Boş zamanlarında ne yaparsın?", "Boş zamanında ne yapıyorsun?", "Boş vaktinde ne yaparsın?"] } },
    { "id": "u14.s.35", "en": "In my free time I play the guitar.", "altEn": ["I play the guitar in my free time.", "In my free time I play guitar.", "I play guitar in my free time."], "native": { "uz": "Bo'sh vaqtimda men gitara chalaman.", "ru": "В свободное время я играю на гитаре.", "tr": "Boş zamanımda gitar çalarım." }, "altNative": { "uz": ["Bo'sh vaqtimda gitara chalaman.", "Men bo'sh vaqtimda gitara chalaman."], "ru": ["Я играю на гитаре в свободное время.", "В своё свободное время я играю на гитаре."], "tr": ["Boş zamanımda gitar çalıyorum.", "Ben boş zamanımda gitar çalarım.", "Boş zamanlarımda gitar çalarım.", "Boş vaktimde gitar çalarım."] } },
    { "id": "u14.s.36", "en": "Do you often go to the gym?", "native": { "uz": "Sen sport zaliga tez-tez borasanmi?", "ru": "Ты часто ходишь в спортзал?", "tr": "Spor salonuna sık sık gider misin?" }, "altNative": { "uz": ["Sport zaliga tez-tez borasanmi?", "Sen tez-tez sport zaliga borasanmi?", "Tez-tez sport zaliga borasanmi?"], "ru": ["Часто ходишь в спортзал?", "Ты часто ходишь в спортивный зал?", "Ты часто ходишь в тренажёрный зал?"], "tr": ["Sık sık spor salonuna gider misin?", "Sen spor salonuna sık sık gider misin?", "Spor salonuna sık sık gidiyor musun?", "Sık sık spor salonuna gidiyor musun?"] } },
    { "id": "u14.s.37", "en": "This is a photo of my family.", "altEn": ["This is a picture of my family."], "native": { "uz": "Bu mening oilamning surati.", "ru": "Это фотография моей семьи.", "tr": "Bu ailemin fotoğrafı." }, "altNative": { "uz": ["Bu oilamning surati.", "Bu mening oilamning rasmi.", "Bu mening oilamning fotosurati."], "ru": ["Это фото моей семьи."], "tr": ["Bu benim ailemin fotoğrafı.", "Bu ailemin bir fotoğrafı."] } },
    { "id": "u14.s.38", "en": "Is this movie interesting or boring?", "native": { "uz": "Bu kino qiziqarlimi yoki zerikarlimi?", "ru": "Этот фильм интересный или скучный?", "tr": "Bu film ilginç mi sıkıcı mı?" }, "altNative": { "uz": ["Bu kino qiziqarlimi yoki zerikarli?", "Bu film qiziqarlimi yoki zerikarlimi?"], "ru": ["Это интересный или скучный фильм?"], "tr": ["Bu film ilginç mi yoksa sıkıcı mı?", "Bu film ilgi çekici mi sıkıcı mı?"] } },
    { "id": "u14.s.39", "en": "Swimming is fun, but running is boring.", "native": { "uz": "Suzish maroqli, lekin yugurish zerikarli.", "ru": "Плавать весело, а бегать скучно.", "tr": "Yüzmek eğlenceli ama koşmak sıkıcı." }, "altNative": { "uz": ["Suzish maroqli, ammo yugurish zerikarli.", "Suzish maroqli, biroq yugurish zerikarli.", "Suzish qiziqarli, lekin yugurish zerikarli."], "ru": ["Плавать весело, но бегать скучно.", "Плавать — это весело, а бегать — скучно.", "Плавание — это весело, а бег — скучно."], "tr": ["Yüzmek eğlenceli fakat koşmak sıkıcı.", "Yüzmek eğlenceli ancak koşmak sıkıcı.", "Yüzmek eğlencelidir ama koşmak sıkıcıdır."] } },
