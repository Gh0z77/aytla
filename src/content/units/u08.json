    { "id": "u08.s.20", "en": "There is a mirror on the wall.", "native": { "uz": "Devorda ko'zgu bor.", "ru": "На стене висит зеркало.", "tr": "Duvarda bir ayna var." }, "altNative": { "uz": ["Devorda oyna bor.", "Devorda bitta ko'zgu bor."], "ru": ["На стене есть зеркало.", "На стене зеркало."], "tr": ["Duvarda ayna var."] } },
