    { "id": "u08.s.31", "en": "Is the dog in the garden?", "native": { "uz": "It bog'dami?", "ru": "Собака в саду?", "tr": "Köpek bahçede mi?" }, "altNative": { "uz": ["Kuchuk bog'dami?"] } },
    { "id": "u08.s.32", "en": "The cat is not on the sofa.", "native": { "uz": "Mushuk divanda emas.", "ru": "Кошка не на диване.", "tr": "Kedi kanepede değil." }, "altNative": { "uz": ["Mushuk divan ustida emas.", "Mushuk divanning ustida emas."], "ru": ["Кот не на диване."], "tr": ["Kedi kanepenin üstünde değil.", "Kedi koltukta değil."] } },

    { "id": "u08.s.33", "en": "I live in a small apartment.", "native": { "uz": "Men kichik kvartirada yashayman.", "ru": "Я живу в маленькой квартире.", "tr": "Ben küçük bir dairede yaşıyorum." }, "altNative": { "uz": ["Men kichkina kvartirada yashayman.", "Kichik kvartirada yashayman."], "ru": ["Я живу в небольшой квартире."], "tr": ["Küçük bir dairede yaşıyorum.", "Ben küçük bir dairede oturuyorum.", "Küçük bir dairede oturuyorum."] } },
    { "id": "u08.s.34", "en": "Our apartment is quiet and comfortable.", "native": { "uz": "Bizning kvartiramiz tinch va qulay.", "ru": "Наша квартира тихая и удобная.", "tr": "Bizim dairemiz sessiz ve rahat." }, "altNative": { "uz": ["Kvartiramiz tinch va qulay.", "Bizning kvartiramiz sokin va qulay."], "ru": ["Наша квартира тихая и уютная.", "У нас тихая и удобная квартира."], "tr": ["Dairemiz sessiz ve rahat.", "Dairemiz sakin ve rahat.", "Bizim dairemiz sakin ve rahat."] } },
    { "id": "u08.s.35", "en": "There is a balcony next to the kitchen.", "native": { "uz": "Oshxona yonida balkon bor.", "ru": "Рядом с кухней есть балкон.", "tr": "Mutfağın yanında bir balkon var." }, "altNative": { "uz": ["Oshxonaning yonida balkon bor.", "Oshxona yonida bitta balkon bor."], "ru": ["Рядом с кухней балкон.", "Возле кухни есть балкон."], "tr": ["Mutfağın yanında balkon var."] } },
    { "id": "u08.s.36", "en": "Our neighbor has a big dog.", "altEn": ["Our neighbour has a big dog."], "native": { "uz": "Qo'shnimizning katta iti bor.", "ru": "У нашего соседа большая собака.", "tr": "Komşumuzun büyük bir köpeği var." }, "altNative": { "uz": ["Bizning qo'shnimizning katta iti bor.", "Qo'shnimizning katta kuchugi bor."], "ru": ["У нашего соседа есть большая собака.", "У нашей соседки большая собака.", "У нашей соседки есть большая собака."], "tr": ["Bizim komşumuzun büyük bir köpeği var.", "Komşumuzun büyük köpeği var."] } },
    { "id": "u08.s.37", "en": "The stairs are between the two apartments.", "altEn": ["The stairs are between two apartments."], "native": { "uz": "Zinapoya ikki kvartira orasida.", "ru": "Лестница между двумя квартирами.", "tr": "Merdiven iki dairenin arasında." }, "altNative": { "uz": ["Zinapoya ikkita kvartira orasida.", "Zinapoya ikki kvartiraning orasida.", "Zina ikki kvartira orasida."], "ru": ["Лестница находится между двумя квартирами."], "tr": ["Merdivenler iki dairenin arasında.", "Merdiven iki daire arasında."] } },
    { "id": "u08.s.38", "en": "Is your new sofa comfortable?", "native": { "uz": "Sening yangi divaning qulaymi?", "ru": "Твой новый диван удобный?", "tr": "Senin yeni kanepen rahat mı?" }, "altNative": { "uz": ["Yangi divaning qulaymi?"], "ru": ["Твой новый диван удобен?"], "tr": ["Yeni kanepen rahat mı?", "Yeni koltuğun rahat mı?"] } },
    { "id": "u08.s.39", "en": "It is not very quiet here at night.", "native": { "uz": "Bu yerda kechasi unchalik tinch emas.", "ru": "Ночью здесь не очень тихо.", "tr": "Burada geceleri pek sessiz değil." }, "altNative": { "uz": ["Kechasi bu yerda unchalik tinch emas.", "Bu yerda kechasi juda tinch emas.", "Shu yerda kechasi unchalik tinch emas."], "ru": ["Здесь ночью не очень тихо.", "Ночью тут не очень тихо."], "tr": ["Geceleri burada pek sessiz değil.", "Burada geceleri çok sessiz değil.", "Burası geceleri pek sessiz değil.", "Burada gece pek sessiz değil."] } },
    { "id": "u08.s.40", "en": "There are three rooms in our apartment.", "native": { "uz": "Bizning kvartiramizda uchta xona bor.", "ru": "В нашей квартире три комнаты.", "tr": "Dairemizde üç oda var." }, "altNative": { "uz": ["Kvartiramizda uchta xona bor.", "Bizning kvartiramizda uch xona bor."], "ru": ["В нашей квартире есть три комнаты."], "tr": ["Bizim dairemizde üç oda var."] } }
