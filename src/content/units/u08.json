    { "id": "u08.s.13", "en": "Please sit here.", "native": { "uz": "Iltimos, shu yerga o'tir.", "ru": "Пожалуйста, садись сюда.", "tr": "Lütfen buraya otur." }, "altNative": { "uz": ["Iltimos, bu yerga o'tir.", "Shu yerga o'tir, iltimos.", "Iltimos, shu yerda o'tir."], "ru": ["Садись сюда, пожалуйста.", "Пожалуйста, сядь здесь.", "Сядь здесь, пожалуйста.", "Пожалуйста, садись здесь."], "tr": ["Buraya otur, lütfen.", "Lütfen burada otur.", "Lütfen şuraya otur."] } },
    { "id": "u08.s.14", "en": "The floor is not clean.", "native": { "uz": "Pol toza emas.", "ru": "Пол не чистый.", "tr": "Zemin temiz değil." }, "altNative": { "ru": ["Пол нечистый."], "tr": ["Yer temiz değil.", "Yerler temiz değil."] } },
    { "id": "u08.s.15", "en": "What is in the fridge?", "native": { "uz": "Muzlatgichda nima bor?", "ru": "Что в холодильнике?", "tr": "Buzdolabında ne var?" }, "altNative": { "uz": ["Sovutgichda nima bor?"], "ru": ["Что есть в холодильнике?", "Что лежит в холодильнике?"] } },
    { "id": "u08.s.16", "en": "We sit on the floor.", "native": { "uz": "Biz polda o'tiramiz.", "ru": "Мы сидим на полу.", "tr": "Biz yerde oturuyoruz." }, "altNative": { "uz": ["Polda o'tiramiz.", "Biz yerda o'tiramiz."], "tr": ["Yerde oturuyoruz.", "Biz yerde otururuz.", "Yerde otururuz.", "Biz zeminde oturuyoruz."] } },

    { "id": "u08.s.17", "en": "There is a bed in my room.", "native": { "uz": "Mening xonamda karavot bor.", "ru": "В моей комнате есть кровать.", "tr": "Odamda bir yatak var." }, "altNative": { "uz": ["Xonamda karavot bor.", "Mening xonamda bitta karavot bor.", "Xonamda bitta karavot bor."], "ru": ["В моей комнате стоит кровать.", "У меня в комнате есть кровать."], "tr": ["Benim odamda bir yatak var.", "Odamda yatak var."] } },
