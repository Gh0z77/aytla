  "sentences": [
    { "id": "u08.s.01", "en": "This is my room.", "native": { "uz": "Bu mening xonam.", "ru": "Это моя комната.", "tr": "Bu benim odam." }, "altNative": { "uz": ["Bu xonam."], "tr": ["Bu odam."] } },
    { "id": "u08.s.02", "en": "This is the kitchen.", "altEn": ["This is a kitchen."], "native": { "uz": "Bu oshxona.", "ru": "Это кухня.", "tr": "Bu mutfak." }, "altNative": { "tr": ["Burası mutfak."] } },
    { "id": "u08.s.03", "en": "Where is the bathroom?", "native": { "uz": "Hammom qayerda?", "ru": "Где ванная?", "tr": "Banyo nerede?" }, "altNative": { "uz": ["Vannaxona qayerda?"], "ru": ["Где ванная комната?"] } },
    { "id": "u08.s.04", "en": "The bedroom is small.", "native": { "uz": "Yotoqxona kichik.", "ru": "Спальня маленькая.", "tr": "Yatak odası küçük." }, "altNative": { "uz": ["Yotoqxona kichkina."] } },
    { "id": "u08.s.05", "en": "The living room is big.", "native": { "uz": "Mehmonxona katta.", "ru": "Гостиная большая.", "tr": "Oturma odası büyük." }, "altNative": { "uz": ["Zal katta."], "tr": ["Salon büyük."] } },
    { "id": "u08.s.06", "en": "We have a garden.", "native": { "uz": "Bizning bog'imiz bor.", "ru": "У нас есть сад.", "tr": "Bizim bir bahçemiz var." }, "altNative": { "uz": ["Bog'imiz bor.", "Bizda bog' bor."], "tr": ["Bir bahçemiz var.", "Bahçemiz var.", "Bizim bahçemiz var."] } },
    { "id": "u08.s.07", "en": "Is this your bedroom?", "native": { "uz": "Bu sening yotoqxonangmi?", "ru": "Это твоя спальня?", "tr": "Bu senin yatak odan mı?" }, "altNative": { "uz": ["Bu yotoqxonangmi?"], "tr": ["Bu yatak odan mı?"] } },
    { "id": "u08.s.08", "en": "My room is not big.", "native": { "uz": "Mening xonam katta emas.", "ru": "Моя комната небольшая.", "tr": "Benim odam büyük değil." }, "altNative": { "uz": ["Xonam katta emas."], "ru": ["Моя комната не большая."], "tr": ["Odam büyük değil."] } },

    { "id": "u08.s.09", "en": "The milk is in the fridge.", "native": { "uz": "Sut muzlatgichda.", "ru": "Молоко в холодильнике.", "tr": "Süt buzdolabında." }, "altNative": { "uz": ["Sut sovutgichda."], "ru": ["Молоко стоит в холодильнике."] } },
    { "id": "u08.s.10", "en": "I cook dinner in the kitchen.", "native": { "uz": "Men oshxonada kechki ovqat pishiraman.", "ru": "Я готовлю ужин на кухне.", "tr": "Mutfakta akşam yemeği pişiriyorum." }, "altNative": { "uz": ["Oshxonada kechki ovqat pishiraman.", "Men oshxonada kechki ovqat tayyorlayman.", "Men kechki ovqatni oshxonada pishiraman."], "ru": ["Я на кухне готовлю ужин."], "tr": ["Ben mutfakta akşam yemeği pişiriyorum.", "Mutfakta akşam yemeği yapıyorum.", "Ben mutfakta akşam yemeği yapıyorum.", "Akşam yemeğini mutfakta yapıyorum.", "Mutfakta akşam yemeği yaparım."] } },
    { "id": "u08.s.11", "en": "The cups are on the shelf.", "native": { "uz": "Chashkalar tokchada.", "ru": "Чашки на полке.", "tr": "Fincanlar rafta." }, "altNative": { "uz": ["Piyolalar tokchada.", "Finjonlar tokchada.", "Chashkalar javonda.", "Chashkalar tokchada turibdi."], "ru": ["Чашки стоят на полке."], "tr": ["Fincanlar rafın üstünde."] } },
