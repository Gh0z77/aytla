  "sentences": [
    { "id": "u17.s.01", "en": "I was at home.", "native": { "uz": "Men uyda edim.", "ru": "Я был дома.", "tr": "Ben evdeydim." }, "altNative": { "uz": ["Uyda edim."], "ru": ["Я была дома."], "tr": ["Evdeydim."] } },
    { "id": "u17.s.02", "en": "Where were you yesterday?", "native": { "uz": "Kecha qayerda eding?", "ru": "Где ты был вчера?", "tr": "Dün neredeydin?" }, "altNative": { "uz": ["Sen kecha qayerda eding?", "Kecha sen qayerda eding?"], "ru": ["Где ты была вчера?", "Где ты вчера был?", "Где ты вчера была?"], "tr": ["Sen dün neredeydin?"] } },
    { "id": "u17.s.03", "en": "We were at a party.", "native": { "uz": "Biz ziyofatda edik.", "ru": "Мы были на вечеринке.", "tr": "Biz bir partideydik." }, "altNative": { "uz": ["Ziyofatda edik.", "Biz bazmda edik."], "tr": ["Bir partideydik.", "Biz partideydik.", "Partideydik."] } },
    { "id": "u17.s.04", "en": "The concert was great.", "native": { "uz": "Konsert zo'r bo'ldi.", "ru": "Концерт был отличный.", "tr": "Konser harikaydı." }, "altNative": { "uz": ["Konsert zo'r edi.", "Konsert ajoyib bo'ldi."], "ru": ["Концерт был отличным.", "Концерт был классный."], "tr": ["Konser çok güzeldi."] } },
    { "id": "u17.s.05", "en": "Were you at the wedding?", "native": { "uz": "Sen to'yda edingmi?", "ru": "Ты был на свадьбе?", "tr": "Sen düğünde miydin?" }, "altNative": { "uz": ["To'yda edingmi?", "Sen to'yda bo'ldingmi?", "To'yda bo'ldingmi?"], "ru": ["Ты была на свадьбе?"], "tr": ["Düğünde miydin?"] } },
    { "id": "u17.s.06", "en": "I was born in Uzbekistan.", "native": { "uz": "Men O'zbekistonda tug'ilganman.", "ru": "Я родился в Узбекистане.", "tr": "Ben Özbekistan'da doğdum." }, "altNative": { "uz": ["O'zbekistonda tug'ilganman.", "Men O'zbekistonda tug'ildim."], "ru": ["Я родилась в Узбекистане."], "tr": ["Özbekistan'da doğdum."] } },
    { "id": "u17.s.07", "en": "She was not alone.", "native": { "uz": "U yolg'iz emas edi.", "ru": "Она была не одна.", "tr": "O yalnız değildi." }, "altEnFor": { "uz": ["He was not alone."], "tr": ["He was not alone."] }, "altNative": { "uz": ["U yolg'iz emasdi.", "U bir o'zi emas edi."], "ru": ["Она не была одна."], "tr": ["Yalnız değildi.", "O tek başına değildi."] } },
    { "id": "u17.s.08", "en": "It was cold yesterday.", "altEn": ["Yesterday it was cold."], "native": { "uz": "Kecha sovuq edi.", "ru": "Вчера было холодно.", "tr": "Dün hava soğuktu." }, "altNative": { "uz": ["Kecha havo sovuq edi.", "Kecha sovuq bo'ldi."], "ru": ["Было холодно вчера."], "tr": ["Dün soğuktu."] } },

    { "id": "u17.s.09", "en": "I worked all day yesterday.", "altEn": ["Yesterday I worked all day."], "native": { "uz": "Men kecha kun bo'yi ishladim.", "ru": "Вчера я работал весь день.", "tr": "Dün bütün gün çalıştım." }, "altNative": { "uz": ["Kecha kun bo'yi ishladim.", "Kecha men kun bo'yi ishladim.", "Men kecha butun kun ishladim."], "ru": ["Вчера я работала весь день.", "Я работал весь день вчера.", "Я работала весь день вчера.", "Я вчера весь день работал.", "Я вчера весь день работала.", "Вчера я весь день работал.", "Вчера я весь день работала."], "tr": ["Ben dün bütün gün çalıştım.", "Dün tüm gün çalıştım."] } },
    { "id": "u17.s.10", "en": "We watched a movie last night.", "altEn": ["Last night we watched a movie.", "We watched a film last night."], "native": { "uz": "Biz kecha kechqurun kino ko'rdik.", "ru": "Вчера вечером мы смотрели фильм.", "tr": "Dün gece bir film izledik." }, "altNative": { "uz": ["Kecha kechqurun kino ko'rdik.", "Kecha kechqurun biz kino ko'rdik.", "Biz kecha kechqurun kino tomosha qildik."], "ru": ["Вчера вечером мы посмотрели фильм.", "Мы смотрели фильм вчера вечером.", "Мы посмотрели фильм вчера вечером.", "Вчера вечером мы смотрели кино."], "tr": ["Biz dün gece bir film izledik.", "Dün gece film izledik.", "Dün akşam bir film izledik."] } },
    { "id": "u17.s.11", "en": "My mother cooked dinner.", "altEn": ["My mother made dinner."], "native": { "uz": "Mening onam kechki ovqat pishirdi.", "ru": "Моя мама приготовила ужин.", "tr": "Annem akşam yemeği pişirdi." }, "altNative": { "uz": ["Onam kechki ovqat pishirdi.", "Onam kechki ovqat tayyorladi.", "Mening onam kechki ovqat tayyorladi."], "ru": ["Мама приготовила ужин.", "Моя мама готовила ужин."], "tr": ["Benim annem akşam yemeği pişirdi.", "Annem akşam yemeği yaptı.", "Annem akşam yemeğini pişirdi."] } },
    { "id": "u17.s.12", "en": "Who cooked this soup?", "altEn": ["Who made this soup?"], "native": { "uz": "Bu sho'rvani kim pishirdi?", "ru": "Кто приготовил этот суп?", "tr": "Bu çorbayı kim pişirdi?" }, "altNative": { "uz": ["Kim bu sho'rvani pishirdi?", "Bu sho'rvani kim tayyorladi?"], "ru": ["Кто готовил этот суп?", "Кто сварил этот суп?", "Этот суп кто приготовил?"], "tr": ["Bu çorbayı kim yaptı?", "Kim bu çorbayı pişirdi?"] } },
    { "id": "u17.s.13", "en": "I stayed at home yesterday.", "altEn": ["Yesterday I stayed at home.", "I stayed home yesterday.", "Yesterday I stayed home."], "native": { "uz": "Men kecha uyda qoldim.", "ru": "Вчера я остался дома.", "tr": "Dün evde kaldım." }, "altNative": { "uz": ["Kecha uyda qoldim.", "Kecha men uyda qoldim."], "ru": ["Вчера я осталась дома.", "Я вчера остался дома.", "Я вчера осталась дома.", "Я остался дома вчера.", "Я осталась дома вчера."], "tr": ["Ben dün evde kaldım."] } },
    { "id": "u17.s.14", "en": "We visited our grandmother.", "native": { "uz": "Biz buvimizni ko'rgani bordik.", "ru": "Мы навестили бабушку.", "tr": "Büyükannemizi ziyaret ettik." }, "altNative": { "uz": ["Buvimizni ko'rgani bordik.", "Biz buvimiznikiga bordik.", "Biz buvimizni yo'qladik.", "Biz buvimizni yo'qlab bordik."], "ru": ["Мы навестили нашу бабушку.", "Мы ездили к бабушке.", "Мы были в гостях у бабушки."], "tr": ["Biz büyükannemizi ziyaret ettik.", "Ninemizi ziyaret ettik.", "Babaannemizi ziyaret ettik.", "Anneannemizi ziyaret ettik."] } },
    { "id": "u17.s.15", "en": "They played football in the park.", "native": { "uz": "Ular parkda futbol o'ynashdi.", "ru": "Они играли в футбол в парке.", "tr": "Onlar parkta futbol oynadılar." }, "altNative": { "uz": ["Ular parkda futbol o'ynadi.", "Ular parkda futbol o'ynadilar."], "ru": ["Они в парке играли в футбол.", "Они поиграли в футбол в парке."], "tr": ["Parkta futbol oynadılar.", "Onlar parkta futbol oynadı."] } },
    { "id": "u17.s.16", "en": "My father worked at a bank.", "altEn": ["My father worked in a bank."], "native": { "uz": "Mening otam bankda ishladi.", "ru": "Мой папа работал в банке.", "tr": "Babam bir bankada çalıştı." }, "altNative": { "uz": ["Otam bankda ishladi.", "Mening otam bankda ishlagan.", "Otam bankda ishlagan.", "Mening dadam bankda ishladi."], "ru": ["Мой отец работал в банке.", "Папа работал в банке.", "Мой папа работал в одном банке."], "tr": ["Benim babam bir bankada çalıştı.", "Babam bankada çalıştı.", "Babam bir bankada çalışıyordu."] } },

    { "id": "u17.s.17", "en": "She went to the park.", "native": { "uz": "U parkka bordi.", "ru": "Она пошла в парк.", "tr": "O parka gitti." }, "altEnFor": { "uz": ["He went to the park."], "tr": ["He went to the park."] }, "altNative": { "uz": ["U parkka ketdi."], "ru": ["Она ходила в парк.", "Она ушла в парк."], "tr": ["Parka gitti."] } },
    { "id": "u17.s.18", "en": "I went to bed early.", "native": { "uz": "Men erta yotdim.", "ru": "Я рано лёг спать.", "tr": "Ben erken yattım." }, "altNative": { "uz": ["Erta yotdim.", "Men barvaqt yotdim.", "Men erta uxlashga yotdim."], "ru": ["Я рано легла спать.", "Я лёг спать рано.", "Я легла спать рано."], "tr": ["Erken yattım.", "Erkenden yattım."] } },
    { "id": "u17.s.19", "en": "We ate fish for dinner.", "altEn": ["We had fish for dinner."], "native": { "uz": "Biz kechki ovqatga baliq yedik.", "ru": "На ужин мы ели рыбу.", "tr": "Akşam yemeğinde balık yedik." }, "altNative": { "uz": ["Kechki ovqatga baliq yedik.", "Kechki ovqatga biz baliq yedik."], "ru": ["Мы ели рыбу на ужин.", "На ужин мы съели рыбу.", "Мы ели на ужин рыбу."], "tr": ["Biz akşam yemeğinde balık yedik."] } },
    { "id": "u17.s.20", "en": "I saw Anna at the concert.", "native": { "uz": "Men Annani konsertda ko'rdim.", "ru": "Я видел Анну на концерте.", "tr": "Anna'yı konserde gördüm." }, "altNative": { "uz": ["Annani konsertda ko'rdim.", "Men konsertda Annani ko'rdim.", "Konsertda Annani ko'rdim."], "ru": ["Я видела Анну на концерте.", "Я увидел Анну на концерте.", "Я увидела Анну на концерте.", "Я видел на концерте Анну.", "Я видела на концерте Анну."], "tr": ["Konserde Anna'yı gördüm.", "Ben Anna'yı konserde gördüm.", "Ben konserde Anna'yı gördüm."] } },
    { "id": "u17.s.21", "en": "We had a great time.", "native": { "uz": "Biz vaqtni zo'r o'tkazdik.", "ru": "Мы отлично провели время.", "tr": "Harika vakit geçirdik." }, "altNative": { "uz": ["Vaqtni zo'r o'tkazdik.", "Biz zo'r vaqt o'tkazdik.", "Biz vaqtni juda yaxshi o'tkazdik."], "ru": ["Мы прекрасно провели время.", "Мы здорово провели время.", "Мы провели время отлично."], "tr": ["Biz harika vakit geçirdik.", "Harika zaman geçirdik.", "Harika bir vakit geçirdik.", "Çok güzel vakit geçirdik."] } },
    { "id": "u17.s.22", "en": "My brother bought a new phone.", "native": { "uz": "Mening akam yangi telefon sotib oldi.", "ru": "Мой брат купил новый телефон.", "tr": "Erkek kardeşim yeni bir telefon satın aldı." }, "altNative": { "uz": ["Akam yangi telefon sotib oldi.", "Mening ukam yangi telefon sotib oldi.", "Ukam yangi telefon sotib oldi.", "Mening akam yangi telefon oldi.", "Akam yangi telefon oldi."], "ru": ["Брат купил новый телефон.", "Мой брат купил себе новый телефон."], "tr": ["Erkek kardeşim yeni bir telefon aldı.", "Benim erkek kardeşim yeni bir telefon aldı.", "Kardeşim yeni bir telefon aldı.", "Abim yeni bir telefon aldı.", "Abim yeni bir telefon satın aldı.", "Erkek kardeşim yeni telefon aldı."] } },
    { "id": "u17.s.23", "en": "Who came to the party?", "native": { "uz": "Ziyofatga kim keldi?", "ru": "Кто пришёл на вечеринку?", "tr": "Partiye kim geldi?" }, "altNative": { "uz": ["Kim ziyofatga keldi?", "Ziyofatga kimlar keldi?", "Bazmga kim keldi?"], "ru": ["Кто приходил на вечеринку?", "Кто на вечеринку пришёл?"], "tr": ["Kim partiye geldi?", "Partiye kimler geldi?"] } },
    { "id": "u17.s.24", "en": "I came home and made dinner.", "altEn": ["I came home and cooked dinner."], "native": { "uz": "Men uyga keldim va kechki ovqat tayyorladim.", "ru": "Я пришёл домой и приготовил ужин.", "tr": "Eve geldim ve akşam yemeği yaptım." }, "altNative": { "uz": ["Uyga keldim va kechki ovqat tayyorladim.", "Men uyga keldim va kechki ovqat qildim.", "Men uyga keldim va kechki ovqat pishirdim.", "Men uyga kelib, kechki ovqat tayyorladim."], "ru": ["Я пришла домой и приготовила ужин.", "Я пришёл домой и сделал ужин.", "Я пришла домой и сделала ужин."], "tr": ["Ben eve geldim ve akşam yemeği yaptım.", "Eve gelip akşam yemeği yaptım.", "Eve geldim ve akşam yemeği hazırladım.", "Eve geldim ve akşam yemeği pişirdim."] } },

    { "id": "u17.s.25", "en": "What did you do yesterday?", "native": { "uz": "Kecha nima qilding?", "ru": "Что ты делал вчера?", "tr": "Dün ne yaptın?" }, "altNative": { "uz": ["Sen kecha nima qilding?", "Kecha sen nima qilding?"], "ru": ["Что ты делала вчера?", "Что ты вчера делал?", "Что ты вчера делала?"], "tr": ["Sen dün ne yaptın?"] } },
    { "id": "u17.s.26", "en": "Did you eat breakfast today?", "altEn": ["Did you have breakfast today?"], "native": { "uz": "Bugun nonushta qildingmi?", "ru": "Ты сегодня завтракал?", "tr": "Bugün kahvaltı yaptın mı?" }, "altNative": { "uz": ["Sen bugun nonushta qildingmi?", "Bugun nonushta yedingmi?"], "ru": ["Ты сегодня завтракала?", "Ты завтракал сегодня?", "Ты завтракала сегодня?", "Ты сегодня позавтракал?", "Ты сегодня позавтракала?"], "tr": ["Sen bugün kahvaltı yaptın mı?", "Bugün kahvaltı ettin mi?"] } },
    { "id": "u17.s.27", "en": "I did not sleep well.", "native": { "uz": "Men yaxshi uxlamadim.", "ru": "Я плохо спал.", "tr": "Ben iyi uyumadım." }, "altNative": { "uz": ["Yaxshi uxlamadim.", "Men yaxshi uxlay olmadim."], "ru": ["Я плохо спала.", "Я спал плохо.", "Я спала плохо.", "Я не выспался.", "Я не выспалась."], "tr": ["İyi uyumadım.", "İyi uyuyamadım."] } },
    { "id": "u17.s.28", "en": "The baby slept all night.", "native": { "uz": "Chaqaloq tun bo'yi uxladi.", "ru": "Малыш спал всю ночь.", "tr": "Bebek bütün gece uyudu." }, "altNative": { "uz": ["Chaqaloq butun tun uxladi.", "Chaqaloq kechasi bilan uxladi."], "ru": ["Малыш всю ночь спал.", "Малыш проспал всю ночь.", "Ребёнок спал всю ночь."], "tr": ["Bebek tüm gece uyudu.", "Bebek bütün gece boyunca uyudu."] } },
    { "id": "u17.s.29", "en": "Did you call your mother?", "native": { "uz": "Onangga qo'ng'iroq qildingmi?", "ru": "Ты позвонил маме?", "tr": "Anneni aradın mı?" }, "altNative": { "uz": ["Sen onangga qo'ng'iroq qildingmi?", "Onangga telefon qildingmi?"], "ru": ["Ты позвонила маме?", "Ты позвонил своей маме?", "Ты позвонила своей маме?", "Ты звонил маме?", "Ты звонила маме?"], "tr": ["Sen anneni aradın mı?"] } },
    { "id": "u17.s.30", "en": "I called you, but you were busy.", "native": { "uz": "Men senga qo'ng'iroq qildim, lekin sen band eding.", "ru": "Я звонил тебе, но ты был занят.", "tr": "Seni aradım ama meşguldün." }, "altNative": { "uz": ["Senga qo'ng'iroq qildim, lekin sen band eding.", "Men senga qo'ng'iroq qildim, lekin band eding.", "Senga qo'ng'iroq qildim, lekin band eding.", "Men senga qo'ng'iroq qildim, ammo sen band eding.", "Men senga telefon qildim, lekin sen band eding."], "ru": ["Я звонила тебе, но ты был занят.", "Я звонил тебе, но ты была занята.", "Я звонила тебе, но ты была занята.", "Я тебе звонил, но ты был занят.", "Я тебе звонила, но ты был занят.", "Я тебе звонил, но ты была занята.", "Я тебе звонила, но ты была занята.", "Я позвонил тебе, но ты был занят.", "Я позвонила тебе, но ты была занята."], "tr": ["Seni aradım ama sen meşguldün.", "Ben seni aradım ama meşguldün.", "Ben seni aradım ama sen meşguldün.", "Seni aradım fakat meşguldün."] } },
    { "id": "u17.s.31", "en": "We walked in the park and talked.", "altEn": ["We walked and talked in the park."], "native": { "uz": "Biz parkda sayr qildik va gaplashdik.", "ru": "Мы гуляли в парке и разговаривали.", "tr": "Parkta yürüdük ve konuştuk." }, "altNative": { "uz": ["Parkda sayr qildik va gaplashdik.", "Biz parkda yurdik va gaplashdik.", "Biz parkda aylandik va gaplashdik.", "Biz parkda piyoda yurdik va gaplashdik."], "ru": ["Мы гуляли по парку и разговаривали.", "Мы гуляли в парке и говорили.", "Мы погуляли в парке и поговорили.", "Мы гуляли в парке и болтали."], "tr": ["Biz parkta yürüdük ve konuştuk.", "Parkta yürüdük ve sohbet ettik.", "Parkta yürüyüp konuştuk."] } },
    { "id": "u17.s.32", "en": "I met my wife at university.", "altEn": ["I met my wife at the university."], "native": { "uz": "Men xotinim bilan universitetda tanishdim.", "ru": "Я познакомился с женой в университете.", "tr": "Karımla üniversitede tanıştım." }, "altNative": { "uz": ["Xotinim bilan universitetda tanishdim.", "Men xotinim bilan universitetda tanishganman.", "Xotinim bilan universitetda tanishganman.", "Men rafiqam bilan universitetda tanishdim."], "ru": ["Я познакомился со своей женой в университете.", "Я познакомился с моей женой в университете.", "Я встретил жену в университете.", "Я встретил свою жену в университете.", "С женой я познакомился в университете."], "tr": ["Ben karımla üniversitede tanıştım.", "Eşimle üniversitede tanıştım.", "Ben eşimle üniversitede tanıştım.", "Hanımımla üniversitede tanıştım."] } },

    { "id": "u17.s.33", "en": "I saw him two days ago.", "altEn": ["Two days ago I saw him."], "native": { "uz": "Men uni ikki kun oldin ko'rdim.", "ru": "Я видел его два дня назад.", "tr": "Onu iki gün önce gördüm." }, "altEnFor": { "uz": ["I saw her two days ago.", "Two days ago I saw her.", "I saw it two days ago."], "tr": ["I saw her two days ago.", "Two days ago I saw her.", "I saw it two days ago."] }, "altNative": { "uz": ["Uni ikki kun oldin ko'rdim.", "Men uni ikki kun avval ko'rdim.", "Men uni ikki kun ilgari ko'rdim.", "Ikki kun oldin men uni ko'rdim.", "Ikki kun oldin uni ko'rdim."], "ru": ["Я видела его два дня назад.", "Я его видел два дня назад.", "Я его видела два дня назад.", "Два дня назад я видел его.", "Два дня назад я видела его.", "Два дня назад я его видел.", "Два дня назад я его видела."], "tr": ["Ben onu iki gün önce gördüm.", "İki gün önce onu gördüm.", "Onu iki gün evvel gördüm."] } },
    { "id": "u17.s.34", "en": "We went to London three years ago.", "altEn": ["Three years ago we went to London."], "native": { "uz": "Biz uch yil oldin Londonga bordik.", "ru": "Мы ездили в Лондон три года назад.", "tr": "Üç yıl önce Londra'ya gittik." }, "altNative": { "uz": ["Uch yil oldin biz Londonga bordik.", "Uch yil oldin Londonga bordik.", "Biz Londonga uch yil oldin bordik.", "Biz uch yil avval Londonga bordik.", "Biz uch yil oldin Londonga borganmiz."], "ru": ["Три года назад мы ездили в Лондон.", "Мы поехали в Лондон три года назад.", "Три года назад мы поехали в Лондон.", "Мы три года назад ездили в Лондон."], "tr": ["Biz üç yıl önce Londra'ya gittik.", "Londra'ya üç yıl önce gittik.", "Üç sene önce Londra'ya gittik."] } },
    { "id": "u17.s.35", "en": "She gave me a book last week.", "altEn": ["Last week she gave me a book."], "native": { "uz": "U o'tgan hafta menga kitob berdi.", "ru": "На прошлой неделе она дала мне книгу.", "tr": "O geçen hafta bana bir kitap verdi." }, "altEnFor": { "uz": ["He gave me a book last week.", "Last week he gave me a book."], "tr": ["He gave me a book last week.", "Last week he gave me a book."] }, "altNative": { "uz": ["O'tgan hafta u menga kitob berdi.", "U menga o'tgan hafta kitob berdi.", "U o'tgan hafta menga bitta kitob berdi."], "ru": ["Она дала мне книгу на прошлой неделе.", "На прошлой неделе она подарила мне книгу.", "Она подарила мне книгу на прошлой неделе.", "Она на прошлой неделе дала мне книгу."], "tr": ["Geçen hafta bana bir kitap verdi.", "Geçen hafta o bana bir kitap verdi.", "O bana geçen hafta bir kitap verdi.", "Geçen hafta bana kitap verdi."] } },
    { "id": "u17.s.36", "en": "My grandfather told us a story.", "native": { "uz": "Mening bobom bizga hikoya aytib berdi.", "ru": "Мой дедушка рассказал нам историю.", "tr": "Büyükbabam bize bir hikâye anlattı." }, "altNative": { "uz": ["Bobom bizga hikoya aytib berdi.", "Bobom bizga bir hikoya aytib berdi.", "Mening bobom bizga bir hikoya aytib berdi.", "Bobom bizga ertak aytib berdi."], "ru": ["Дедушка рассказал нам историю.", "Мой дедушка рассказал нам сказку.", "Дедушка рассказал нам сказку."], "tr": ["Dedem bize bir hikâye anlattı.", "Büyükbabam bize bir hikaye anlattı.", "Dedem bize bir hikaye anlattı.", "Benim büyükbabam bize bir hikâye anlattı.", "Büyükbabam bize hikâye anlattı.", "Dedem bize bir masal anlattı."] } },
    { "id": "u17.s.37", "en": "Who took my phone?", "native": { "uz": "Telefonimni kim oldi?", "ru": "Кто взял мой телефон?", "tr": "Telefonumu kim aldı?" }, "altNative": { "uz": ["Mening telefonimni kim oldi?", "Kim telefonimni oldi?"], "ru": ["Кто забрал мой телефон?", "Мой телефон кто взял?"], "tr": ["Benim telefonumu kim aldı?", "Kim telefonumu aldı?"] } },
    { "id": "u17.s.38", "en": "I forgot my umbrella and took a taxi.", "native": { "uz": "Men soyabonimni unutdim va taksida ketdim.", "ru": "Я забыл зонт и взял такси.", "tr": "Şemsiyemi unuttum ve taksiye bindim." }, "altNative": { "uz": ["Soyabonimni unutdim va taksida ketdim.", "Men soyabonimni unutdim va taksi oldim.", "Men soyabonimni unutdim va taksiga o'tirdim.", "Men zontigimni unutdim va taksida ketdim."], "ru": ["Я забыла зонт и взяла такси.", "Я забыл свой зонт и взял такси.", "Я забыла свой зонт и взяла такси.", "Я забыл зонтик и взял такси.", "Я забыла зонтик и взяла такси.", "Я забыл зонт и поехал на такси.", "Я забыла зонт и поехала на такси."], "tr": ["Ben şemsiyemi unuttum ve taksiye bindim.", "Şemsiyemi unuttum ve bir taksiye bindim.", "Şemsiyemi unuttum ve taksi tuttum.", "Şemsiyemi unutup taksiye bindim."] } },
    { "id": "u17.s.39", "en": "Where did you go last weekend?", "native": { "uz": "O'tgan dam olish kunlari qayerga bording?", "ru": "Куда ты ходил в прошлые выходные?", "tr": "Geçen hafta sonu nereye gittin?" }, "altNative": { "uz": ["Sen o'tgan dam olish kunlari qayerga bording?", "O'tgan dam olish kunlarida qayerga bording?", "O'tgan hafta oxirida qayerga bording?"], "ru": ["Куда ты ходила в прошлые выходные?", "Куда ты ездил в прошлые выходные?", "Куда ты ездила в прошлые выходные?", "Куда ты ходил на прошлых выходных?", "Куда ты ходила на прошлых выходных?", "Куда ты ездил на прошлых выходных?", "Куда ты ездила на прошлых выходных?", "Куда ты в прошлые выходные ходил?", "Куда ты в прошлые выходные ходила?"], "tr": ["Sen geçen hafta sonu nereye gittin?", "Geçen hafta sonunda nereye gittin?"] } },
    { "id": "u17.s.40", "en": "Anna did not come to work last week.", "altEn": ["Last week Anna did not come to work."], "native": { "uz": "Anna o'tgan hafta ishga kelmadi.", "ru": "На прошлой неделе Анна не приходила на работу.", "tr": "Anna geçen hafta işe gelmedi." }, "altNative": { "uz": ["O'tgan hafta Anna ishga kelmadi.", "Anna ishga o'tgan hafta kelmadi."], "ru": ["Анна не приходила на работу на прошлой неделе.", "На прошлой неделе Анна не пришла на работу.", "Анна не пришла на работу на прошлой неделе.", "Анна на прошлой неделе не приходила на работу."], "tr": ["Geçen hafta Anna işe gelmedi.", "Anna işe geçen hafta gelmedi."] } }
