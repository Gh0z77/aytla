# Copy to .env for local runs. EXPO_PUBLIC_* values are baked into the bundle at build time:
# they are public by design (never put a secret here).

# Where the app finds the API. On a phone use your computer's LAN address, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Sign in with Google (Clerk). Leave empty to hide the Google button.
# Clerk dashboard → API keys → Publishable key. Use the same key in server/.env (CLERK_PUBLISHABLE_KEY).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Social links in the website footer: shown only when set (https:// URLs of accounts that exist)
EXPO_PUBLIC_SOCIAL_TELEGRAM=
EXPO_PUBLIC_SOCIAL_INSTAGRAM=
EXPO_PUBLIC_SOCIAL_YOUTUBE=
